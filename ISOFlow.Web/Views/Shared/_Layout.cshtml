<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ISOFlow Compliance Management Platform (MVC)</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <div id="app-layout">
        <!-- Sidebar Navigation -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
                    <i class="bi bi-shield-check text-info"></i>
                    <span>ISOFlow</span>
                </a>
            </div>

            <!-- CORE -->
            <div class="sidebar-section-title">CORE</div>
            <ul class="sidebar-nav">
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "Dashboard" ? "active" : "")">
                    <a asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
                </li>
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "Workflow" ? "active" : "")">
                    <a asp-controller="Workflow" asp-action="Index"><i class="bi bi-compass"></i> App Flow &amp; Guide <span class="badge bg-success rounded-pill ms-auto">Tour</span></a>
                </li>
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "Tasks" ? "active" : "")">
                    <a asp-controller="Tasks" asp-action="Index"><i class="bi bi-check2-square"></i> My Tasks <span class="badge bg-danger rounded-pill ms-auto">5</span></a>
                </li>
                <li class="sidebar-nav-item">
                    <a href="/#notifications"><i class="bi bi-bell"></i> Notifications <span class="badge bg-primary rounded-pill ms-auto">3</span></a>
                </li>
            </ul>

            <!-- ORGANIZATION — SuperAdmin only -->
            @{
                var _sysRole = Context.Session.GetString("ActiveUserSystemRole") ?? "";
            }
            @if (_sysRole == "SuperAdmin")
            {
                <div class="sidebar-section-title">ORGANIZATION</div>
                <ul class="sidebar-nav">
                    <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "Organizations" ? "active" : "")">
                        <a asp-controller="Organizations" asp-action="Index"><i class="bi bi-building"></i> Organizations</a>
                    </li>
                    <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "Users" ? "active" : "")">
                        <a asp-controller="Admin" asp-action="Users"><i class="bi bi-people"></i> People & Roles</a>
                    </li>
                </ul>
            }

            <!-- COMPLIANCE -->
            <div class="sidebar-section-title">COMPLIANCE</div>
            <ul class="sidebar-nav">
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "Standards" ? "active" : "")">
                    <a asp-controller="Standards" asp-action="Index"><i class="bi bi-journal-bookmark"></i> ISO Standards</a>
                </li>
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "Controls" ? "active" : "")">
                    <a asp-controller="Controls" asp-action="Index"><i class="bi bi-shield-lock"></i> Controls Register</a>
                </li>
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "SoA" ? "active" : "")">
                    <a asp-controller="Controls" asp-action="Soa"><i class="bi bi-file-earmark-check"></i> Statement of Applicability</a>
                </li>
            </ul>

            <!-- RISK -->
            <div class="sidebar-section-title">RISK</div>
            <ul class="sidebar-nav">
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "Risks" ? "active" : "")">
                    <a asp-controller="Risks" asp-action="Index"><i class="bi bi-exclamation-triangle"></i> Risk Register</a>
                </li>
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "RiskMatrix" ? "active" : "")">
                    <a asp-controller="Risks" asp-action="Matrix"><i class="bi bi-grid-3x3-gap"></i> Risk Matrix (5x5)</a>
                </li>
            </ul>

            <!-- DOCUMENTS -->
            <div class="sidebar-section-title">DOCUMENTS</div>
            <ul class="sidebar-nav">
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "Policies" ? "active" : "")">
                    <a asp-controller="Documents" asp-action="Policies"><i class="bi bi-file-earmark-text"></i> Policies Repository</a>
                </li>
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "Processes" ? "active" : "")">
                    <a asp-controller="Documents" asp-action="Processes"><i class="bi bi-diagram-3"></i> Business Processes</a>
                </li>
            </ul>

            <!-- TASKS & PLANNING -->
            <div class="sidebar-section-title">TASKS & PLANNING</div>
            <ul class="sidebar-nav">
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "Kanban" ? "active" : "")">
                    <a asp-controller="Tasks" asp-action="Kanban"><i class="bi bi-kanban"></i> Kanban Board</a>
                </li>
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "Calendar" ? "active" : "")">
                    <a asp-controller="Tasks" asp-action="Calendar"><i class="bi bi-calendar3"></i> Compliance Calendar</a>
                </li>
            </ul>

            <!-- AUDIT -->
            <div class="sidebar-section-title">AUDIT</div>
            <ul class="sidebar-nav">
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "Audits" ? "active" : "")">
                    <a asp-controller="Audits" asp-action="Index"><i class="bi bi-clipboard-check"></i> Audit Programs</a>
                </li>
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "Findings" ? "active" : "")">
                    <a asp-controller="Findings" asp-action="Index"><i class="bi bi-bug"></i> Findings / NC <span class="badge bg-warning text-dark rounded-pill ms-auto">7</span></a>
                </li>
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "Capa" ? "active" : "")">
                    <a asp-controller="Capa" asp-action="Index"><i class="bi bi-tools"></i> CAPA Management</a>
                </li>
            </ul>

            <!-- IMPROVEMENT -->
            <div class="sidebar-section-title">IMPROVEMENT</div>
            <ul class="sidebar-nav">
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "ManagementReview" ? "active" : "")">
                    <a asp-controller="ManagementReview" asp-action="Index"><i class="bi bi-briefcase"></i> Management Review</a>
                </li>
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "Improvement" ? "active" : "")">
                    <a asp-controller="Improvement" asp-action="Index"><i class="bi bi-graph-up-arrow"></i> Continual Improvement</a>
                </li>
            </ul>

            <!-- REPORTS & ADMIN -->
            <div class="sidebar-section-title">ADMINISTRATION</div>
            <ul class="sidebar-nav">
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "Reports" ? "active" : "")">
                    <a asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line"></i> Reports Hub</a>
                </li>
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "Users" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Users"><i class="bi bi-shield-shaded"></i> Roles & RBAC</a>
                </li>
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "Logs" ? "active" : "")">
                    <a asp-controller="Logs" asp-action="Index"><i class="bi bi-file-earmark-code"></i> System Logs</a>
                </li>
                <li class="sidebar-nav-item @(ViewData["ActiveMenu"]?.ToString() == "AuditLogs" ? "active" : "")">
                    <a asp-controller="AuditLogs" asp-action="Index"><i class="bi bi-clock-history"></i> Audit Logs</a>
                </li>
            </ul>

            <div class="p-3 mt-auto border-top border-secondary text-center small text-muted">
                ISOFlow v1.0 (MVC)
            </div>
        </aside>

        <!-- Main Wrapper -->
        <div class="main-wrapper">
            <!-- Topbar -->
            <header class="topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle" id="sidebarToggle"><i class="bi bi-list"></i></button>
                    <div class="global-search-container">
                        <i class="bi bi-search global-search-icon"></i>
                        <input type="text" class="global-search-input" id="globalSearchInput" placeholder="Search entity (e.g. CTRL-001, RISK-001, A.5.18)..." />
                    </div>
                </div>

                <div class="topbar-right">
                    <a asp-controller="Workflow" asp-action="Index" class="btn btn-outline-success btn-sm fw-bold me-2" title="Interactive Application Flow Guide">
                        <i class="bi bi-compass me-1"></i> How It Works
                    </a>
                    @{
                        var activeOrgName     = Context.Session.GetString("ActiveOrgName")       ?? "ISOFlow Platform";
                        var activeOrgCode     = Context.Session.GetString("ActiveOrgCode")       ?? "GLOBAL";
                        var activeUserName    = Context.Session.GetString("ActiveUserName")      ?? "User";
                        var activeUserAvatar  = Context.Session.GetString("ActiveUserAvatar")    ?? "https://ui-avatars.com/api/?name=User&background=4f46e5&color=fff";
                        var activeSystemRole  = Context.Session.GetString("ActiveUserSystemRole") ?? "";
                        var activeJobRole     = Context.Session.GetString("ActiveUserRole")       ?? "";
                        // Role badge styling
                        var (roleBadgeClass, roleLabel) = activeSystemRole switch {
                            "SuperAdmin" => ("badge bg-purple text-white", "Super Admin"),
                            "Admin"      => ("badge bg-primary text-white", "Admin"),
                            _            => ("badge bg-success text-white", "User")
                        };
                    }

                    @* Tenant Switcher — SuperAdmin only *@
                    @if (activeSystemRole == "SuperAdmin")
                    {
                        <div class="dropdown me-2">
                            <button class="btn btn-outline-primary btn-sm dropdown-toggle fw-bold" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-building me-1"></i> @activeOrgCode
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="min-width: 280px;">
                                <li class="dropdown-header fw-bold border-bottom pb-2">Switch Tenant Organization</li>
                                <li>
                                    <form asp-controller="Account" asp-action="SwitchTenant" method="post">
                                        <input type="hidden" name="orgId" value="ORG-001" />
                                        <button type="submit" class="dropdown-item py-2 small"><i class="bi bi-building text-primary me-2"></i> Acme Technologies (ACME)</button>
                                    </form>
                                </li>
                                <li>
                                    <form asp-controller="Account" asp-action="SwitchTenant" method="post">
                                        <input type="hidden" name="orgId" value="ORG-002" />
                                        <button type="submit" class="dropdown-item py-2 small"><i class="bi bi-shield-check text-danger me-2"></i> CyberShield Global (CYBER)</button>
                                    </form>
                                </li>
                                <li>
                                    <form asp-controller="Account" asp-action="SwitchTenant" method="post">
                                        <input type="hidden" name="orgId" value="ORG-003" />
                                        <button type="submit" class="dropdown-item py-2 small"><i class="bi bi-hospital text-success me-2"></i> Nexus Health Systems (NEXUS)</button>
                                    </form>
                                </li>
                                <li class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 small text-primary fw-bold" asp-controller="Organizations" asp-action="Index"><i class="bi bi-grid me-2"></i> All Organizations Directory</a></li>
                                <li><a class="dropdown-item py-2 small text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Sign Out</a></li>
                            </ul>
                        </div>
                    }

                    @* System Role Badge *@
                    <div class="d-none d-md-flex align-items-center me-3">
                        <span class="@roleBadgeClass" style="font-size:.72rem; padding:.3rem .65rem; border-radius:20px;">
                            <i class="bi bi-shield-fill me-1"></i>@roleLabel
                        </span>
                    </div>

                    <div class="dropdown">
                        <button class="btn btn-light position-relative rounded-circle" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-bell fs-5"></i>
                            <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="width: 300px;">
                            <li class="dropdown-header fw-bold border-bottom pb-2">Notifications</li>
                            <li><a class="dropdown-item py-2 small" asp-controller="Tasks" asp-action="Index"><i class="bi bi-exclamation-circle text-danger me-2"></i> 5 compliance tasks overdue</a></li>
                            <li><a class="dropdown-item py-2 small" asp-controller="Findings" asp-action="Detail" asp-route-id="FIND-001"><i class="bi bi-bug text-warning me-2"></i> Major NC FIND-001 assigned</a></li>
                            <li><a class="dropdown-item py-2 small" asp-controller="Documents" asp-action="Policies"><i class="bi bi-file-earmark-text text-info me-2"></i> Access Control Policy due for review</a></li>
                        </ul>
                    </div>

                    <div class="dropdown border-start ps-3">
                        <button class="btn p-0 border-0 bg-transparent d-flex align-items-center gap-2"
                                type="button" data-bs-toggle="dropdown" aria-expanded="false" id="userMenuBtn">
                            <img src="@activeUserAvatar" class="rounded-circle" width="36" height="36" alt="User Avatar"
                                 style="border:2px solid rgba(255,255,255,.15);" />
                            <div class="d-none d-lg-block text-start">
                                <div class="fw-bold small lh-1">@activeUserName</div>
                                <div class="text-muted" style="font-size:.72rem;">@activeOrgCode</div>
                            </div>
                            <i class="bi bi-chevron-down text-muted d-none d-lg-block" style="font-size:.7rem;"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2" style="min-width:220px; border-radius:16px;">
                            <li class="px-3 pb-2 border-bottom mb-1">
                                <div class="fw-bold small">@activeUserName</div>
                                <div class="text-muted" style="font-size:.72rem;">@(Context.Session.GetString("ActiveUserEmail") ?? "")</div>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 small rounded-2 mx-1" style="width:calc(100% - .5rem);"
                                   asp-controller="Account" asp-action="Profile">
                                    <i class="bi bi-person-circle me-2 text-primary"></i> My Profile
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 small rounded-2 mx-1" style="width:calc(100% - .5rem);"
                                   asp-controller="Account" asp-action="Profile"
                                   onclick="event.preventDefault(); document.getElementById('changePasswordForm')?.scrollIntoView({behavior:'smooth'}) || window.location.assign(this.href)">
                                    <i class="bi bi-key-fill me-2 text-warning"></i> Change Password
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1" /></li>
                            <li>
                                <a class="dropdown-item py-2 small rounded-2 mx-1 text-danger" style="width:calc(100% - .5rem);"
                                   asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Container -->
            <main class="page-container">
                <!-- Dynamic Traceability Bar -->
                @await Html.PartialAsync("_TraceabilityBar")

                <!-- Page Body Content -->
                @RenderBody()
            </main>
        </div>
    </div>

    <div id="toastContainer" class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100;"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/advance-search.js" asp-append-version="true"></script>
    <script src="~/js/signalr-client.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
