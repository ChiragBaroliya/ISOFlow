@model List<ISOFlow.Domain.Entities.Notification>
@{
    var unread = ViewData["UnreadCount"] as int? ?? 0;

    string IconFor(string category) => category switch
    {
        "Warning" => "bi-exclamation-circle text-danger",
        "Task" => "bi-check2-square text-primary",
        "Policy" => "bi-file-earmark-text text-info",
        "Audit" => "bi-clipboard-check text-warning",
        _ => "bi-bell text-secondary"
    };
}

<div class="dropdown">
    <button class="btn btn-light position-relative rounded-circle" type="button" data-bs-toggle="dropdown"
            title="@(unread > 0 ? $"{unread} unread notification(s)" : "Notifications")">
        <i class="bi bi-bell fs-5"></i>
        @if (unread > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:.65rem;">
                @(unread > 99 ? "99+" : unread.ToString())
            </span>
        }
    </button>
    <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="width: 340px;">
        <li class="dropdown-header fw-bold border-bottom pb-2 d-flex justify-content-between align-items-center">
            <span>Notifications</span>
            @if (unread > 0)
            {
                <form asp-controller="Notifications" asp-action="MarkAllRead" method="post" class="mb-0">
                    <button type="submit" class="btn btn-link btn-sm p-0 text-decoration-none small">Mark all read</button>
                </form>
            }
        </li>
        @if (Model.Any())
        {
            @foreach (var n in Model)
            {
                <li>
                    <a class="dropdown-item py-2 small text-wrap @(n.IsRead ? "text-muted" : "fw-semibold")"
                       asp-controller="Notifications" asp-action="Open" asp-route-id="@n.Id">
                        <i class="bi @IconFor(n.Category) me-2"></i>@n.Title
                        <div class="text-muted fw-normal" style="font-size:.72rem;">@n.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                    </a>
                </li>
            }
        }
        else
        {
            <li><span class="dropdown-item-text py-3 small text-muted text-center d-block"><i class="bi bi-inbox me-1"></i> No notifications</span></li>
        }
        <li class="border-top"><a class="dropdown-item py-2 small text-center text-primary" asp-controller="Notifications" asp-action="Index">View all</a></li>
    </ul>
</div>
