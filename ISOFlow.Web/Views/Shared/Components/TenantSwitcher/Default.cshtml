@model List<ISOFlow.Domain.Entities.Organization>
@{
    var activeOrgCode = ViewData["ActiveOrgCode"] as string ?? string.Empty;
}

<div class="dropdown me-2">
    <button class="btn btn-outline-primary btn-sm dropdown-toggle fw-bold" type="button" data-bs-toggle="dropdown">
        <i class="bi bi-building me-1"></i> @activeOrgCode
    </button>
    <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="min-width: 280px;">
        <li class="dropdown-header fw-bold border-bottom pb-2">Switch Tenant Organization</li>
        @foreach (var org in Model)
        {
            <li>
                <form asp-controller="Account" asp-action="SwitchTenant" method="post">
                    <input type="hidden" name="orgId" value="@org.Id" />
                    <button type="submit" class="dropdown-item py-2 small @(org.Code == activeOrgCode ? "active" : "")">
                        <i class="bi bi-building text-primary me-2"></i> @org.Name (@org.Code)
                    </button>
                </form>
            </li>
        }
        @if (!Model.Any())
        {
            <li><span class="dropdown-item-text small text-muted">No organizations found.</span></li>
        }
        <li class="dropdown-divider"></li>
        <li><a class="dropdown-item py-2 small text-primary fw-bold" asp-controller="Organizations" asp-action="Index"><i class="bi bi-grid me-2"></i> All Organizations Directory</a></li>
        <li><a class="dropdown-item py-2 small text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Sign Out</a></li>
    </ul>
</div>
