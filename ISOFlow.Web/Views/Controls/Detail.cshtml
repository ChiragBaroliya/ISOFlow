@using ISOFlow.Domain.Enums
@model ISOFlow.Web.Models.ControlDetailViewModel
@{
    ViewData["Title"] = $"{Model.Control.Code} - {Model.Control.Title}";

    string LevelBadge(RiskLevel level) => level switch
    {
        RiskLevel.Critical => "bg-danger",
        RiskLevel.High => "bg-warning text-dark",
        RiskLevel.Medium => "bg-primary",
        _ => "bg-success"
    };
    string TaskBadge(ComplianceTaskStatus status) => status switch
    {
        ComplianceTaskStatus.Completed => "bg-success",
        ComplianceTaskStatus.Overdue or ComplianceTaskStatus.Blocked => "bg-danger",
        ComplianceTaskStatus.InProgress => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}

@functions {
    // Shared empty-state block for tabs with no linked records.
    private static Microsoft.AspNetCore.Html.IHtmlContent Empty(string text) =>
        new Microsoft.AspNetCore.Html.HtmlString($"<div class=\"text-muted small p-3 border rounded bg-light\"><i class=\"bi bi-inbox me-1\"></i> {System.Net.WebUtility.HtmlEncode(text)}</div>");
}

<!-- Control Header Banner -->
<div class="card-enterprise p-4 mb-4 border-start border-primary border-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary fs-6">@Model.Control.Code</span>
                <span class="badge bg-success">@Model.Control.Status</span>
                <span class="badge bg-light text-dark border">@Model.Control.Category</span>
            </div>
            <h3 class="fw-bold text-dark mb-1">@Model.Control.Title</h3>
            <p class="text-muted mb-0">@Model.Control.Description</p>
        </div>
        <div class="d-flex align-items-center gap-4 text-center">
            <div>
                <div class="text-muted small">Compliance Score</div>
                <div class="fs-3 fw-bold text-primary">@Model.Control.CompliancePercentage%</div>
            </div>
            <div>
                <div class="text-muted small">Owner</div>
                <div class="fw-semibold">@Model.Control.Owner</div>
            </div>
            <div>
                <a asp-controller="Controls" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to Register</a>
            </div>
        </div>
    </div>
</div>

<div class="card-enterprise p-4">
    <ul class="nav nav-pills mb-4 border-bottom pb-3 gap-1 overflow-x-auto flex-nowrap" id="controlTabs" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-overview"><i class="bi bi-info-circle me-1"></i> Overview</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-requirements"><i class="bi bi-list-check me-1"></i> Requirement (@(Model.Requirement == null ? 0 : 1))</button></li>
        <li class="nav-item"><button class="nav-link text-danger" data-bs-toggle="pill" data-bs-target="#tab-risks"><i class="bi bi-exclamation-triangle me-1"></i> Risks (@Model.Risks.Count)</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-treatment"><i class="bi bi-bandaid me-1"></i> Treatments (@Model.Treatments.Count)</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-policies"><i class="bi bi-file-earmark-text me-1"></i> Policies (@Model.Policies.Count)</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-processes"><i class="bi bi-diagram-3 me-1"></i> Processes (@Model.Processes.Count)</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-tasks"><i class="bi bi-check2-square me-1"></i> Tasks (@Model.Tasks.Count)</button></li>
        <li class="nav-item"><button class="nav-link text-success" data-bs-toggle="pill" data-bs-target="#tab-evidence"><i class="bi bi-paperclip me-1"></i> Evidence (@Model.Evidence.Count)</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-audits"><i class="bi bi-clipboard-check me-1"></i> Audits (@Model.Audits.Count)</button></li>
        <li class="nav-item"><button class="nav-link text-danger" data-bs-toggle="pill" data-bs-target="#tab-findings"><i class="bi bi-bug me-1"></i> Findings (@Model.Findings.Count)</button></li>
        <li class="nav-item"><button class="nav-link text-info" data-bs-toggle="pill" data-bs-target="#tab-capa"><i class="bi bi-tools me-1"></i> CAPA (@Model.Capas.Count)</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-history"><i class="bi bi-clock-history me-1"></i> History</button></li>
    </ul>

    <div class="tab-content" id="controlTabsContent">
        <!-- Overview Tab -->
        <div class="tab-pane fade show active" id="tab-overview">
            <div class="row g-4">
                <div class="col-md-6">
                    <h6 class="fw-bold mb-2">Implementation Summary</h6>
                    <p class="small text-muted mb-3">@(string.IsNullOrWhiteSpace(Model.Control.Description) ? "No description recorded." : Model.Control.Description)</p>
                    <div class="bg-light p-3 rounded">
                        <div class="row g-2 small">
                            <div class="col-6"><strong>Standard:</strong> @(Model.Standard?.Code ?? "—")</div>
                            <div class="col-6"><strong>Requirement:</strong> @(Model.Requirement == null ? "—" : $"{Model.Requirement.Clause} {Model.Requirement.Title}")</div>
                            <div class="col-6"><strong>Applicability:</strong> @(Model.Control.IsApplicable ? "Applicable" : "Not applicable")</div>
                            @if (!string.IsNullOrWhiteSpace(Model.Control.Justification))
                            {
                                <div class="col-12"><strong>Justification:</strong> @Model.Control.Justification</div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <h6 class="fw-bold mb-2">Linked Items</h6>
                    @{
                        var quickLinks = new List<(string Code, string Title, string Url, string Css)>();
                        quickLinks.AddRange(Model.Risks.Select(r => (r.Code, r.Title, Url.Action("Detail", "Risks", new { id = r.Code })!, "text-danger")));
                        quickLinks.AddRange(Model.Findings.Select(f => (f.Code, f.Title, Url.Action("Detail", "Findings", new { id = f.Code })!, "text-danger")));
                        quickLinks.AddRange(Model.Capas.Select(c => (c.Code, c.Title, Url.Action("Detail", "Capa", new { id = c.Code })!, "text-info")));
                        quickLinks.AddRange(Model.Audits.Select(a => (a.Code, a.Title, Url.Action("Detail", "Audits", new { id = a.Code })!, "text-primary")));
                    }
                    @if (quickLinks.Any())
                    {
                        <div class="list-group list-group-flush border rounded">
                            @foreach (var link in quickLinks)
                            {
                                <a href="@link.Url" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <div><strong class="@link.Css">@link.Code</strong> @link.Title</div>
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        @Empty("No risks, findings, CAPAs or audits are linked to this control yet.")
                    }
                </div>
            </div>
        </div>

        <!-- Requirement Tab -->
        <div class="tab-pane fade" id="tab-requirements">
            <h6 class="fw-bold mb-3">Linked ISO Requirement</h6>
            @if (Model.Requirement != null && Model.Standard != null)
            {
                <div class="p-3 bg-light rounded border">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="badge bg-primary me-2">@Model.Requirement.Clause</span>
                            <span class="fw-bold">@Model.Requirement.Title</span>
                        </div>
                        <a asp-controller="Standards" asp-action="Detail" asp-route-id="@Model.Standard.Code" class="btn btn-sm btn-outline-primary">View Standard</a>
                    </div>
                    <p class="small text-muted mt-2 mb-0">@Model.Requirement.Description</p>
                </div>
            }
            else
            {
                @Empty("This control is not linked to a requirement.")
            }
        </div>

        <!-- Risks Tab -->
        <div class="tab-pane fade" id="tab-risks">
            <h6 class="fw-bold mb-3">Associated Risks</h6>
            @if (Model.Risks.Any())
            {
                <table class="table table-sm table-hover align-middle">
                    <thead><tr><th>Risk ID</th><th>Title</th><th>Likelihood</th><th>Impact</th><th>Score</th><th>Level</th><th>Action</th></tr></thead>
                    <tbody>
                        @foreach (var risk in Model.Risks.OrderByDescending(r => r.Score))
                        {
                            <tr>
                                <td class="fw-bold">@risk.Code</td>
                                <td>@risk.Title</td>
                                <td>@((int)risk.Likelihood) (@risk.Likelihood)</td>
                                <td>@((int)risk.Impact) (@risk.Impact)</td>
                                <td class="fw-bold">@risk.Score</td>
                                <td><span class="badge @LevelBadge(risk.Level)">@risk.Level</span></td>
                                <td><a asp-controller="Risks" asp-action="Detail" asp-route-id="@risk.Code" class="btn btn-sm btn-outline-secondary py-0">View Risk</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                @Empty("No risks are linked to this control.")
            }
        </div>

        <!-- Treatment Tab -->
        <div class="tab-pane fade" id="tab-treatment">
            <h6 class="fw-bold mb-3">Risk Treatment Plans</h6>
            @if (Model.Treatments.Any())
            {
                @foreach (var risk in Model.Risks.Where(r => Model.Treatments.ContainsKey(r.Id)))
                {
                    var treatment = Model.Treatments[risk.Id];
                    <div class="p-3 bg-light rounded border mb-2">
                        <div class="d-flex justify-content-between">
                            <span class="fw-bold text-primary">@treatment.Option — @risk.Code</span>
                            <span class="badge bg-warning text-dark">@treatment.Status</span>
                        </div>
                        <p class="small text-muted mt-2">@treatment.TreatmentPlan</p>
                        <div class="small fw-semibold"><i class="bi bi-arrow-down-short"></i> Residual Risk Score: @treatment.ResidualScore (@treatment.ResidualLevel)</div>
                    </div>
                }
            }
            else
            {
                @Empty("No treatment plans are recorded for this control's risks.")
            }
        </div>

        <!-- Policies Tab -->
        <div class="tab-pane fade" id="tab-policies">
            <h6 class="fw-bold mb-3">Implementation Policies</h6>
            @if (Model.Policies.Any())
            {
                @foreach (var policy in Model.Policies)
                {
                    <div class="d-flex align-items-center justify-content-between p-3 border rounded mb-2">
                        <div>
                            <span class="badge bg-secondary me-2">@policy.Code</span>
                            <span class="fw-bold">@policy.Title v@(policy.Version)</span>
                        </div>
                        <a asp-controller="Documents" asp-action="Policies" class="btn btn-sm btn-outline-primary"><i class="bi bi-file-earmark-text"></i> View Policies</a>
                    </div>
                }
            }
            else
            {
                @Empty("No policies reference this control.")
            }
        </div>

        <!-- Processes Tab -->
        <div class="tab-pane fade" id="tab-processes">
            <h6 class="fw-bold mb-3">Business Processes</h6>
            @if (Model.Processes.Any())
            {
                @foreach (var process in Model.Processes)
                {
                    <div class="d-flex align-items-center justify-content-between p-3 border rounded mb-2">
                        <div>
                            <span class="badge bg-info text-white me-2">@process.Code</span>
                            <span class="fw-bold">@process.Title</span>
                        </div>
                        <a asp-controller="Documents" asp-action="Processes" class="btn btn-sm btn-outline-primary"><i class="bi bi-diagram-3"></i> View Processes</a>
                    </div>
                }
            }
            else
            {
                @Empty("No processes reference this control.")
            }
        </div>

        <!-- Tasks Tab -->
        <div class="tab-pane fade" id="tab-tasks">
            <h6 class="fw-bold mb-3">Compliance Execution Tasks</h6>
            @if (Model.Tasks.Any())
            {
                <div class="list-group">
                    @foreach (var task in Model.Tasks)
                    {
                        <a asp-controller="Tasks" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge @TaskBadge(task.Status) me-2">@task.Code</span>
                                <strong>@task.Title</strong>
                                <span class="text-muted small ms-2">due @task.DueDate.ToString("dd MMM yyyy")</span>
                            </div>
                            <span class="badge @TaskBadge(task.Status)">@task.Status</span>
                        </a>
                    }
                </div>
            }
            else
            {
                @Empty("No tasks are linked to this control.")
            }
        </div>

        <!-- Evidence Tab -->
        <div class="tab-pane fade" id="tab-evidence">
            <h6 class="fw-bold mb-3">Objective Evidence</h6>
            @if (Model.Evidence.Any())
            {
                @foreach (var item in Model.Evidence)
                {
                    <div class="p-3 border rounded mb-2 d-flex align-items-center justify-content-between">
                        <div>
                            <i class="bi bi-file-earmark-text text-secondary fs-4 me-2"></i>
                            <span class="badge bg-light text-dark border me-1">@item.Code</span>
                            <strong class="small">@item.Name</strong>
                        </div>
                        <span class="badge @(item.Status == "Verified" ? "bg-success" : "bg-warning text-dark")">@item.Status</span>
                    </div>
                }
            }
            else
            {
                @Empty("No evidence has been recorded for this control.")
            }
        </div>

        <!-- Audits Tab -->
        <div class="tab-pane fade" id="tab-audits">
            <h6 class="fw-bold mb-3">Audit Inspections</h6>
            @if (Model.Audits.Any())
            {
                @foreach (var audit in Model.Audits)
                {
                    <div class="p-3 border rounded mb-2 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-primary me-2">@audit.Code</span>
                            <strong>@audit.Title</strong>
                            <span class="text-muted small ms-2">@audit.Status</span>
                        </div>
                        <a asp-controller="Audits" asp-action="Detail" asp-route-id="@audit.Code" class="btn btn-sm btn-outline-primary">View Audit</a>
                    </div>
                }
            }
            else
            {
                @Empty("This control has not been covered by an audit.")
            }
        </div>

        <!-- Findings Tab -->
        <div class="tab-pane fade" id="tab-findings">
            <h6 class="fw-bold mb-3">Audit Findings</h6>
            @if (Model.Findings.Any())
            {
                @foreach (var finding in Model.Findings)
                {
                    <div class="p-3 bg-danger-subtle rounded border border-danger mb-2 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-danger me-2">@finding.Code</span>
                            <strong class="text-danger">@finding.Title</strong>
                            <span class="text-muted small ms-2">@finding.Severity · @finding.Status</span>
                        </div>
                        <a asp-controller="Findings" asp-action="Detail" asp-route-id="@finding.Code" class="btn btn-sm btn-danger">View Finding</a>
                    </div>
                }
            }
            else
            {
                @Empty("No findings have been raised against this control.")
            }
        </div>

        <!-- CAPA Tab -->
        <div class="tab-pane fade" id="tab-capa">
            <h6 class="fw-bold mb-3">Corrective & Preventive Actions</h6>
            @if (Model.Capas.Any())
            {
                @foreach (var capa in Model.Capas)
                {
                    <div class="p-3 bg-info-subtle rounded border border-info mb-2 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-info text-white me-2">@capa.Code</span>
                            <strong class="text-dark">@capa.Title</strong>
                            <span class="text-muted small ms-2">@capa.Status</span>
                        </div>
                        <a asp-controller="Capa" asp-action="Detail" asp-route-id="@capa.Code" class="btn btn-sm btn-info text-white">View CAPA</a>
                    </div>
                }
            }
            else
            {
                @Empty("No CAPAs are linked to this control's findings.")
            }
        </div>

        <!-- History Tab -->
        <div class="tab-pane fade" id="tab-history">
            @await Component.InvokeAsync("AuditHistory", new { entityName = "Control", entityId = Model.Control.Id })
        </div>
    </div>
</div>
