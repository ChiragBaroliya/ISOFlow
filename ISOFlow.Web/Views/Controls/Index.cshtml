@using ISOFlow.Domain.Enums
@model List<ISOFlow.Domain.Entities.Control>
@{
    ViewData["Title"] = "Controls Register";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-shield-lock text-primary me-2"></i> Controls Register</h4>
        <p class="text-muted small mb-0">Central ISO compliance control inventory connected to risks, policies, tasks, and audit findings.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Controls" asp-action="Soa" class="btn btn-outline-primary btn-sm"><i class="bi bi-file-earmark-check me-1"></i> Statement of Applicability (SoA)</a>
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addControlModal">
            <i class="bi bi-plus-circle me-1"></i> Add Control
        </button>
    </div>
</div>

<!-- ── Advance Search & Filter Toolbar ── -->
<div class="card-enterprise p-3 mb-4 bg-light border">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-4">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="ctrlSearchInput" class="form-control border-start-0" placeholder="Search by Control ID, title, owner, clause..." />
            </div>
        </div>
        <div class="col-6 col-md-3">
            <select id="ctrlCategoryFilter" class="form-select form-select-sm">
                <option value="all">All Categories</option>
                <option value="Organizational">Organizational Controls</option>
                <option value="Technological">Technological Controls</option>
                <option value="Physical">Physical Controls</option>
                <option value="People">People Controls</option>
            </select>
        </div>
        <div class="col-6 col-md-3">
            <select id="ctrlStatusFilter" class="form-select form-select-sm">
                <option value="all">All Statuses</option>
                <option value="Implemented">Implemented</option>
                <option value="InDevelopment">In Development</option>
                <option value="NotImplemented">Not Implemented</option>
                <option value="Tested">Tested</option>
            </select>
        </div>
        <div class="col-12 col-md-2 d-flex justify-content-between justify-content-md-end align-items-center gap-2">
            <button type="button" id="ctrlResetBtn" class="btn btn-sm btn-outline-secondary w-100" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
            </button>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top small text-muted">
        <span id="ctrlResultsCounter">Showing <strong>@Model.Count</strong> of <strong>@Model.Count</strong> records</span>
        <span class="badge bg-primary-subtle text-primary"><i class="bi bi-funnel me-1"></i> Live Filter</span>
    </div>
</div>

<div class="card-enterprise p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Control ID</th>
                    <th>Control Title</th>
                    <th>Requirement</th>
                    <th>Category</th>
                    <th>Owner</th>
                    <th>Status</th>
                    <th>Compliance</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="controlsTableBody">
                @foreach (var ctrl in Model)
                {
                    <tr class="@(ctrl.Id == "CTRL-001" ? "table-primary" : "")">
                        <td class="fw-bold text-primary">@ctrl.Code</td>
                        <td>
                            <a asp-controller="Controls" asp-action="Detail" asp-route-id="@ctrl.Id" class="fw-semibold text-dark text-decoration-none">@ctrl.Title</a>
                            <div class="text-muted small">@ctrl.Description</div>
                        </td>
                        <td><span class="badge bg-light text-primary border">@ctrl.RequirementId</span></td>
                        <td><span class="badge bg-secondary-subtle text-secondary">@ctrl.Category</span></td>
                        <td class="small fw-medium">@ctrl.Owner</td>
                        <td>
                            @{
                                var badgeCls = ctrl.Status switch {
                                    ControlStatus.Implemented => "bg-success-subtle text-success",
                                    ControlStatus.InDevelopment => "bg-warning-subtle text-warning",
                                    ControlStatus.NotImplemented => "bg-secondary-subtle text-secondary",
                                    _ => "bg-danger-subtle text-danger"
                                };
                            }
                            <span class="badge @badgeCls">@ctrl.Status</span>
                        </td>
                        <td>
                            <div class="fw-bold text-success">@ctrl.CompliancePercentage%</div>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-controller="Controls" asp-action="Detail" asp-route-id="@ctrl.Id" class="btn btn-outline-primary" title="Traceability & Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <button type="button" class="btn btn-outline-secondary" title="Edit Control"
                                        onclick="openEditControlModal('@ctrl.Id', '@ctrl.Code', '@Html.Raw(Html.Encode(ctrl.Title))', '@ctrl.StandardId', '@ctrl.RequirementId', '@ctrl.Category', '@Html.Raw(Html.Encode(ctrl.Owner))', '@((int)ctrl.Status)', '@ctrl.CompliancePercentage', '@(ctrl.IsApplicable ? "true" : "false")', '@Html.Raw(Html.Encode(ctrl.Justification))', '@Html.Raw(Html.Encode(ctrl.Description))')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger" title="Delete Control"
                                        onclick="openDeleteControlModal('@ctrl.Id', '@ctrl.Code', '@Html.Raw(Html.Encode(ctrl.Title))')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Empty State -->
    <div id="ctrlEmptyState" class="text-center py-5" style="display: none;">
        <i class="bi bi-search text-muted" style="font-size: 2.5rem;"></i>
        <h6 class="fw-bold mt-2 mb-1">No matching security controls found</h6>
        <p class="text-muted small mb-0">Try adjusting your keyword search or changing the filter options above.</p>
    </div>
</div>

<!-- Modal: Add Control -->
<div class="modal fade" id="addControlModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-shield-plus me-2"></i> Add New Security Control</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Controls" asp-action="Create" method="post">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Control Code <span class="text-danger">*</span></label>
                            <input type="text" name="Code" class="form-control form-control-sm" placeholder="e.g. CTRL-007" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Control Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" class="form-control form-control-sm" placeholder="e.g. Multi-Factor Authentication" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Standard</label>
                            <select name="StandardId" class="form-select form-select-sm">
                                <option value="ISO-27001-2022">ISO 27001:2022 (ISMS)</option>
                                <option value="ISO-9001-2015">ISO 9001:2015 (QMS)</option>
                                <option value="ISO-14001-2015">ISO 14001:2015 (EMS)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Clause / Requirement ID</label>
                            <input type="text" name="RequirementId" class="form-control form-control-sm" placeholder="e.g. REQ-A5-18" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Category</label>
                            <select name="Category" class="form-select form-select-sm">
                                <option value="Organizational Controls">Organizational Controls</option>
                                <option value="Technological Controls">Technological Controls</option>
                                <option value="Physical Controls">Physical Controls</option>
                                <option value="People Controls">People Controls</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Control Owner</label>
                            <input type="text" name="Owner" class="form-control form-control-sm" placeholder="e.g. David Chen (IT Manager)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Implementation Status</label>
                            <select name="Status" class="form-select form-select-sm">
                                <option value="0">NotImplemented</option>
                                <option value="1">InDevelopment</option>
                                <option value="2" selected>Implemented</option>
                                <option value="3">Tested</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Initial Compliance %</label>
                            <input type="number" step="0.1" name="CompliancePercentage" class="form-control form-control-sm" value="100.0" min="0" max="100" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="IsApplicable" value="true" checked id="addIsApplicable">
                                <label class="form-check-label small fw-bold" for="addIsApplicable">Included in Statement of Applicability (SoA)</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">SoA Justification</label>
                            <input type="text" name="Justification" class="form-control form-control-sm" placeholder="Reason for inclusion or exclusion in ISO scope" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Control Description / Policy Summary</label>
                            <textarea name="Description" class="form-control form-control-sm" rows="3" placeholder="Detailed control implementation guidance..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check2-circle me-1"></i> Save Control</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Control -->
<div class="modal fade" id="editControlModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i> Edit Security Control</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Controls" asp-action="Edit" method="post">
                <input type="hidden" name="Id" id="editCtrlId" />
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Control Code</label>
                            <input type="text" name="Code" id="editCtrlCode" class="form-control form-control-sm" readonly />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Control Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" id="editCtrlTitle" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Standard</label>
                            <select name="StandardId" id="editCtrlStandard" class="form-select form-select-sm">
                                <option value="ISO-27001-2022">ISO 27001:2022 (ISMS)</option>
                                <option value="ISO-9001-2015">ISO 9001:2015 (QMS)</option>
                                <option value="ISO-14001-2015">ISO 14001:2015 (EMS)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Clause / Requirement ID</label>
                            <input type="text" name="RequirementId" id="editCtrlReq" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Category</label>
                            <select name="Category" id="editCtrlCategory" class="form-select form-select-sm">
                                <option value="Organizational Controls">Organizational Controls</option>
                                <option value="Technological Controls">Technological Controls</option>
                                <option value="Physical Controls">Physical Controls</option>
                                <option value="People Controls">People Controls</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Control Owner</label>
                            <input type="text" name="Owner" id="editCtrlOwner" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Implementation Status</label>
                            <select name="Status" id="editCtrlStatus" class="form-select form-select-sm">
                                <option value="0">NotImplemented</option>
                                <option value="1">InDevelopment</option>
                                <option value="2">Implemented</option>
                                <option value="3">Tested</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Compliance %</label>
                            <input type="number" step="0.1" name="CompliancePercentage" id="editCtrlCompliance" class="form-control form-control-sm" min="0" max="100" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="IsApplicable" value="true" id="editCtrlApplicable">
                                <label class="form-check-label small fw-bold" for="editCtrlApplicable">Included in Statement of Applicability (SoA)</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">SoA Justification</label>
                            <input type="text" name="Justification" id="editCtrlJustification" class="form-control form-control-sm" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Control Description</label>
                            <textarea name="Description" id="editCtrlDesc" class="form-control form-control-sm" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark btn-sm"><i class="bi bi-check2-circle me-1"></i> Update Control</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Delete Control -->
<div class="modal fade" id="deleteControlModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Control</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Controls" asp-action="Delete" method="post">
                <input type="hidden" name="id" id="deleteCtrlId" />
                <div class="modal-body p-4">
                    <p class="mb-1">Are you sure you want to permanently delete control <strong id="deleteCtrlCode"></strong> (<span id="deleteCtrlTitle"></span>)?</p>
                    <p class="text-muted small mb-0">This action will remove the control and dissociate linked risks, policies, and tasks.</p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash me-1"></i> Confirm Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        new AdvanceSearch({
            containerId: 'controlsTableBody',
            searchInputId: 'ctrlSearchInput',
            counterId: 'ctrlResultsCounter',
            resetBtnId: 'ctrlResetBtn',
            emptyStateId: 'ctrlEmptyState',
            filterSelects: [
                { id: 'ctrlCategoryFilter', colIndex: 3 },
                { id: 'ctrlStatusFilter', colIndex: 5 }
            ]
        });
    });

    function openEditControlModal(id, code, title, standardId, reqId, category, owner, status, compliance, applicable, justification, desc) {
        document.getElementById('editCtrlId').value = id;
        document.getElementById('editCtrlCode').value = code;
        document.getElementById('editCtrlTitle').value = title;
        document.getElementById('editCtrlStandard').value = standardId;
        document.getElementById('editCtrlReq').value = reqId;
        document.getElementById('editCtrlCategory').value = category;
        document.getElementById('editCtrlOwner').value = owner;
        document.getElementById('editCtrlStatus').value = status;
        document.getElementById('editCtrlCompliance').value = compliance;
        document.getElementById('editCtrlApplicable').checked = applicable === 'true';
        document.getElementById('editCtrlJustification').value = justification;
        document.getElementById('editCtrlDesc').value = desc;
        new bootstrap.Modal(document.getElementById('editControlModal')).show();
    }

    function openDeleteControlModal(id, code, title) {
        document.getElementById('deleteCtrlId').value = id;
        document.getElementById('deleteCtrlCode').textContent = code;
        document.getElementById('deleteCtrlTitle').textContent = title;
        new bootstrap.Modal(document.getElementById('deleteControlModal')).show();
    }
</script>
