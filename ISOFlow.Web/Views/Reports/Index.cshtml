@{
    ViewData["Title"] = "Reports Hub";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-bar-chart-line text-primary me-2"></i> Executive & Compliance Reports</h4>
        <p class="text-muted small mb-0">Downloadable PDF / Excel exports are not available yet. Until then, each report links to the live page it will be built from.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card-enterprise p-4 text-center h-100">
            <i class="bi bi-shield-check fs-1 text-primary mb-2"></i>
            <h6 class="fw-bold">Executive Compliance Summary</h6>
            <p class="text-muted small">Overall compliance score, control implementation status, and SoA overview.</p>
            <a asp-controller="Controls" asp-action="Soa" class="btn btn-outline-primary btn-sm w-100 mt-2"><i class="bi bi-table me-1"></i> View Statement of Applicability</a>
            <button class="btn btn-light btn-sm w-100 mt-2" disabled title="Export not implemented yet"><i class="bi bi-download me-1"></i> PDF export — coming soon</button>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-enterprise p-4 text-center h-100">
            <i class="bi bi-exclamation-triangle fs-1 text-warning mb-2"></i>
            <h6 class="fw-bold">Risk Assessment Register Report</h6>
            <p class="text-muted small">Complete risk matrix heatmap, high risks, and treatment plan progress.</p>
            <a asp-controller="Risks" asp-action="Index" class="btn btn-outline-primary btn-sm w-100 mt-2"><i class="bi bi-list-ul me-1"></i> View Risk Register</a>
            <button class="btn btn-light btn-sm w-100 mt-2" disabled title="Export not implemented yet"><i class="bi bi-download me-1"></i> Excel export — coming soon</button>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-enterprise p-4 text-center h-100">
            <i class="bi bi-clipboard-check fs-1 text-success mb-2"></i>
            <h6 class="fw-bold">Internal Audit & CAPA Report</h6>
            <p class="text-muted small">Audit findings, root cause analysis, and CAPA resolution tracking.</p>
            <a asp-controller="Audits" asp-action="Index" class="btn btn-outline-primary btn-sm w-100 mt-2"><i class="bi bi-clipboard-check me-1"></i> View Audits</a>
            <button class="btn btn-light btn-sm w-100 mt-2" disabled title="Export not implemented yet"><i class="bi bi-download me-1"></i> PDF export — coming soon</button>
        </div>
    </div>
</div>
