@{
    ViewData["Title"] = "Reports Hub";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-bar-chart-line text-primary me-2"></i> Executive & Compliance Reports</h4>
        <p class="text-muted small mb-0">Generate and export downloadable ISO compliance, risk assessment, and audit reports.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card-enterprise p-4 text-center h-100">
            <i class="bi bi-shield-check fs-1 text-primary mb-2"></i>
            <h6 class="fw-bold">ISO 27001 Executive Summary</h6>
            <p class="text-muted small">Overall compliance score, control implementation status, and SoA overview.</p>
            <button class="btn btn-outline-primary btn-sm w-100 mt-2" onclick="alert('Downloading ISO 27001 Executive Summary PDF...')"><i class="bi bi-download me-1"></i> Download PDF</button>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-enterprise p-4 text-center h-100">
            <i class="bi bi-exclamation-triangle fs-1 text-warning mb-2"></i>
            <h6 class="fw-bold">Risk Assessment Register Report</h6>
            <p class="text-muted small">Complete risk matrix heatmap, high risks, and treatment plan progress.</p>
            <button class="btn btn-outline-primary btn-sm w-100 mt-2" onclick="alert('Downloading Risk Register Excel...')"><i class="bi bi-download me-1"></i> Export Excel</button>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-enterprise p-4 text-center h-100">
            <i class="bi bi-clipboard-check fs-1 text-success mb-2"></i>
            <h6 class="fw-bold">Internal Audit & CAPA Report</h6>
            <p class="text-muted small">Audit AUD-2026-001 findings, root cause analysis, and CAPA resolution tracking.</p>
            <button class="btn btn-outline-primary btn-sm w-100 mt-2" onclick="alert('Downloading Audit & CAPA Report PDF...')"><i class="bi bi-download me-1"></i> Download PDF</button>
        </div>
    </div>
</div>
