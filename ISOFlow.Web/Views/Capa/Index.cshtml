@using ISOFlow.Domain.Enums
@model List<ISOFlow.Domain.Entities.CAPA>
@{
    ViewData["Title"] = "CAPA Management";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-tools text-info me-2"></i> Corrective &amp; Preventive Action (CAPA)</h4>
        <p class="text-muted small mb-0">Systemic remediation plans, action items, target dates, and effectiveness verification.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-info text-white btn-sm" data-bs-toggle="modal" data-bs-target="#addCapaModal">
            <i class="bi bi-plus-circle me-1"></i> Initiate CAPA
        </button>
    </div>
</div>

<!-- ── Advance Search & Filter Toolbar ── -->
<div class="card-enterprise p-3 mb-4 bg-light border">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="capaSearchInput" class="form-control border-start-0" placeholder="Search by CAPA ID, title, finding, owner..." />
            </div>
        </div>
        <div class="col-6 col-md-4">
            <select id="capaStatusFilter" class="form-select form-select-sm">
                <option value="all">All CAPA Statuses</option>
                <option value="InProgress">In Progress</option>
                <option value="ActionPlanApproved">Action Plan Approved</option>
                <option value="VerificationPending">Verification Pending</option>
                <option value="Closed">Closed</option>
            </select>
        </div>
        <div class="col-6 col-md-3 d-flex justify-content-end">
            <button type="button" id="capaResetBtn" class="btn btn-sm btn-outline-secondary w-100" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
            </button>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top small text-muted">
        <span id="capaResultsCounter">Showing <strong>@Model.Count</strong> of <strong>@Model.Count</strong> records</span>
        <span class="badge bg-info-subtle text-info"><i class="bi bi-funnel me-1"></i> Live Filter</span>
    </div>
</div>

<div class="card-enterprise p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>CAPA ID</th>
                    <th>Title</th>
                    <th>Finding</th>
                    <th>Owner</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="capaTableBody">
                @foreach (var capa in Model)
                {
                    <tr class="@(capa.Id == "CAPA-001" ? "table-info" : "")">
                        <td class="fw-bold text-info">@capa.Code</td>
                        <td>
                            <a asp-controller="Capa" asp-action="Detail" asp-route-id="@capa.Id" class="fw-semibold text-dark text-decoration-none">@capa.Title</a>
                            <div class="text-muted small">@capa.CorrectiveAction</div>
                        </td>
                        <td><a asp-controller="Findings" asp-action="Detail" asp-route-id="@capa.FindingId" class="badge bg-light text-danger border">@capa.FindingId</a></td>
                        <td class="small">@capa.Owner</td>
                        <td class="small fw-semibold">@capa.DueDate.ToString("dd-MMM-yyyy")</td>
                        <td>
                            @{
                                var capaBadge = capa.Status switch {
                                    CapaStatus.Closed => "bg-success text-white",
                                    CapaStatus.InProgress => "bg-warning text-dark",
                                    CapaStatus.ActionPlanApproved => "bg-info text-dark",
                                    CapaStatus.VerificationPending => "bg-primary text-white",
                                    _ => "bg-secondary text-white"
                                };
                            }
                            <span class="badge @capaBadge">@capa.Status</span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-controller="Capa" asp-action="Detail" asp-route-id="@capa.Id" class="btn btn-outline-primary" title="CAPA Checklist & Evidence">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <button type="button" class="btn btn-outline-secondary" title="Edit CAPA"
                                        onclick="openEditCapaModal('@capa.Id', '@capa.Code', '@Html.Raw(Html.Encode(capa.Title))', '@capa.FindingId', '@Html.Raw(Html.Encode(capa.Owner))', '@capa.DueDate.ToString("yyyy-MM-dd")', '@((int)capa.Status)', '@Html.Raw(Html.Encode(capa.RootCause))', '@Html.Raw(Html.Encode(capa.CorrectiveAction))', '@Html.Raw(Html.Encode(capa.EffectivenessVerification))')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger" title="Delete CAPA"
                                        onclick="openDeleteCapaModal('@capa.Id', '@capa.Code', '@Html.Raw(Html.Encode(capa.Title))')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Empty State -->
    <div id="capaEmptyState" class="text-center py-5" style="display: none;">
        <i class="bi bi-search text-muted" style="font-size: 2.5rem;"></i>
        <h6 class="fw-bold mt-2 mb-1">No matching CAPA remediation records found</h6>
        <p class="text-muted small mb-0">Try adjusting your keyword search or status filter.</p>
    </div>
</div>

<!-- Modal: Add CAPA -->
<div class="modal fade" id="addCapaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-tools me-2"></i> Initiate Corrective Action Plan (CAPA)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Capa" asp-action="Create" method="post">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">CAPA Code <span class="text-danger">*</span></label>
                            <input type="text" name="Code" class="form-control form-control-sm" placeholder="e.g. CAPA-002" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">CAPA Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" class="form-control form-control-sm" placeholder="e.g. Backup Testing Protocol Revision" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Linked Finding ID</label>
                            <input type="text" name="FindingId" class="form-control form-control-sm" placeholder="e.g. FIND-001" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Remediation Owner</label>
                            <input type="text" name="Owner" class="form-control form-control-sm" placeholder="e.g. David Chen (IT Manager)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Due Date</label>
                            <input type="date" name="DueDate" class="form-control form-control-sm" value="@DateTime.UtcNow.AddDays(30).ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Status</label>
                            <select name="Status" class="form-select form-select-sm">
                                <option value="0">Draft</option>
                                <option value="1">InAnalysis</option>
                                <option value="2">ActionPlanApproved</option>
                                <option value="3" selected>InProgress</option>
                                <option value="4">VerificationPending</option>
                                <option value="5">Closed</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Effectiveness Verification Method</label>
                            <input type="text" name="VerificationMethod" class="form-control form-control-sm" placeholder="e.g. 30-day simulated restore dry run" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Root Cause Analysis</label>
                            <textarea name="RootCause" class="form-control form-control-sm" rows="2" placeholder="Explain the systemic underlying cause..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Corrective &amp; Preventive Action Plan</label>
                            <textarea name="CorrectiveAction" class="form-control form-control-sm" rows="3" placeholder="Specify technical steps and process changes to prevent recurrence..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info text-white btn-sm"><i class="bi bi-check2-circle me-1"></i> Save CAPA</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit CAPA -->
<div class="modal fade" id="editCapaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i> Edit CAPA Remediation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Capa" asp-action="Edit" method="post">
                <input type="hidden" name="Id" id="editCapaId" />
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">CAPA Code</label>
                            <input type="text" name="Code" id="editCapaCode" class="form-control form-control-sm" readonly />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">CAPA Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" id="editCapaTitle" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Finding ID</label>
                            <input type="text" name="FindingId" id="editCapaFinding" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Owner</label>
                            <input type="text" name="Owner" id="editCapaOwner" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Due Date</label>
                            <input type="date" name="DueDate" id="editCapaDue" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Status</label>
                            <select name="Status" id="editCapaStatus" class="form-select form-select-sm">
                                <option value="0">Draft</option>
                                <option value="1">InAnalysis</option>
                                <option value="2">ActionPlanApproved</option>
                                <option value="3">InProgress</option>
                                <option value="4">VerificationPending</option>
                                <option value="5">Closed</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Verification Method</label>
                            <input type="text" name="VerificationMethod" id="editCapaVerif" class="form-control form-control-sm" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Root Cause</label>
                            <textarea name="RootCause" id="editCapaRoot" class="form-control form-control-sm" rows="2"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Corrective Action</label>
                            <textarea name="CorrectiveAction" id="editCapaAction" class="form-control form-control-sm" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark btn-sm"><i class="bi bi-check2-circle me-1"></i> Update CAPA</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Delete CAPA -->
<div class="modal fade" id="deleteCapaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Delete CAPA Record</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Capa" asp-action="Delete" method="post">
                <input type="hidden" name="id" id="deleteCapaId" />
                <div class="modal-body p-4">
                    <p class="mb-1">Are you sure you want to delete CAPA remediation <strong id="deleteCapaCode"></strong>?</p>
                    <p class="text-muted small mb-0">This corrective action plan and its action items will be removed.</p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash me-1"></i> Confirm Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        new AdvanceSearch({
            containerId: 'capaTableBody',
            searchInputId: 'capaSearchInput',
            counterId: 'capaResultsCounter',
            resetBtnId: 'capaResetBtn',
            emptyStateId: 'capaEmptyState',
            filterSelects: [
                { id: 'capaStatusFilter', colIndex: 5 }
            ]
        });
    });

    function openEditCapaModal(id, code, title, findingId, owner, due, status, root, action, verif) {
        document.getElementById('editCapaId').value = id;
        document.getElementById('editCapaCode').value = code;
        document.getElementById('editCapaTitle').value = title;
        document.getElementById('editCapaFinding').value = findingId;
        document.getElementById('editCapaOwner').value = owner;
        document.getElementById('editCapaDue').value = due;
        document.getElementById('editCapaStatus').value = status;
        document.getElementById('editCapaRoot').value = root;
        document.getElementById('editCapaAction').value = action;
        document.getElementById('editCapaVerif').value = verif;
        new bootstrap.Modal(document.getElementById('editCapaModal')).show();
    }

    function openDeleteCapaModal(id, code, title) {
        document.getElementById('deleteCapaId').value = id;
        document.getElementById('deleteCapaCode').textContent = code;
        new bootstrap.Modal(document.getElementById('deleteCapaModal')).show();
    }
</script>
