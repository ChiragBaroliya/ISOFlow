@model ISOFlow.Domain.Entities.CAPA
@{
    ViewData["Title"] = $"{Model?.Code ?? "CAPA-001"} - {Model?.Title ?? "Remediation"}";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-info text-white fs-6">@(Model?.Code ?? "CAPA-001")</span>
            <span class="badge bg-warning text-dark">Status: @(Model?.Status.ToString() ?? "InProgress")</span>
        </div>
        <h3 class="fw-bold text-dark mb-0">@(Model?.Title ?? "CAPA Remediation Plan")</h3>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addActionItemModal">
            <i class="bi bi-plus-circle me-1"></i> Add Action Item
        </button>
        <a asp-controller="Capa" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back to CAPA</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-7">
        <div class="card-enterprise p-4 h-100">
            <h6 class="fw-bold mb-3"><i class="bi bi-list-task text-primary me-2"></i> CAPA Action Items Plan</h6>
            <div class="list-group mb-3">
                @if (Model?.ActionItems != null && Model.ActionItems.Any())
                {
                    @foreach (var act in Model.ActionItems)
                    {
                        <div class="list-group-item d-flex align-items-center justify-content-between">
                            <form asp-controller="Capa" asp-action="ToggleAction" method="post" class="d-flex align-items-center mb-0">
                                <input type="hidden" name="capaId" value="@Model.Id" />
                                <input type="hidden" name="actionItemId" value="@act.Id" />
                                <button type="submit" class="btn btn-link p-0 text-decoration-none d-flex align-items-center">
                                    <i class="bi @(act.IsCompleted ? "bi-check-square-fill text-success" : "bi-square text-secondary") fs-5 me-2"></i>
                                    <span class="@(act.IsCompleted ? "text-decoration-line-through text-muted" : "fw-semibold text-dark")">@act.Title</span>
                                </button>
                            </form>
                            <span class="small text-muted">@act.AssignedTo (Due: @act.DueDate.ToString("dd-MMM"))</span>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted small p-3 text-center">No action items defined yet. Click "Add Action Item" to create one.</div>
                }
            </div>

            <div class="p-3 bg-light rounded border small">
                <strong>Effectiveness Verification Plan:</strong> @(Model?.EffectivenessVerification ?? "Verification scheduled post-implementation")
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card-enterprise p-4 h-100 border-start border-primary border-4">
            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-briefcase me-2"></i> Executive Escalation & Management Review</h6>
            <p class="small text-muted mb-3">CAPA progress and remediation milestones are reviewed periodically by executive leadership.</p>
            
            <a asp-controller="ManagementReview" asp-action="Index" class="btn btn-primary w-100 fw-semibold mb-2"><i class="bi bi-briefcase me-1"></i> Open Q4 Management Review <i class="bi bi-arrow-right"></i></a>
            <a asp-controller="Improvement" asp-action="Index" class="btn btn-outline-success w-100 fw-semibold"><i class="bi bi-graph-up-arrow me-1"></i> View IMP-001 Continual Improvement</a>
        </div>
    </div>
</div>

<!-- Modal: Add Action Item -->
<div class="modal fade" id="addActionItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2"></i> Add Action Item</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Capa" asp-action="AddActionItem" method="post">
                <input type="hidden" name="capaId" value="@(Model?.Id ?? "CAPA-001")" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Action Item Title <span class="text-danger">*</span></label>
                        <input type="text" name="Title" class="form-control form-control-sm" placeholder="e.g. Conduct second-round validation test" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Assigned To</label>
                        <input type="text" name="AssignedTo" class="form-control form-control-sm" placeholder="e.g. Sarah Wilson" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Due Date</label>
                        <input type="date" name="DueDate" class="form-control form-control-sm" value="@DateTime.UtcNow.AddDays(14).ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check2-circle me-1"></i> Add Item</button>
                </div>
            </form>
        </div>
    </div>
</div>
