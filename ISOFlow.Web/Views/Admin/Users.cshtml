@using ISOFlow.Domain.Enums
@model List<ISOFlow.Domain.Entities.User>
@{
    ViewData["Title"] = "Users & Role-Based Access Control";
    ViewData["ActiveMenu"] = "Users";

    var currentSystemRole = Context.Session.GetString("ActiveUserSystemRole") ?? "";
    var currentOrgId      = Context.Session.GetString("ActiveOrgId") ?? "";

    // SuperAdmin sees everyone; Admin/User see only their org
    var visibleUsers = currentSystemRole == "SuperAdmin"
        ? Model
        : Model.Where(u => u.OrganizationId == currentOrgId).ToList();

    var organizations = ViewBag.Organizations as List<ISOFlow.Domain.Entities.Organization> ?? new List<ISOFlow.Domain.Entities.Organization>();
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-people text-primary me-2"></i> Users &amp; Role-Based Access Control</h4>
        <p class="text-muted small mb-0">
            System role assignments, permission scopes, and organizational department mappings.
            @if (currentSystemRole == "SuperAdmin")
            {
                <span class="badge bg-purple text-white ms-2" style="font-size:.7rem; background:#7c3aed;">Showing all organizations</span>
            }
            else
            {
                <span class="badge bg-primary text-white ms-2" style="font-size:.7rem;">Scoped to your organization</span>
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addUserModal">
            <i class="bi bi-person-plus me-1"></i> Add User
        </button>
    </div>
</div>

<!-- Role Legend -->
<div class="d-flex gap-3 mb-4 flex-wrap">
    <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3" style="background:rgba(124,58,237,.1); border:1px solid rgba(124,58,237,.25);">
        <i class="bi bi-shield-fill-check text-purple" style="color:#7c3aed;"></i>
        <div>
            <div class="fw-bold small" style="color:#7c3aed;">Super Admin</div>
            <div style="font-size:.7rem; color:#6b7280;">Global platform access · Manages all organizations</div>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3" style="background:rgba(59,130,246,.1); border:1px solid rgba(59,130,246,.25);">
        <i class="bi bi-shield-fill-check text-primary"></i>
        <div>
            <div class="fw-bold small text-primary">Admin</div>
            <div style="font-size:.7rem; color:#6b7280;">Organization-scoped · Full compliance access</div>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3" style="background:rgba(16,185,129,.1); border:1px solid rgba(16,185,129,.25);">
        <i class="bi bi-person-fill text-success"></i>
        <div>
            <div class="fw-bold small text-success">User</div>
            <div style="font-size:.7rem; color:#6b7280;">Organization-scoped · Read/limited access</div>
        </div>
    </div>
</div>

<!-- ── Advance Search & Filter Toolbar ── -->
<div class="card-enterprise p-3 mb-4 bg-light border">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="userSearchInput" class="form-control border-start-0" placeholder="Search by Name, email, department, job role, location..." />
            </div>
        </div>
        <div class="col-6 col-md-4">
            <select id="userSystemRoleFilter" class="form-select form-select-sm">
                <option value="all">All System Roles</option>
                <option value="Super Admin">Super Admin</option>
                <option value="Admin">Admin</option>
                <option value="User">User</option>
            </select>
        </div>
        <div class="col-6 col-md-3 d-flex justify-content-end">
            <button type="button" id="userResetBtn" class="btn btn-sm btn-outline-secondary w-100" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
            </button>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top small text-muted">
        <span id="userResultsCounter">Showing <strong>@visibleUsers.Count</strong> of <strong>@visibleUsers.Count</strong> records</span>
        <span class="badge bg-primary-subtle text-primary"><i class="bi bi-funnel me-1"></i> Live Filter</span>
    </div>
</div>

<div class="card-enterprise p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle" id="usersTable">
            <thead class="table-light">
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>System Role</th>
                    <th>Job Role</th>
                    <th>Department</th>
                    <th>Organization</th>
                    <th>Location</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="usersTableBody">
                @foreach (var user in visibleUsers)
                {
                    var (sysRoleBadge, sysRoleLabel) = user.SystemRole switch
                    {
                        SystemRole.SuperAdmin => ("badge-superadmin-ui", "Super Admin"),
                        SystemRole.Admin      => ("badge bg-primary text-white", "Admin"),
                        _                     => ("badge bg-success text-white", "User")
                    };

                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="@user.AvatarUrl" class="rounded-circle" width="34" height="34" alt="@user.Name" />
                                <span class="fw-semibold">@user.Name</span>
                            </div>
                        </td>
                        <td class="small text-muted">@user.Email</td>
                        <td>
                            <span class="badge @sysRoleBadge fw-bold" style="@(user.SystemRole == SystemRole.SuperAdmin ? "background:rgba(124,58,237,.15);color:#7c3aed;border:1px solid rgba(124,58,237,.35);" : "")">
                                <i class="bi bi-shield-fill me-1"></i>@sysRoleLabel
                            </span>
                        </td>
                        <td><span class="badge bg-primary-subtle text-primary fw-semibold">@user.Role</span></td>
                        <td class="small">@user.Department</td>
                        <td class="small">
                            @if (string.IsNullOrEmpty(user.OrganizationId))
                            {
                                <span class="badge" style="background:rgba(124,58,237,.15);color:#7c3aed;border:1px solid rgba(124,58,237,.3); font-size:.7rem;">
                                    <i class="bi bi-globe me-1"></i>Global
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border" style="font-size:.7rem;">@user.OrganizationId</span>
                            }
                        </td>
                        <td class="small"><span class="badge bg-light text-dark border">@user.Location</span></td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary" title="Edit User"
                                        onclick="openEditUserModal('@user.Id', '@Html.Raw(Html.Encode(user.Name))', '@Html.Raw(Html.Encode(user.Email))', '@((int)user.SystemRole)', '@Html.Raw(Html.Encode(user.Role))', '@Html.Raw(Html.Encode(user.Department))', '@user.OrganizationId', '@Html.Raw(Html.Encode(user.Location))', '@Html.Raw(Html.Encode(user.Phone))', '@Html.Raw(Html.Encode(user.Bio))')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger" title="Delete User"
                                        onclick="openDeleteUserModal('@user.Id', '@Html.Raw(Html.Encode(user.Name))', '@Html.Raw(Html.Encode(user.Email))')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Empty State -->
    <div id="userEmptyState" class="text-center py-5" style="display: none;">
        <i class="bi bi-search text-muted" style="font-size: 2.5rem;"></i>
        <h6 class="fw-bold mt-2 mb-1">No matching users found</h6>
        <p class="text-muted small mb-0">Try adjusting your keyword search or system role filter.</p>
    </div>

    <div class="text-muted small mt-2 border-top pt-3">
        <i class="bi bi-info-circle me-1"></i>
        Showing <strong>@visibleUsers.Count</strong> user(s). All users share the mock password <code>Test@123</code>.
    </div>
</div>

<!-- Modal: Add User -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-plus me-2"></i> Add Platform User</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="CreateUser" method="post">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Full Name <span class="text-danger">*</span></label>
                            <input type="text" name="Name" class="form-control form-control-sm" placeholder="e.g. Rachel Adams" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Email Address <span class="text-danger">*</span></label>
                            <input type="email" name="Email" class="form-control form-control-sm" placeholder="e.g. rachel.a@acme.com" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">System Role <span class="text-danger">*</span></label>
                            <select name="SystemRole" class="form-select form-select-sm">
                                <option value="2" selected>User (Organization Scoped)</option>
                                <option value="1">Admin (Organization Scoped)</option>
                                @if (currentSystemRole == "SuperAdmin")
                                {
                                    <option value="0">SuperAdmin (Global Platform)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Organization</label>
                            <select name="OrganizationId" class="form-select form-select-sm">
                                @if (currentSystemRole == "SuperAdmin")
                                {
                                    <option value="">Global / None</option>
                                    @foreach (var o in organizations)
                                    {
                                        <option value="@o.Id">@o.Name (@o.Code)</option>
                                    }
                                }
                                else
                                {
                                    <option value="@currentOrgId" selected>Current Organization</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Job Role / Title</label>
                            <input type="text" name="Role" class="form-control form-control-sm" placeholder="e.g. Security Specialist" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Department</label>
                            <input type="text" name="Department" class="form-control form-control-sm" placeholder="e.g. Information Security" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Location</label>
                            <input type="text" name="Location" class="form-control form-control-sm" placeholder="e.g. Amsterdam" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Phone</label>
                            <input type="tel" name="Phone" class="form-control form-control-sm" placeholder="+1 (555) 012-3456" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Bio</label>
                            <textarea name="Bio" class="form-control form-control-sm" rows="2" placeholder="Brief user profile bio..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check2-circle me-1"></i> Save User</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit User -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i> Edit Platform User</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="EditUser" method="post">
                <input type="hidden" name="Id" id="editUserId" />
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Full Name <span class="text-danger">*</span></label>
                            <input type="text" name="Name" id="editUserName" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Email Address <span class="text-danger">*</span></label>
                            <input type="email" name="Email" id="editUserEmail" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">System Role <span class="text-danger">*</span></label>
                            <select name="SystemRole" id="editUserSystemRole" class="form-select form-select-sm">
                                <option value="2">User (Organization Scoped)</option>
                                <option value="1">Admin (Organization Scoped)</option>
                                @if (currentSystemRole == "SuperAdmin")
                                {
                                    <option value="0">SuperAdmin (Global Platform)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Organization</label>
                            <select name="OrganizationId" id="editUserOrg" class="form-select form-select-sm">
                                <option value="">Global / None</option>
                                @foreach (var o in organizations)
                                {
                                    <option value="@o.Id">@o.Name (@o.Code)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Job Role / Title</label>
                            <input type="text" name="Role" id="editUserRole" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Department</label>
                            <input type="text" name="Department" id="editUserDept" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Location</label>
                            <input type="text" name="Location" id="editUserLoc" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Phone</label>
                            <input type="tel" name="Phone" id="editUserPhone" class="form-control form-control-sm" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Bio</label>
                            <textarea name="Bio" id="editUserBio" class="form-control form-control-sm" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark btn-sm"><i class="bi bi-check2-circle me-1"></i> Update User</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Delete User -->
<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Remove User Account</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="DeleteUser" method="post">
                <input type="hidden" name="id" id="deleteUserId" />
                <div class="modal-body p-4">
                    <p class="mb-1">Are you sure you want to remove user account <strong id="deleteUserName"></strong> (<span id="deleteUserEmail"></span>)?</p>
                    <p class="text-muted small mb-0">This user will lose access to all organization resources.</p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash me-1"></i> Confirm Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        new AdvanceSearch({
            containerId: 'usersTableBody',
            searchInputId: 'userSearchInput',
            counterId: 'userResultsCounter',
            resetBtnId: 'userResetBtn',
            emptyStateId: 'userEmptyState',
            filterSelects: [
                { id: 'userSystemRoleFilter', colIndex: 2 }
            ]
        });
    });

    function openEditUserModal(id, name, email, sysRole, role, dept, orgId, loc, phone, bio) {
        document.getElementById('editUserId').value = id;
        document.getElementById('editUserName').value = name;
        document.getElementById('editUserEmail').value = email;
        document.getElementById('editUserSystemRole').value = sysRole;
        document.getElementById('editUserRole').value = role;
        document.getElementById('editUserDept').value = dept;
        document.getElementById('editUserOrg').value = orgId;
        document.getElementById('editUserLoc').value = loc;
        document.getElementById('editUserPhone').value = phone;
        document.getElementById('editUserBio').value = bio;
        new bootstrap.Modal(document.getElementById('editUserModal')).show();
    }

    function openDeleteUserModal(id, name, email) {
        document.getElementById('deleteUserId').value = id;
        document.getElementById('deleteUserName').textContent = name;
        document.getElementById('deleteUserEmail').textContent = email;
        new bootstrap.Modal(document.getElementById('deleteUserModal')).show();
    }
</script>
