@model ISOFlow.Domain.Entities.Finding
@{
    ViewData["Title"] = $"{Model?.Code ?? "FIND-001"} - {Model?.Title ?? "Access not removed"}";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-danger fs-6">@(Model?.Code ?? "FIND-001")</span>
            <span class="badge bg-danger">Major Non-Conformity</span>
            <span class="badge bg-warning text-dark">Status: @(Model?.Status.ToString() ?? "CapaAssigned")</span>
        </div>
        <h3 class="fw-bold text-dark mb-0">@(Model?.Title ?? "Access not removed promptly for terminated employees")</h3>
    </div>
    <a asp-controller="Findings" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back to Findings</a>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-7">
        <div class="card-enterprise p-4 h-100">
            <h6 class="fw-bold mb-3"><i class="bi bi-exclamation-octagon text-danger me-2"></i> Non-Conformity Description & Root Cause</h6>
            <p class="text-dark">@(Model?.Description ?? "During internal audit sample testing, 2 offboarded contractors retained GitHub repository access for 48 hours after contract termination date.")</p>
            
            <div class="p-3 bg-danger-subtle rounded border border-danger my-3">
                <h6 class="fw-bold text-danger mb-1"><i class="bi bi-search me-1"></i> Root Cause Analysis</h6>
                <p class="small text-danger mb-0">@(Model?.RootCause ?? "Manual communication breakdown between HR department and IT helpdesk via email.")</p>
            </div>

            <div class="row g-2 small text-muted pt-2 border-top">
                <div class="col-6"><strong>Requirement:</strong> A.5.18 Access Rights</div>
                <div class="col-6"><strong>Control:</strong> CTRL-001 Access Management</div>
                <div class="col-6"><strong>Audit:</strong> AUD-2026-001 Internal Audit</div>
                <div class="col-6"><strong>Auditor:</strong> @(Model?.Auditor ?? "Sarah Wilson")</div>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card-enterprise p-4 h-100 border-start border-info border-4">
            <h6 class="fw-bold text-info mb-3"><i class="bi bi-tools me-2"></i> Corrective Action Plan (CAPA-001)</h6>
            <div class="p-3 bg-info-subtle rounded border border-info mb-3">
                <span class="badge bg-info text-white me-2">CAPA-001</span>
                <strong class="text-dark">Automate Employee Access Lifecycle Management</strong>
                <p class="small text-muted mt-2 mb-0">Implement automated identity lifecycle sync between Workday HR software and Okta IdP.</p>
            </div>

            <h6 class="fw-bold mb-2">Next Traceability Step</h6>
            <a asp-controller="Capa" asp-action="Detail" asp-route-id="CAPA-001" class="btn btn-info text-white w-100 fw-semibold"><i class="bi bi-tools me-1"></i> Open CAPA-001 Actions <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
</div>
