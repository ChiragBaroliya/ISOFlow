@using ISOFlow.Domain.Enums
@model ISOFlow.Web.Models.FindingDetailViewModel
@{
    var finding = Model.Finding;
    ViewData["Title"] = $"{finding.Code} - {finding.Title}";

    string SeverityBadge(FindingSeverity severity) => severity switch
    {
        FindingSeverity.MajorNonConformity => "bg-danger",
        FindingSeverity.MinorNonConformity => "bg-warning text-dark",
        FindingSeverity.Observation => "bg-info text-white",
        _ => "bg-secondary"
    };
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-danger fs-6">@finding.Code</span>
            <span class="badge @SeverityBadge(finding.Severity)">@finding.Severity</span>
            <span class="badge bg-warning text-dark">Status: @finding.Status</span>
        </div>
        <h3 class="fw-bold text-dark mb-0">@finding.Title</h3>
    </div>
    <a asp-controller="Findings" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back to Findings</a>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-7">
        <div class="card-enterprise p-4 h-100">
            <h6 class="fw-bold mb-3"><i class="bi bi-exclamation-octagon text-danger me-2"></i> Non-Conformity Description & Root Cause</h6>
            <p class="text-dark">@(string.IsNullOrWhiteSpace(finding.Description) ? "No description recorded." : finding.Description)</p>

            <div class="p-3 bg-danger-subtle rounded border border-danger my-3">
                <h6 class="fw-bold text-danger mb-1"><i class="bi bi-search me-1"></i> Root Cause Analysis</h6>
                <p class="small text-danger mb-0">@(string.IsNullOrWhiteSpace(finding.RootCause) ? "Root cause not yet analysed." : finding.RootCause)</p>
            </div>

            <div class="row g-2 small text-muted pt-2 border-top">
                <div class="col-6"><strong>Requirement:</strong> @(Model.Requirement == null ? "—" : $"{Model.Requirement.Clause} {Model.Requirement.Title}")</div>
                <div class="col-6">
                    <strong>Control:</strong>
                    @if (Model.Control != null)
                    {
                        <a asp-controller="Controls" asp-action="Detail" asp-route-id="@Model.Control.Code">@Model.Control.Code @Model.Control.Title</a>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </div>
                <div class="col-6">
                    <strong>Audit:</strong>
                    @if (Model.Audit != null)
                    {
                        <a asp-controller="Audits" asp-action="Detail" asp-route-id="@Model.Audit.Code">@Model.Audit.Code @Model.Audit.Title</a>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </div>
                <div class="col-6"><strong>Auditor:</strong> @(string.IsNullOrWhiteSpace(finding.Auditor) ? "—" : finding.Auditor)</div>
                <div class="col-6"><strong>Identified:</strong> @finding.IdentifiedDate.ToString("dd-MMM-yyyy")</div>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card-enterprise p-4 h-100 border-start border-info border-4">
            <h6 class="fw-bold text-info mb-3"><i class="bi bi-tools me-2"></i> Corrective Action Plans (@Model.Capas.Count)</h6>
            @if (Model.Capas.Any())
            {
                @foreach (var capa in Model.Capas)
                {
                    <div class="p-3 bg-info-subtle rounded border border-info mb-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="badge bg-info text-white me-2">@capa.Code</span>
                                <strong class="text-dark">@capa.Title</strong>
                            </div>
                            <span class="badge bg-light text-dark border">@capa.Status</span>
                        </div>
                        <a asp-controller="Capa" asp-action="Detail" asp-route-id="@capa.Code" class="btn btn-sm btn-info text-white w-100 fw-semibold mt-2"><i class="bi bi-tools me-1"></i> Open @capa.Code <i class="bi bi-arrow-right"></i></a>
                    </div>
                }
            }
            else
            {
                <div class="text-muted small p-3 border rounded bg-light"><i class="bi bi-inbox me-1"></i> No CAPA has been raised for this finding yet.</div>
            }
        </div>
    </div>
</div>
