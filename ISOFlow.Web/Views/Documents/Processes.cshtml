@model ISOFlow.Domain.Entities.Process
@{
    ViewData["Title"] = "Business Processes Visualizer";
    var allProcesses = ViewBag.AllProcesses as List<ISOFlow.Domain.Entities.Process> ?? new List<ISOFlow.Domain.Entities.Process>();
    var policies = ViewBag.Policies as List<ISOFlow.Domain.Entities.Policy> ?? new List<ISOFlow.Domain.Entities.Policy>();
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-diagram-3 text-info me-2"></i> Business Processes & Workflow Visualizer</h4>
        <p class="text-muted small mb-0">Standard Operating Procedures (SOPs) and compliance execution workflows.</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model != null)
        {
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#editProcessModal">
                <i class="bi bi-pencil me-1"></i> Edit Process
            </button>
        }
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createProcessModal">
            <i class="bi bi-plus-lg me-1"></i> Add Business Process
        </button>
    </div>
</div>

<!-- Process Selector Navigation Pills -->
<div class="mb-4 overflow-auto pb-2">
    <ul class="nav nav-pills flex-nowrap">
        @foreach (var proc in allProcesses)
        {
            <li class="nav-item">
                <a asp-controller="Documents" asp-action="Processes" asp-route-id="@proc.Id"
                   class="nav-item-pill nav-link me-2 text-nowrap @(Model?.Id == proc.Id ? "active fw-bold" : "")">
                    <i class="bi bi-diagram-3 me-1"></i> @proc.Code — @proc.Title
                    @if (proc.Status == "Archived")
                    {
                        <span class="badge bg-secondary ms-1">Archived</span>
                    }
                </a>
            </li>
        }
    </ul>
</div>

@if (Model != null)
{
    <!-- Active Process Header Card -->
    <div class="card-enterprise p-4 mb-4">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-3 pb-3 border-bottom">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-primary fs-6">@Model.Code</span>
                    <span class="badge bg-info-subtle text-info fw-bold">@Model.Category</span>
                    <span class="badge bg-success-subtle text-success">v@Model.Version</span>
                    <span class="badge bg-light text-dark border">@Model.Status</span>
                </div>
                <h4 class="fw-bold text-dark mb-1">@Model.Title</h4>
                <p class="text-muted small mb-0">@Model.Description</p>
            </div>
            <div class="text-md-end">
                <div class="small text-muted"><i class="bi bi-person-badge text-primary me-1"></i> Owner: <strong>@Model.Owner</strong></div>
                <div class="small text-muted mt-1"><i class="bi bi-file-earmark-text me-1"></i> Linked Policy: <strong>@(string.IsNullOrEmpty(Model.PolicyId) ? "POL-001 Access Control Policy" : Model.PolicyId)</strong></div>
            </div>
        </div>

        <!-- Dynamic Process Flowchart Visualizer -->
        <h6 class="fw-bold mb-4"><i class="bi bi-bezier2 text-primary me-2"></i> Step-by-Step Workflow Diagram (@Model.Steps.Count Steps)</h6>

        @if (Model.Steps != null && Model.Steps.Any())
        {
            <div class="d-flex flex-column flex-md-row align-items-stretch justify-content-start gap-2 text-center overflow-auto pb-3">
                @for (int i = 0; i < Model.Steps.Count; i++)
                {
                    var stepText = Model.Steps[i];
                    var stepTitle = stepText;
                    var stepSub = "";
                    if (stepText.Contains("(") && stepText.Contains(")"))
                    {
                        var parts = stepText.Split('(');
                        stepTitle = parts[0].Trim();
                        stepSub = "(" + parts[1];
                    }

                    <div class="p-3 bg-light rounded border flex-fill position-relative" style="min-width: 170px;">
                        <span class="badge bg-primary rounded-circle mb-2" style="width: 26px; height: 26px; line-height: 18px;">@(i + 1)</span>
                        <div class="fw-bold small text-dark">@stepTitle</div>
                        @if (!string.IsNullOrEmpty(stepSub))
                        {
                            <div class="text-muted mt-1" style="font-size: 0.75rem;">@stepSub</div>
                        }
                    </div>

                    @if (i < Model.Steps.Count - 1)
                    {
                        <div class="d-none d-md-flex align-items-center justify-content-center text-muted px-1">
                            <i class="bi bi-arrow-right fs-4 text-primary"></i>
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <div class="alert alert-light text-center py-4">No process steps defined yet. Click Edit Process to add steps.</div>
        }
    </div>

    <!-- Edit Process Modal -->
    <div class="modal fade" id="editProcessModal" tabindex="-1" aria-labelledby="editProcessModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form asp-controller="Documents" asp-action="EditProcess" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="editProcessModalLabel">
                            <i class="bi bi-pencil-square text-primary me-2"></i> Edit Process (@Model.Code)
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="Id" value="@Model.Id" />
                        <input type="hidden" name="Code" value="@Model.Code" />

                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label class="form-label fw-semibold small">Process Title</label>
                                <input type="text" class="form-control form-control-sm" name="Title" value="@Model.Title" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small">Category</label>
                                <input type="text" class="form-control form-control-sm" name="Category" value="@Model.Category" required />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Process Owner</label>
                                <input type="text" class="form-control form-control-sm" name="Owner" value="@Model.Owner" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold small">Version</label>
                                <input type="text" class="form-control form-control-sm" name="Version" value="@Model.Version" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold small">Status</label>
                                <select class="form-select form-select-sm" name="Status">
                                    <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                                    <option value="Under Review" selected="@(Model.Status == "Under Review")">Under Review</option>
                                    <option value="Archived" selected="@(Model.Status == "Archived")">Archived</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Description</label>
                            <textarea class="form-control form-control-sm" name="Description" rows="2">@Model.Description</textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Linked Policy</label>
                            <select class="form-select form-select-sm" name="PolicyId">
                                <option value="">-- Select Linked Policy --</option>
                                @foreach (var pol in policies)
                                {
                                    <option value="@pol.Id" selected="@(Model.PolicyId == pol.Id)">@pol.Code — @pol.Title</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Process Steps (One step per line)</label>
                            <textarea class="form-control form-control-sm font-monospace" name="stepsRaw" rows="6" placeholder="Enter each step on a new line...">@(Model?.Steps != null ? string.Join(Environment.NewLine, Model.Steps) : "")</textarea>
                            <div class="form-text small">Example: 1. Request Submitted (Manager signoff)<br />2. InfoSec Review & Approval</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-save me-1"></i> Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Create Process Modal -->
<div class="modal fade" id="createProcessModal" tabindex="-1" aria-labelledby="createProcessModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-controller="Documents" asp-action="CreateProcess" method="post">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="createProcessModalLabel">
                        <i class="bi bi-plus-circle text-primary me-2"></i> Add New Business Process
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold small">Process Title</label>
                            <input type="text" class="form-control form-control-sm" name="Title" placeholder="e.g. Change Management & Deployment Process" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Category</label>
                            <input type="text" class="form-control form-control-sm" name="Category" placeholder="e.g. System Operations" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Process Owner</label>
                            <input type="text" class="form-control form-control-sm" name="Owner" placeholder="e.g. Chirag Baroliya (Compliance Manager)" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">Version</label>
                            <input type="text" class="form-control form-control-sm" name="Version" value="1.0" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">Status</label>
                            <select class="form-select form-select-sm" name="Status">
                                <option value="Active" selected>Active</option>
                                <option value="Under Review">Under Review</option>
                                <option value="Draft">Draft</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Description</label>
                        <textarea class="form-control form-control-sm" name="Description" rows="2" placeholder="Describe the objective and scope of this procedure..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Linked Policy</label>
                        <select class="form-select form-select-sm" name="PolicyId">
                            <option value="">-- Select Linked Policy --</option>
                            @foreach (var pol in policies)
                            {
                                <option value="@pol.Id">@pol.Code — @pol.Title</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Process Step Workflow (One step per line)</label>
                        <textarea class="form-control form-control-sm font-monospace" name="stepsRaw" rows="6" placeholder="1. Request Submitted (Manager ticket)&#10;2. Security Impact Assessment&#10;3. Peer Review & QA Approval&#10;4. Automated Deployment Pipeline&#10;5. Post-Deployment Verification"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg me-1"></i> Create Process</button>
                </div>
            </form>
        </div>
    </div>
</div>
