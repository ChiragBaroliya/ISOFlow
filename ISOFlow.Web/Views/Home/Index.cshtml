@using System.Text.Json
@model ISOFlow.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Executive Compliance Dashboard";
    var orgName = Context.Session.GetString("ActiveOrgName") ?? string.Empty;
    var kpis = Model.Kpis;
    var implementationPct = kpis.ControlsTotalCount > 0
        ? Math.Round(kpis.ControlsImplementedCount * 100.0 / kpis.ControlsTotalCount, 1)
        : 0.0;

    // Change vs the previous recorded month, only when at least two monthly snapshots exist.
    double? monthDelta = Model.Trends.Count >= 2
        ? Math.Round(Model.Trends[^1].ComplianceScore - Model.Trends[^2].ComplianceScore, 1)
        : null;

    var trendJson = JsonSerializer.Serialize(new
    {
        labels = Model.Trends.Select(t => t.Month),
        scores = Model.Trends.Select(t => t.ComplianceScore)
    });
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i> Executive Overview</h4>
        @if (!string.IsNullOrEmpty(orgName))
        {
            <p class="text-muted small mb-0">@orgName</p>
        }
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Controls" asp-action="Index" class="btn btn-primary btn-sm"><i class="bi bi-shield-lock me-1"></i> View Controls</a>
        <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-download me-1"></i> Reports</a>
    </div>
</div>

<!-- KPI Cards Grid -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card-enterprise kpi-card border-start border-primary border-4">
            <div>
                <div class="kpi-title">Overall Compliance</div>
                <div class="kpi-value text-primary">@kpis.OverallCompliancePercentage.ToString("0.#")%</div>
                @if (monthDelta.HasValue)
                {
                    <div class="small mt-1 @(monthDelta >= 0 ? "text-success" : "text-danger")">
                        <i class="bi @(monthDelta >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>
                        @(monthDelta >= 0 ? "+" : "")@monthDelta.Value.ToString("0.#")% vs last month
                    </div>
                }
                else
                {
                    <div class="small text-muted mt-1">Average across all controls</div>
                }
            </div>
            <div class="kpi-icon bg-primary-subtle text-primary"><i class="bi bi-shield-check"></i></div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card-enterprise kpi-card border-start border-success border-4">
            <div>
                <div class="kpi-title">Controls Implemented</div>
                <div class="kpi-value">@kpis.ControlsImplementedCount <span class="fs-6 text-muted font-normal">/ @kpis.ControlsTotalCount</span></div>
                <div class="small text-muted mt-1">@implementationPct.ToString("0.#")% Implementation</div>
            </div>
            <div class="kpi-icon bg-success-subtle text-success"><i class="bi bi-shield-lock"></i></div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card-enterprise kpi-card border-start border-warning border-4">
            <div>
                <div class="kpi-title">Open Risks</div>
                <div class="kpi-value text-warning">@kpis.OpenRisksCount</div>
                <div class="small text-danger mt-1">@kpis.HighRisksCount Critical/High Risks</div>
            </div>
            <div class="kpi-icon bg-warning-subtle text-warning"><i class="bi bi-exclamation-triangle"></i></div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card-enterprise kpi-card border-start border-danger border-4">
            <div>
                <div class="kpi-title">Open Findings</div>
                <div class="kpi-value text-danger">@kpis.OpenFindingsCount</div>
                <div class="small text-muted mt-1">Not yet closed</div>
            </div>
            <div class="kpi-icon bg-danger-subtle text-danger"><i class="bi bi-bug"></i></div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4">
        <div class="card-enterprise kpi-card border-start border-info border-4">
            <div>
                <div class="kpi-title">Overdue Actions</div>
                <div class="kpi-value @(kpis.OverdueActionsCount > 0 ? "text-danger" : "")">@kpis.OverdueActionsCount</div>
                <div class="small text-muted mt-1">Tasks past their due date</div>
            </div>
            <div class="kpi-icon bg-info-subtle text-info"><i class="bi bi-clock-history"></i></div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4">
        <div class="card-enterprise kpi-card border-start border-secondary border-4">
            <div>
                <div class="kpi-title">Pending Evidence</div>
                <div class="kpi-value">@kpis.PendingEvidenceCount</div>
                <div class="small text-muted mt-1">Pending or expiring within 30 days</div>
            </div>
            <div class="kpi-icon bg-secondary-subtle text-secondary"><i class="bi bi-paperclip"></i></div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4">
        <div class="card-enterprise kpi-card border-start border-primary border-4">
            <div>
                <div class="kpi-title">Open CAPA</div>
                <div class="kpi-value text-primary">@kpis.OpenCapaCount</div>
                <div class="small text-muted mt-1">Corrective actions not yet closed</div>
            </div>
            <div class="kpi-icon bg-primary-subtle text-primary"><i class="bi bi-tools"></i></div>
        </div>
    </div>
</div>

<!-- Charts & Matrix Section -->
<div class="row g-4 mb-4">
    <!-- Compliance Trend Chart -->
    <div class="col-12 col-lg-7">
        <div class="card-enterprise p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-graph-up text-primary me-2"></i> Compliance Trend</h6>
                <span class="badge bg-light text-muted border">Monthly snapshots</span>
            </div>
            @if (Model.Trends.Count > 0)
            {
                <div style="height: 260px;">
                    <canvas id="complianceChart"></canvas>
                </div>
                <script type="application/json" id="complianceTrendData">@Html.Raw(trendJson)</script>
                @if (Model.Trends.Count == 1)
                {
                    <p class="text-muted small mb-0 mt-2">History starts this month; a new point is recorded each month.</p>
                }
            }
            else
            {
                <div class="alert alert-light text-center py-5 mb-0">
                    <i class="bi bi-graph-up text-muted fs-1 mb-2 d-block"></i>
                    <p class="text-muted small mb-0">No compliance history recorded yet.</p>
                </div>
            }
        </div>
    </div>

    <!-- 5x5 Risk Matrix -->
    <div class="col-12 col-lg-5">
        <div class="card-enterprise p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-grid-3x3-gap text-danger me-2"></i> Risk Matrix (5 × 5)</h6>
                <a asp-controller="Risks" asp-action="Matrix" class="small text-decoration-none">Full Matrix <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="table-responsive">
                <table class="risk-matrix-table">
                    @for (int l = 5; l >= 1; l--)
                    {
                        <tr>
                            <td class="small fw-bold text-muted px-1">L@(l)</td>
                            @for (int i = 1; i <= 5; i++)
                            {
                                var cell = Model.RiskMatrix.FirstOrDefault(c => c.Likelihood == l && c.Impact == i);
                                int score = l * i;
                                string colorClass = score >= 15 ? "cell-critical" : score >= 10 ? "cell-high" : score >= 5 ? "cell-medium" : "cell-low";
                                <td class="risk-matrix-cell @colorClass" onclick="window.location.href='/Risks'">
                                    @(cell?.Count > 0 ? cell.Count.ToString() : "-")
                                </td>
                            }
                        </tr>
                    }
                    <tr>
                        <td></td>
                        <td class="text-center small text-muted">I1</td>
                        <td class="text-center small text-muted">I2</td>
                        <td class="text-center small text-muted">I3</td>
                        <td class="text-center small text-muted">I4</td>
                        <td class="text-center small text-muted">I5</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
