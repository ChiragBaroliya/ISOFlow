@{
    ViewData["Title"] = "ISOFlow — Real-Time Application Flow & Customer Guide";
}

<!-- html2pdf.js CDN for 1-Click Client-Side PDF Download -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<!-- ── Print & PDF Specific Stylesheet ── -->
<style>
    @@media print {
        /* Hide UI Chrome */
        aside, .sidebar, header, .topbar, #flowTab, .btn, .no-print, .sidebar-toggle, .global-search-container {
            display: none !important;
        }
        
        body, #app-layout, .main-wrapper, .content-container {
            margin: 0 !important;
            padding: 0 !important;
            background: #ffffff !important;
            color: #000000 !important;
            width: 100% !important;
        }

        /* Show ALL Tab Content in Sequential Order for Print/PDF */
        .tab-content > .tab-pane {
            display: block !important;
            opacity: 1 !important;
            visibility: visible !important;
            margin-bottom: 2.5rem !important;
        }

        .accordion-collapse {
            display: block !important;
            height: auto !important;
            visibility: visible !important;
        }

        .card-enterprise {
            box-shadow: none !important;
            border: 1px solid #d1d5db !important;
            page-break-inside: avoid;
            break-inside: avoid;
            margin-bottom: 1.5rem !important;
        }

        .pdf-page-break {
            page-break-before: always;
            break-before: page;
            margin-top: 2rem;
            padding-top: 1rem;
        }

        .pdf-cover-header {
            display: block !important;
        }
    }

    .pdf-cover-header {
        display: none;
    }

    /* Styling for the PDF Export Container */
    #pdfExportContainer {
        background: #ffffff;
    }

    .pdf-section-title {
        border-bottom: 2px solid #2563eb;
        padding-bottom: 0.5rem;
        margin-bottom: 1.25rem;
        color: #0f172a;
        font-weight: 700;
    }

    .step-badge-pill {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .step-feature-list {
        list-style: none;
        padding-left: 0;
        margin-bottom: 0.75rem;
    }

    .step-feature-list li {
        position: relative;
        padding-left: 1.25rem;
        margin-bottom: 0.35rem;
        font-size: 0.825rem;
        color: #334155;
    }

    .step-feature-list li::before {
        content: "✓";
        position: absolute;
        left: 0;
        color: #10b981;
        font-weight: bold;
    }

    .example-box {
        background-color: #f8fafc;
        border-left: 3px solid #3b82f6;
        padding: 0.5rem 0.75rem;
        border-radius: 0 0.375rem 0.375rem 0;
        font-size: 0.8rem;
        color: #475569;
        margin-bottom: 0.75rem;
    }
</style>

<!-- ── Page Header & Quick Actions ── -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2 no-print">
    <div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary px-2 py-1"><i class="bi bi-diagram-3-fill me-1"></i> Interactive Architecture</span>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Customer Presentation Ready</span>
        </div>
        <h3 class="fw-bold text-dark mt-2 mb-1">
            <i class="bi bi-compass text-primary me-2"></i> ISOFlow End-to-End Application Flow &amp; Customer Guide
        </h3>
        <p class="text-muted small mb-0">
            A comprehensive, step-by-step visual explanation of how ISOFlow manages your company's entire ISO compliance lifecycle from setup to audit certification.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-speedometer2 me-1"></i> Go to Live Dashboard
        </a>
        <button type="button" class="btn btn-danger btn-sm shadow-sm" id="btnDownloadPdf" onclick="generatePdfDocument()">
            <i class="bi bi-file-earmark-pdf-fill me-1"></i> <span id="pdfBtnText">Download Complete PDF</span>
        </button>
        <button type="button" class="btn btn-primary btn-sm shadow-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print / Save as PDF
        </button>
    </div>
</div>

<!-- ── Quick Nav Tabs (Interactive in Browser) ── -->
<ul class="nav nav-pills nav-fill mb-4 p-2 bg-white rounded-3 shadow-sm border no-print" id="flowTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold py-2" id="lifecycle-tab" data-bs-toggle="tab" data-bs-target="#lifecycle" type="button" role="tab">
            <i class="bi bi-arrow-repeat me-1"></i> 1. ISO 8-Step Lifecycle
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold py-2" id="scenarios-tab" data-bs-toggle="tab" data-bs-target="#scenarios" type="button" role="tab">
            <i class="bi bi-play-circle me-1"></i> 2. Real-Time Scenarios
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold py-2" id="roles-tab" data-bs-toggle="tab" data-bs-target="#roles" type="button" role="tab">
            <i class="bi bi-people-fill me-1"></i> 3. Role Responsibilities (RBAC)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold py-2" id="traceability-tab" data-bs-toggle="tab" data-bs-target="#traceability" type="button" role="tab">
            <i class="bi bi-diagram-2 me-1"></i> 4. Data Traceability Map
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold py-2" id="presentation-tab" data-bs-toggle="tab" data-bs-target="#presentation" type="button" role="tab">
            <i class="bi bi-stars me-1"></i> 5. Why Choose ISOFlow?
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold py-2" id="gujarati-tab" data-bs-toggle="tab" data-bs-target="#gujarati" type="button" role="tab">
            <i class="bi bi-translate me-1"></i> 6. ગુજરાતી માર્ગદર્શિકા (Gujarati Guide)
        </button>
    </li>
</ul>

<!-- ── Main Content Container (Exported to PDF with ALL Sections) ── -->
<div id="pdfExportContainer">

    <!-- PDF Cover Header (Visible in PDF / Print) -->
    <div class="p-4 mb-4 bg-light rounded border pdf-cover-header">
        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
            <div>
                <h2 class="fw-bold text-primary mb-1">
                    <i class="bi bi-shield-check me-2"></i> ISOFlow Compliance Management Platform
                </h2>
                <div class="text-muted fw-bold">Enterprise End-to-End Workflow &amp; Customer Presentation Manual</div>
            </div>
            <div class="text-end">
                <span class="badge bg-primary fs-6 px-3 py-2">ISO 27001 &amp; ISO 9001 Certified Ready</span>
                <div class="small text-muted mt-1">Generated: @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")</div>
            </div>
        </div>
        <p class="mb-0 text-dark small">
            This document outlines the complete operational lifecycle of ISOFlow, including tenant onboarding, standard clause selection, risk assessments, security control mappings, routine evidence collection, audit inspection, and continual improvement loops.
        </p>
    </div>

    <div class="tab-content" id="flowTabContent">

        <!-- ════════════════════════════════════════════════════════════════════════════════ -->
        <!-- SECTION 1: 8-STEP ISO COMPLIANCE LIFECYCLE (EXPANDED SIMPLE ENGLISH)             -->
        <!-- ════════════════════════════════════════════════════════════════════════════════ -->
        <div class="tab-pane fade show active" id="lifecycle" role="tabpanel">

            <!-- High-level Visual Progress Bar -->
            <div class="card-enterprise p-4 mb-4 bg-white border">
                <h5 class="pdf-section-title"><i class="bi bi-signpost-split text-primary me-2"></i> 1. The 8 Core Phases of Real-Time ISO Management</h5>
                <p class="text-muted small mb-3">
                    Here is the complete step-by-step breakdown of how ISOFlow guides your organization from initial setup to full ISO audit certification:
                </p>
                <div class="row g-2 text-center mb-1">
                    <div class="col-6 col-md-3 col-lg"><div class="p-2 rounded bg-primary text-white small fw-bold">1. Setup Company</div></div>
                    <div class="col-6 col-md-3 col-lg"><div class="p-2 rounded bg-info text-white small fw-bold">2. Choose Standards</div></div>
                    <div class="col-6 col-md-3 col-lg"><div class="p-2 rounded bg-warning text-dark small fw-bold">3. Assess Risks</div></div>
                    <div class="col-6 col-md-3 col-lg"><div class="p-2 rounded bg-secondary text-white small fw-bold">4. Select Controls</div></div>
                    <div class="col-6 col-md-3 col-lg"><div class="p-2 rounded bg-dark text-white small fw-bold">5. Write Policies</div></div>
                    <div class="col-6 col-md-3 col-lg"><div class="p-2 rounded bg-success text-white small fw-bold">6. Upload Evidence</div></div>
                    <div class="col-6 col-md-3 col-lg"><div class="p-2 rounded bg-danger text-white small fw-bold">7. Run Audits</div></div>
                    <div class="col-6 col-md-3 col-lg"><div class="p-2 rounded text-white small fw-bold" style="background:#7c3aed;">8. Fix &amp; Review</div></div>
                </div>
            </div>

            <!-- Detailed 8 Phase Cards -->
            <div class="row g-4">

                <!-- Step 1: Company Setup -->
                <div class="col-md-6 col-lg-6">
                    <div class="card-enterprise p-4 h-100 border-top border-primary border-4 shadow-sm d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-primary px-2 py-1 step-badge-pill">Phase 1</span>
                                <i class="bi bi-building fs-3 text-primary"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">1. Company &amp; User Setup (Multi-Tenancy)</h5>
                            <p class="text-muted small mb-3">
                                <strong>What happens here:</strong> Create your dedicated company workspace, register branches/departments, and set up your team members with secure logins.
                            </p>

                            <div class="mb-3">
                                <div class="fw-bold text-dark small mb-1"><i class="bi bi-list-check text-primary me-1"></i> Key Activities:</div>
                                <ul class="step-feature-list">
                                    <li>Register organization name, business domain, and headquarters.</li>
                                    <li>Assign user roles: <strong>SuperAdmin</strong> (global), <strong>Admin</strong> (company lead), <strong>User</strong> (staff), and <strong>Auditor</strong> (guest).</li>
                                    <li>Complete data isolation ensuring each company’s data remains 100% private and protected.</li>
                                </ul>
                            </div>

                            <div class="example-box">
                                <strong><i class="bi bi-lightbulb text-warning me-1"></i> Real Example:</strong> An Admin creates "Apex Global Financial Ltd", invites 15 employees, and gives Auditor access to an external assessor.
                            </div>

                            <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded small">
                                <span><strong>Role:</strong> SuperAdmin / Admin</span>
                                <span><strong class="text-success"><i class="bi bi-check2-circle me-1"></i> Output:</strong> Active Workspace</span>
                            </div>
                        </div>
                        <div class="pt-3 border-top mt-3 no-print">
                            <a asp-controller="Organizations" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">
                                Open Organizations <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Step 2: Choose Standards -->
                <div class="col-md-6 col-lg-6">
                    <div class="card-enterprise p-4 h-100 border-top border-info border-4 shadow-sm d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-info text-dark px-2 py-1 step-badge-pill">Phase 2</span>
                                <i class="bi bi-journal-bookmark fs-3 text-info"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">2. Choose Standards &amp; Clauses</h5>
                            <p class="text-muted small mb-3">
                                <strong>What happens here:</strong> Select which ISO frameworks apply to your business (e.g. ISO 27001 for Information Security, ISO 9001 for Quality Management).
                            </p>

                            <div class="mb-3">
                                <div class="fw-bold text-dark small mb-1"><i class="bi bi-list-check text-info me-1"></i> Key Activities:</div>
                                <ul class="step-feature-list">
                                    <li>Adopt pre-loaded standards like <strong>ISO/IEC 27001:2022</strong> or define custom internal frameworks.</li>
                                    <li>Break standard clauses into clear, actionable requirements (Clause 4 to Clause 10).</li>
                                    <li>Set organizational target compliance percentages (e.g., achieve &gt; 90% by Q4).</li>
                                </ul>
                            </div>

                            <div class="example-box" style="border-left-color: #0ea5e9;">
                                <strong><i class="bi bi-lightbulb text-warning me-1"></i> Real Example:</strong> The Compliance Manager selects "ISO-27001-2022", automatically loading all 93 Annex A security clauses into the company register.
                            </div>

                            <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded small">
                                <span><strong>Role:</strong> Compliance Lead / CISO</span>
                                <span><strong class="text-success"><i class="bi bi-check2-circle me-1"></i> Output:</strong> Requirement Checklist</span>
                            </div>
                        </div>
                        <div class="pt-3 border-top mt-3 no-print">
                            <a asp-controller="Standards" asp-action="Index" class="btn btn-sm btn-outline-info text-dark w-100">
                                Open Standards <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Step 3: Assess Risks -->
                <div class="col-md-6 col-lg-6">
                    <div class="card-enterprise p-4 h-100 border-top border-warning border-4 shadow-sm d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-warning text-dark px-2 py-1 step-badge-pill">Phase 3</span>
                                <i class="bi bi-exclamation-triangle fs-3 text-warning"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">3. Risk Assessment &amp; 5x5 Heatmap</h5>
                            <p class="text-muted small mb-3">
                                <strong>What happens here:</strong> Identify potential threats to company data and assets, score their severity, and decide how to protect against them.
                            </p>

                            <div class="mb-3">
                                <div class="fw-bold text-dark small mb-1"><i class="bi bi-list-check text-warning me-1"></i> Key Activities:</div>
                                <ul class="step-feature-list">
                                    <li>Catalog business assets (servers, customer databases, laptops, office premises).</li>
                                    <li>Score threats by <strong>Likelihood (1-5) &times; Impact (1-5)</strong> to calculate Inherent Risk scores.</li>
                                    <li>Select Risk Treatment options: <strong>Mitigate</strong> (apply controls), <strong>Accept</strong>, <strong>Transfer</strong> (insurance), or <strong>Avoid</strong>.</li>
                                </ul>
                            </div>

                            <div class="example-box" style="border-left-color: #f59e0b;">
                                <strong><i class="bi bi-lightbulb text-warning me-1"></i> Real Example:</strong> Threat "Unencrypted laptop hard drive" scores 4 &times; 4 = 16 (High Risk). Treatment: Enforce BitLocker encryption to reduce residual risk to 4 (Low).
                            </div>

                            <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded small">
                                <span><strong>Role:</strong> Risk Officer / IT Lead</span>
                                <span><strong class="text-success"><i class="bi bi-check2-circle me-1"></i> Output:</strong> 5x5 Risk Heatmap</span>
                            </div>
                        </div>
                        <div class="pt-3 border-top mt-3 no-print">
                            <a asp-controller="Risks" asp-action="Index" class="btn btn-sm btn-outline-warning text-dark w-100">
                                Open Risk Register <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Step 4: Controls & SoA -->
                <div class="col-md-6 col-lg-6">
                    <div class="card-enterprise p-4 h-100 border-top border-secondary border-4 shadow-sm d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-secondary px-2 py-1 step-badge-pill">Phase 4</span>
                                <i class="bi bi-shield-lock fs-3 text-secondary"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">4. Select Controls &amp; Statement of Applicability (SoA)</h5>
                            <p class="text-muted small mb-3">
                                <strong>What happens here:</strong> Map mandatory security safeguards to your risks and generate the official Statement of Applicability (SoA) document.
                            </p>

                            <div class="mb-3">
                                <div class="fw-bold text-dark small mb-1"><i class="bi bi-list-check text-secondary me-1"></i> Key Activities:</div>
                                <ul class="step-feature-list">
                                    <li>Review all <strong>93 Annex A Controls</strong> (Organizational, People, Physical, Technological).</li>
                                    <li>Mark each control as <strong>Applicable</strong> or <strong>Not Applicable</strong> with written justification.</li>
                                    <li>Link controls directly to identified risks and ISO clauses for 100% audit traceability.</li>
                                </ul>
                            </div>

                            <div class="example-box" style="border-left-color: #64748b;">
                                <strong><i class="bi bi-lightbulb text-warning me-1"></i> Real Example:</strong> Marking Control <code>A.5.18 (Access Rights)</code> as Applicable because all staff access customer databases, requiring MFA and quarterly access reviews.
                            </div>

                            <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded small">
                                <span><strong>Role:</strong> InfoSec Lead / CISO</span>
                                <span><strong class="text-success"><i class="bi bi-check2-circle me-1"></i> Output:</strong> Official SoA Document</span>
                            </div>
                        </div>
                        <div class="pt-3 border-top mt-3 no-print">
                            <a asp-controller="Controls" asp-action="Soa" class="btn btn-sm btn-outline-secondary w-100">
                                Open SoA Matrix <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Step 5: Policies & SOPs -->
                <div class="col-md-6 col-lg-6">
                    <div class="card-enterprise p-4 h-100 border-top border-dark border-4 shadow-sm d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-dark px-2 py-1 step-badge-pill">Phase 5</span>
                                <i class="bi bi-file-earmark-text fs-3 text-dark"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">5. Policies &amp; Standard Operating Procedures (SOPs)</h5>
                            <p class="text-muted small mb-3">
                                <strong>What happens here:</strong> Create, version-control, and store formal security policies, employee guidelines, and visual business process workflows.
                            </p>

                            <div class="mb-3">
                                <div class="fw-bold text-dark small mb-1"><i class="bi bi-list-check text-dark me-1"></i> Key Activities:</div>
                                <ul class="step-feature-list">
                                    <li>Publish governance documents: Password Policy, Access Control Policy, Incident Response Plan.</li>
                                    <li>Track version numbers (e.g. v1.0, v2.1), review cycles, and management approval dates.</li>
                                    <li>Build visual SOP flowcharts (e.g. Joiner-Mover-Leaver process) so staff know exact steps.</li>
                                </ul>
                            </div>

                            <div class="example-box" style="border-left-color: #1e293b;">
                                <strong><i class="bi bi-lightbulb text-warning me-1"></i> Real Example:</strong> Uploading the "Information Security Policy v2.0", setting annual review reminder, and mapping it to Control A.5.1.
                            </div>

                            <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded small">
                                <span><strong>Role:</strong> Policy Owners / HR / Legal</span>
                                <span><strong class="text-success"><i class="bi bi-check2-circle me-1"></i> Output:</strong> Approved Policy Vault</span>
                            </div>
                        </div>
                        <div class="pt-3 border-top mt-3 no-print">
                            <a asp-controller="Documents" asp-action="Policies" class="btn btn-sm btn-outline-dark w-100">
                                Open Policies <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Step 6: Tasks & Evidence Vault -->
                <div class="col-md-6 col-lg-6">
                    <div class="card-enterprise p-4 h-100 border-top border-success border-4 shadow-sm d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-success px-2 py-1 step-badge-pill">Phase 6</span>
                                <i class="bi bi-check2-square fs-3 text-success"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">6. Daily Tasks, Kanban &amp; Evidence Vault</h5>
                            <p class="text-muted small mb-3">
                                <strong>What happens here:</strong> Staff execute routine operational compliance checks and upload files as indisputable proof for the auditor.
                            </p>

                            <div class="mb-3">
                                <div class="fw-bold text-dark small mb-1"><i class="bi bi-list-check text-success me-1"></i> Key Activities:</div>
                                <ul class="step-feature-list">
                                    <li>Manage recurring tasks (e.g. Monthly Backup Test, Quarterly Access Review, Annual Pen-Test).</li>
                                    <li>Use interactive <strong>Kanban Board</strong> and <strong>Compliance Calendar</strong> with due dates.</li>
                                    <li>Upload proof files (PDF reports, server logs, screenshots) directly into the secure <strong>Evidence Vault</strong>.</li>
                                </ul>
                            </div>

                            <div class="example-box" style="border-left-color: #10b981;">
                                <strong><i class="bi bi-lightbulb text-warning me-1"></i> Real Example:</strong> IT Engineer completes "Q3 Database Backup Restoration Test", uploads signed PDF test log, moving task to Completed. Live score jumps +5%!
                            </div>

                            <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded small">
                                <span><strong>Role:</strong> Everyday Staff &amp; Engineers</span>
                                <span><strong class="text-success"><i class="bi bi-check2-circle me-1"></i> Output:</strong> Objective Proof Vault</span>
                            </div>
                        </div>
                        <div class="pt-3 border-top mt-3 no-print">
                            <a asp-controller="Evidence" asp-action="Index" class="btn btn-sm btn-outline-success w-100">
                                Open Evidence Vault <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Step 7: Audits & Findings -->
                <div class="col-md-6 col-lg-6">
                    <div class="card-enterprise p-4 h-100 border-top border-danger border-4 shadow-sm d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-danger px-2 py-1 step-badge-pill">Phase 7</span>
                                <i class="bi bi-clipboard-check fs-3 text-danger"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">7. Internal &amp; External Audits &amp; Findings</h5>
                            <p class="text-muted small mb-3">
                                <strong>What happens here:</strong> Conduct internal audit inspections or host external certification assessors who verify live evidence against controls.
                            </p>

                            <div class="mb-3">
                                <div class="fw-bold text-dark small mb-1"><i class="bi bi-list-check text-danger me-1"></i> Key Activities:</div>
                                <ul class="step-feature-list">
                                    <li>Schedule audit programs (e.g. "2026 ISO 27001 Stage 2 Certification Audit").</li>
                                    <li>Auditor reviews live evidence attachments online without requesting paper files.</li>
