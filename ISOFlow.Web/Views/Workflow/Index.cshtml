<!-- ── JavaScript for 1-Click High-Quality PDF Generation ── -->
<script>
    function generatePdfDocument() {
        const btn = document.getElementById('btnDownloadPdf');
        const btnText = document.getElementById('pdfBtnText');
        
        // Show loading state
        btn.disabled = true;
        btnText.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Generating PDF...';

        // Prepare elements by making all tab panes visible temporarily for rendering
        const tabPanes = document.querySelectorAll('.tab-pane');
        tabPanes.forEach(pane => {
            pane.classList.add('show', 'active');
            pane.style.display = 'block';
        });

        const coverHeader = document.querySelector('.pdf-cover-header');
        if (coverHeader) {
            coverHeader.style.display = 'block';
        }

        const element = document.getElementById('pdfExportContainer');

        const opt = {
            margin:       [10, 10, 10, 10],
            filename:     'ISOFlow-Complete-Workflow-Guide.pdf',
            image:        { type: 'jpeg', quality: 0.98 },
            html2canvas:  { scale: 2, useCORS: true, logging: false },
            jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' },
            pagebreak:    { mode: ['avoid-all', 'css', 'legacy'] }
        };

        html2pdf().set(opt).from(element).save().then(() => {
            // Restore Tab visibility to currently active tab
            tabPanes.forEach((pane, index) => {
                if (index !== 0) {
                    pane.classList.remove('show', 'active');
                    pane.style.display = '';
                }
            });
            if (coverHeader) {
                coverHeader.style.display = '';
            }
            btn.disabled = false;
            btnText.innerHTML = 'Download Complete PDF';
        }).catch(err => {
            console.error('PDF Generation Error:', err);
            btn.disabled = false;
            btnText.innerHTML = 'Download Complete PDF';
            alert('PDF generation completed. You can also use the "Print / Save as PDF" button.');
        });
    }
</script>
