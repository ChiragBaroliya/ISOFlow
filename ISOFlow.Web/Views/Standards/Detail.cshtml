@model List<ISOFlow.Domain.Entities.Requirement>
@{
    var std = ViewBag.Standard as ISOFlow.Domain.Entities.Standard;
    var stdId = std?.Id ?? "ISO-27001-2022";
    ViewData["Title"] = std?.Name ?? "Standard Detail";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-primary fs-6">@(std?.Code ?? "ISO 27001:2022")</span>
            <span class="badge bg-success">@(std?.CompliancePercentage ?? 82.5)% Compliant</span>
            <span class="badge bg-light text-dark border">@Model.Count Requirements</span>
        </div>
        <h4 class="fw-bold mb-0">@(std?.Name ?? "Information Security Management System")</h4>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addRequirementModal">
            <i class="bi bi-plus-circle me-1"></i> Add Requirement
        </button>
        <a asp-controller="Standards" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back to Standards</a>
    </div>
</div>

<!-- ── Advance Search & Filter Toolbar ── -->
<div class="card-enterprise p-3 mb-4 bg-light border">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="reqSearchInput" class="form-control border-start-0" placeholder="Search by Clause (e.g. A.5.18), Title, Description, Control..." />
            </div>
        </div>
        <div class="col-6 col-md-4">
            <select id="reqCategoryFilter" class="form-select form-select-sm">
                <option value="all">All Requirement Categories</option>
                <option value="Organizational">Organizational Controls</option>
                <option value="Technological">Technological Controls</option>
                <option value="Physical">Physical Controls</option>
                <option value="People">People Controls</option>
                <option value="Management">Management Clauses</option>
            </select>
        </div>
        <div class="col-6 col-md-3 d-flex justify-content-end">
            <button type="button" id="reqResetBtn" class="btn btn-sm btn-outline-secondary w-100" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
            </button>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top small text-muted">
        <span id="reqResultsCounter">Showing <strong>@Model.Count</strong> of <strong>@Model.Count</strong> records</span>
        <span class="badge bg-primary-subtle text-primary"><i class="bi bi-funnel me-1"></i> Live Filter</span>
    </div>
</div>

<div class="card-enterprise p-4">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <h6 class="fw-bold mb-0"><i class="bi bi-list-nested text-primary me-2"></i> Standard Requirements &amp; Control Mapping</h6>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Clause</th>
                    <th>Requirement Title</th>
                    <th>Category</th>
                    <th>Compliance</th>
                    <th>Linked Controls</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="requirementsTableBody">
                @foreach (var req in Model)
                {
                    var primaryCtrlId = req.RelatedControlIds.FirstOrDefault() ?? "CTRL-001";
                    <tr id="@req.Clause.Replace(".", "-")" class="@(req.Clause == "A.5.18" ? "table-primary" : "")">
                        <td class="fw-bold text-primary">@req.Clause</td>
                        <td>
                            <div class="fw-semibold">@req.Title</div>
                            <div class="text-muted small">@req.Description</div>
                        </td>
                        <td><span class="badge bg-light text-dark border">@req.Category</span></td>
                        <td>
                            <div class="progress" style="height: 6px; width: 80px;">
                                <div class="progress-bar bg-success" style="width: @(req.CompliancePercentage)%"></div>
                            </div>
                            <span class="small fw-semibold">@req.CompliancePercentage%</span>
                        </td>
                        <td>
                            @foreach (var ctrlId in req.RelatedControlIds)
                            {
                                <a asp-controller="Controls" asp-action="Detail" asp-route-id="@ctrlId" class="badge bg-info text-white text-decoration-none me-1"><i class="bi bi-shield-lock"></i> @ctrlId</a>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-controller="Controls" asp-action="Detail" asp-route-id="@primaryCtrlId" class="btn btn-outline-primary" title="Trace Control">
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                                <button type="button" class="btn btn-outline-secondary" title="Edit Requirement"
                                        onclick="openEditRequirementModal('@req.Id', '@req.StandardId', '@Html.Raw(Html.Encode(req.Clause))', '@Html.Raw(Html.Encode(req.Title))', '@Html.Raw(Html.Encode(req.Category))', '@req.CompliancePercentage', '@string.Join(", ", req.RelatedControlIds)', '@Html.Raw(Html.Encode(req.Description))')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger" title="Delete Requirement"
                                        onclick="openDeleteRequirementModal('@req.Id', '@Html.Raw(Html.Encode(req.Clause))', '@Html.Raw(Html.Encode(req.Title))')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Empty State -->
    <div id="reqEmptyState" class="text-center py-5" style="display: none;">
        <i class="bi bi-search text-muted" style="font-size: 2.5rem;"></i>
        <h6 class="fw-bold mt-2 mb-1">No matching requirements found</h6>
        <p class="text-muted small mb-0">Try adjusting your keyword search or category filter.</p>
    </div>
</div>

<!-- Modal: Add Requirement -->
<div class="modal fade" id="addRequirementModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2"></i> Add Standard Requirement / Clause</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Standards" asp-action="CreateRequirement" method="post">
                <input type="hidden" name="StandardId" value="@stdId" />
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Clause / Code <span class="text-danger">*</span></label>
                            <input type="text" name="Clause" class="form-control form-control-sm" placeholder="e.g. A.8.20" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Requirement Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" class="form-control form-control-sm" placeholder="e.g. Network Security & Segmentation" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Category</label>
                            <select name="Category" class="form-select form-select-sm">
                                <option value="Organizational Controls">Organizational Controls</option>
                                <option value="Technological Controls" selected>Technological Controls</option>
                                <option value="Physical Controls">Physical Controls</option>
                                <option value="People Controls">People Controls</option>
                                <option value="Management Clauses">Management Clauses</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Compliance %</label>
                            <input type="number" step="0.1" name="CompliancePercentage" class="form-control form-control-sm" value="100.0" min="0" max="100" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Linked Control IDs (comma-separated)</label>
                            <input type="text" name="linkedControlsRaw" class="form-control form-control-sm" placeholder="e.g. CTRL-001, CTRL-002" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Requirement Description / Mandate</label>
                            <textarea name="Description" class="form-control form-control-sm" rows="3" placeholder="Specify mandatory compliance expectations and criteria..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check2-circle me-1"></i> Save Requirement</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Requirement -->
<div class="modal fade" id="editRequirementModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i> Edit Standard Requirement</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Standards" asp-action="EditRequirement" method="post">
                <input type="hidden" name="Id" id="editReqId" />
                <input type="hidden" name="StandardId" id="editReqStdId" />
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Clause / Code <span class="text-danger">*</span></label>
                            <input type="text" name="Clause" id="editReqClause" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Requirement Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" id="editReqTitle" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Category</label>
                            <select name="Category" id="editReqCategory" class="form-select form-select-sm">
                                <option value="Organizational Controls">Organizational Controls</option>
                                <option value="Technological Controls">Technological Controls</option>
                                <option value="Physical Controls">Physical Controls</option>
                                <option value="People Controls">People Controls</option>
                                <option value="Management Clauses">Management Clauses</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Compliance %</label>
                            <input type="number" step="0.1" name="CompliancePercentage" id="editReqCompliance" class="form-control form-control-sm" min="0" max="100" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Linked Control IDs</label>
                            <input type="text" name="linkedControlsRaw" id="editReqControls" class="form-control form-control-sm" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Description</label>
                            <textarea name="Description" id="editReqDesc" class="form-control form-control-sm" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark btn-sm"><i class="bi bi-check2-circle me-1"></i> Update Requirement</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Delete Requirement -->
<div class="modal fade" id="deleteRequirementModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Requirement</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Standards" asp-action="DeleteRequirement" method="post">
                <input type="hidden" name="id" id="deleteReqId" />
                <input type="hidden" name="standardId" value="@stdId" />
                <div class="modal-body p-4">
                    <p class="mb-1">Are you sure you want to delete requirement clause <strong id="deleteReqClause"></strong> (<span id="deleteReqTitle"></span>)?</p>
                    <p class="text-muted small mb-0">This requirement and its control mapping will be removed from this standard.</p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash me-1"></i> Confirm Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        new AdvanceSearch({
            containerId: 'requirementsTableBody',
            searchInputId: 'reqSearchInput',
            counterId: 'reqResultsCounter',
            resetBtnId: 'reqResetBtn',
            emptyStateId: 'reqEmptyState',
            filterSelects: [
                { id: 'reqCategoryFilter', colIndex: 2 }
            ]
        });
    });

    function openEditRequirementModal(id, stdId, clause, title, category, compliance, controls, desc) {
        document.getElementById('editReqId').value = id;
        document.getElementById('editReqStdId').value = stdId;
        document.getElementById('editReqClause').value = clause;
        document.getElementById('editReqTitle').value = title;
        document.getElementById('editReqCategory').value = category;
        document.getElementById('editReqCompliance').value = compliance;
        document.getElementById('editReqControls').value = controls;
        document.getElementById('editReqDesc').value = desc;
        new bootstrap.Modal(document.getElementById('editRequirementModal')).show();
    }

    function openDeleteRequirementModal(id, clause, title) {
        document.getElementById('deleteReqId').value = id;
        document.getElementById('deleteReqClause').textContent = clause;
        document.getElementById('deleteReqTitle').textContent = title;
        new bootstrap.Modal(document.getElementById('deleteRequirementModal')).show();
    }
</script>
