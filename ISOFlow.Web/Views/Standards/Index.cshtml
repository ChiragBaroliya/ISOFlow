@model List<ISOFlow.Domain.Entities.Standard>
@{
    ViewData["Title"] = "ISO Standards Register";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-journal-bookmark text-primary me-2"></i> ISO Compliance Standards</h4>
        <p class="text-muted small mb-0">Active management standards and compliance frameworks.</p>
    </div>
    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createStandardModal">
        <i class="bi bi-plus-lg me-1"></i> Add Custom Standard
    </button>
</div>

<!-- ── Advance Search & Filter Toolbar ── -->
<div class="card-enterprise p-3 mb-4 bg-light border">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-6">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="stdSearchInput" class="form-control border-start-0" placeholder="Search by Standard Code, Name, Description..." />
            </div>
        </div>
        <div class="col-6 col-md-4">
            <select id="stdTypeFilter" class="form-select form-select-sm">
                <option value="all">All Standards &amp; Frameworks</option>
                <option value="Protected">Official Protected Standards</option>
                <option value="Custom">Custom Frameworks</option>
            </select>
        </div>
        <div class="col-6 col-md-2 d-flex justify-content-end">
            <button type="button" id="stdResetBtn" class="btn btn-sm btn-outline-secondary w-100" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
            </button>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top small text-muted">
        <span id="stdResultsCounter">Showing <strong>@Model.Count</strong> of <strong>@Model.Count</strong> records</span>
        <span class="badge bg-primary-subtle text-primary"><i class="bi bi-funnel me-1"></i> Live Filter</span>
    </div>
</div>

<div class="row g-4" id="standardsGrid">
    @foreach (var std in Model)
    {
        <div class="col-12 col-md-4 std-card-item">
            <div class="card-enterprise p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge bg-primary-subtle text-primary fw-bold">@std.Code</span>
                        @if (std.IsPreseeded)
                        {
                            <span class="badge bg-warning-subtle text-dark border border-warning" title="Protected Official Standard">
                                <i class="bi bi-shield-lock-fill text-warning me-1"></i> Protected Standard
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-info-subtle text-info">Custom Framework</span>
                        }
                    </div>
                    <h5 class="fw-bold text-dark mb-1">@std.Name</h5>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-success-subtle text-success">@std.CompliancePercentage% Compliant</span>
                        <span class="text-muted small">Revision: @std.Revision</span>
                    </div>
                    <p class="text-muted small mb-0">@std.Description</p>
                </div>
                <div class="pt-3 border-top d-flex align-items-center justify-content-between mt-3 gap-2">
                    <div class="btn-group btn-group-sm">
                        <a asp-controller="Standards" asp-action="Detail" asp-route-id="@std.Id" class="btn btn-outline-primary fw-semibold">
                            <i class="bi bi-list-check me-1"></i> Requirements (@std.RequirementCount)
                        </a>
                        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editStandardModal-@std.Id" title="Edit Standard">
                            <i class="bi bi-pencil"></i>
                        </button>
                    </div>

                    @if (!std.IsPreseeded)
                    {
                        <form asp-controller="Standards" asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete custom standard @std.Code?');">
                            <input type="hidden" name="id" value="@std.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete Custom Standard">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="badge text-muted" title="Pre-seeded ISO standard protected from deletion"><i class="bi bi-lock-fill"></i></span>
                    }
                </div>
            </div>
        </div>

        <!-- Edit Standard Modal -->
        <div class="modal fade" id="editStandardModal-@std.Id" tabindex="-1" aria-labelledby="editStandardModalLabel-@std.Id" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-controller="Standards" asp-action="Edit" method="post">
                        <div class="modal-header">
                            <h5 class="modal-title fw-bold" id="editStandardModalLabel-@std.Id">
                                <i class="bi bi-pencil-square text-primary me-2"></i> Edit Standard (@std.Code)
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="Id" value="@std.Id" />
                            <input type="hidden" name="IsPreseeded" value="@std.IsPreseeded.ToString().ToLower()" />

                            @if (std.IsPreseeded)
                            {
                                <div class="alert alert-info py-2 small mb-3">
                                    <i class="bi bi-info-circle me-1"></i> Official pre-seeded standard. Core code is protected; compliance percentage, description, and revision can be customized.
                                </div>
                                <input type="hidden" name="Code" value="@std.Code" />
                            }
                            else
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Standard Code</label>
                                    <input type="text" class="form-control form-control-sm" name="Code" value="@std.Code" required />
                                </div>
                            }

                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Standard Name</label>
                                <input type="text" class="form-control form-control-sm" name="Name" value="@std.Name" required />
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label fw-semibold small">Revision Year</label>
                                    <input type="text" class="form-control form-control-sm" name="Revision" value="@std.Revision" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-semibold small">Compliance Target (%)</label>
                                    <input type="number" step="0.1" class="form-control form-control-sm" name="CompliancePercentage" value="@std.CompliancePercentage" required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Description</label>
                                <textarea class="form-control form-control-sm" name="Description" rows="3">@std.Description</textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-save me-1"></i> Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<!-- Empty State -->
<div id="stdEmptyState" class="text-center py-5" style="display: none;">
    <i class="bi bi-search text-muted" style="font-size: 2.5rem;"></i>
    <h6 class="fw-bold mt-2 mb-1">No matching compliance standards found</h6>
    <p class="text-muted small mb-0">Try adjusting your keyword search or filter criteria.</p>
</div>

<!-- Create Standard Modal -->
<div class="modal fade" id="createStandardModal" tabindex="-1" aria-labelledby="createStandardModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Standards" asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="createStandardModalLabel">
                        <i class="bi bi-plus-circle text-primary me-2"></i> Add Custom Standard / Framework
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Standard Code / Identifier</label>
                        <input type="text" class="form-control form-control-sm" name="Code" placeholder="e.g. SOC-2-TYPE-II or NIST-CSF-v2" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Standard Title</label>
                        <input type="text" class="form-control form-control-sm" name="Name" placeholder="e.g. SOC 2 Type II Security & Trust Criteria" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Revision / Version</label>
                            <input type="text" class="form-control form-control-sm" name="Revision" placeholder="2026" value="2026" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Initial Compliance Target (%)</label>
                            <input type="number" step="0.1" class="form-control form-control-sm" name="CompliancePercentage" value="100.0" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Requirement Count</label>
                        <input type="number" class="form-control form-control-sm" name="RequirementCount" value="25" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Description</label>
                        <textarea class="form-control form-control-sm" name="Description" rows="3" placeholder="Enter standard objectives and scope..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg me-1"></i> Add Standard</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        new AdvanceSearch({
            containerId: 'standardsGrid',
            searchInputId: 'stdSearchInput',
            counterId: 'stdResultsCounter',
            resetBtnId: 'stdResetBtn',
            emptyStateId: 'stdEmptyState',
            itemSelector: '.std-card-item',
            filterSelects: [
                { id: 'stdTypeFilter' }
            ]
        });
    });
</script>
