@using ISOFlow.Domain.Enums
@model List<ISOFlow.Domain.Entities.Risk>
@{
    ViewData["Title"] = "Risk Register";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-exclamation-triangle text-warning me-2"></i> Organizational Risk Register</h4>
        <p class="text-muted small mb-0">Information security risk assessment, scoring, and mitigation treatment tracking.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Risks" asp-action="Matrix" class="btn btn-outline-danger btn-sm"><i class="bi bi-grid-3x3-gap me-1"></i> View 5x5 Heatmap Matrix</a>
        <button type="button" class="btn btn-warning btn-sm text-dark fw-bold" data-bs-toggle="modal" data-bs-target="#addRiskModal">
            <i class="bi bi-plus-circle me-1"></i> Log Risk
        </button>
    </div>
</div>

<!-- ── Advance Search & Filter Toolbar ── -->
<div class="card-enterprise p-3 mb-4 bg-light border">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-4">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="riskSearchInput" class="form-control border-start-0" placeholder="Search by Risk ID, title, asset, owner..." />
            </div>
        </div>
        <div class="col-6 col-md-3">
            <select id="riskLevelFilter" class="form-select form-select-sm">
                <option value="all">All Risk Levels</option>
                <option value="Critical">Critical</option>
                <option value="High">High</option>
                <option value="Medium">Medium</option>
                <option value="Low">Low</option>
            </select>
        </div>
        <div class="col-6 col-md-3">
            <select id="riskStatusFilter" class="form-select form-select-sm">
                <option value="all">All Statuses</option>
                <option value="Open">Open</option>
                <option value="Mitigated">Mitigated</option>
                <option value="Closed">Closed</option>
            </select>
        </div>
        <div class="col-12 col-md-2 d-flex justify-content-end">
            <button type="button" id="riskResetBtn" class="btn btn-sm btn-outline-secondary w-100" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
            </button>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top small text-muted">
        <span id="riskResultsCounter">Showing <strong>@Model.Count</strong> of <strong>@Model.Count</strong> records</span>
        <span class="badge bg-warning-subtle text-dark"><i class="bi bi-funnel me-1"></i> Live Filter</span>
    </div>
</div>

<div class="card-enterprise p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Risk ID</th>
                    <th>Risk Title</th>
                    <th>Asset</th>
                    <th>Owner</th>
                    <th>Likelihood</th>
                    <th>Impact</th>
                    <th>Score</th>
                    <th>Level</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="risksTableBody">
                @foreach (var risk in Model)
                {
                    <tr class="@(risk.Id == "RISK-001" ? "table-danger" : "")">
                        <td class="fw-bold text-danger">@risk.Code</td>
                        <td>
                            <a asp-controller="Risks" asp-action="Detail" asp-route-id="@risk.Id" class="fw-semibold text-dark text-decoration-none">@risk.Title</a>
                            <div class="text-muted small">@risk.Description</div>
                        </td>
                        <td><span class="badge bg-light text-dark border">@risk.Asset</span></td>
                        <td class="small fw-medium">@risk.Owner</td>
                        <td><span class="badge bg-light text-dark border">@((int)risk.Likelihood) - @risk.Likelihood</span></td>
                        <td><span class="badge bg-light text-dark border">@((int)risk.Impact) - @risk.Impact</span></td>
                        <td><span class="badge bg-dark fs-6">@risk.Score</span></td>
                        <td>
                            @{
                                var levelBadge = risk.Level switch {
                                    RiskLevel.Critical => "bg-danger text-white",
                                    RiskLevel.High => "bg-warning text-dark",
                                    RiskLevel.Medium => "bg-info text-dark",
                                    _ => "bg-success text-white"
                                };
                            }
                            <span class="badge @levelBadge">@risk.Level</span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@risk.Status</span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-controller="Risks" asp-action="Detail" asp-route-id="@risk.Id" class="btn btn-outline-primary" title="Trace Risk & Treatments">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <button type="button" class="btn btn-outline-secondary" title="Edit Risk"
                                        onclick="openEditRiskModal('@risk.Id', '@risk.Code', '@Html.Raw(Html.Encode(risk.Title))', '@Html.Raw(Html.Encode(risk.Description))', '@Html.Raw(Html.Encode(risk.Asset))', '@Html.Raw(Html.Encode(risk.Department))', '@Html.Raw(Html.Encode(risk.Owner))', '@((int)risk.Likelihood)', '@((int)risk.Impact)', '@risk.Status', '@risk.ControlId')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger" title="Delete Risk"
                                        onclick="openDeleteRiskModal('@risk.Id', '@risk.Code', '@Html.Raw(Html.Encode(risk.Title))')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Empty State -->
    <div id="riskEmptyState" class="text-center py-5" style="display: none;">
        <i class="bi bi-search text-muted" style="font-size: 2.5rem;"></i>
        <h6 class="fw-bold mt-2 mb-1">No matching organizational risks found</h6>
        <p class="text-muted small mb-0">Try adjusting your search criteria or level filter.</p>
    </div>
</div>

<!-- Modal: Add Risk -->
<div class="modal fade" id="addRiskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold"><i class="bi bi-shield-exclamation me-2"></i> Log New Risk &amp; Assessment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Risks" asp-action="Create" method="post">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Risk Code <span class="text-danger">*</span></label>
                            <input type="text" name="Code" class="form-control form-control-sm" placeholder="e.g. RISK-004" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Risk Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" class="form-control form-control-sm" placeholder="e.g. Cloud Misconfiguration Vulnerability" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Impacted Asset</label>
                            <input type="text" name="Asset" class="form-control form-control-sm" placeholder="e.g. AWS Production Workloads" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Risk Owner</label>
                            <input type="text" name="Owner" class="form-control form-control-sm" placeholder="e.g. David Chen (IT Manager)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Department</label>
                            <input type="text" name="Department" class="form-control form-control-sm" placeholder="e.g. Cloud Infrastructure" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Likelihood (1–5)</label>
                            <select name="Likelihood" id="addRiskLikelihood" class="form-select form-select-sm" onchange="calcAddScore()">
                                <option value="1">1 - Rare</option>
                                <option value="2">2 - Unlikely</option>
                                <option value="3">3 - Possible</option>
                                <option value="4" selected>4 - Likely</option>
                                <option value="5">5 - Almost Certain</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Impact (1–5)</label>
                            <select name="Impact" id="addRiskImpact" class="form-select form-select-sm" onchange="calcAddScore()">
                                <option value="1">1 - Negligible</option>
                                <option value="2">2 - Minor</option>
                                <option value="3">3 - Moderate</option>
                                <option value="4">4 - Major</option>
                                <option value="5" selected>5 - Critical</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <div class="p-2 bg-light rounded border d-flex justify-content-between align-items-center">
                                <span class="small fw-bold text-muted">Calculated Inherent Risk Rating:</span>
                                <span class="badge bg-danger fs-6" id="addRiskScore">Score: 20 (Critical)</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Risk Description &amp; Threat Scenario</label>
                            <textarea name="Description" class="form-control form-control-sm" rows="2" placeholder="Describe the vulnerability, threat agent, and business impact..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Treatment Strategy</label>
                            <select name="treatmentType" class="form-select form-select-sm">
                                <option value="Mitigate" selected>Mitigate (Implement Control)</option>
                                <option value="Accept">Accept Risk</option>
                                <option value="Avoid">Avoid / Terminate Activity</option>
                                <option value="Transfer">Transfer / Cyber Insurance</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Linked Control ID</label>
                            <input type="text" name="treatmentControlId" class="form-control form-control-sm" placeholder="e.g. CTRL-001" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Treatment Action Plan</label>
                            <input type="text" name="treatmentAction" class="form-control form-control-sm" placeholder="e.g. Deploy automated CSPM posture management to continuously audit S3 buckets." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning btn-sm text-dark fw-bold"><i class="bi bi-check2-circle me-1"></i> Save Risk</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Risk -->
<div class="modal fade" id="editRiskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i> Edit Risk Assessment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Risks" asp-action="Edit" method="post">
                <input type="hidden" name="Id" id="editRiskId" />
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Risk Code</label>
                            <input type="text" name="Code" id="editRiskCode" class="form-control form-control-sm" readonly />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Risk Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" id="editRiskTitle" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Impacted Asset</label>
                            <input type="text" name="Asset" id="editRiskAsset" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Risk Owner</label>
                            <input type="text" name="Owner" id="editRiskOwner" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Department</label>
                            <input type="text" name="Department" id="editRiskDept" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Likelihood</label>
                            <select name="Likelihood" id="editRiskLikelihood" class="form-select form-select-sm">
                                <option value="1">1 - Rare</option>
                                <option value="2">2 - Unlikely</option>
                                <option value="3">3 - Possible</option>
                                <option value="4">4 - Likely</option>
                                <option value="5">5 - Almost Certain</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Impact</label>
                            <select name="Impact" id="editRiskImpact" class="form-select form-select-sm">
                                <option value="1">1 - Negligible</option>
                                <option value="2">2 - Minor</option>
                                <option value="3">3 - Moderate</option>
                                <option value="4">4 - Major</option>
                                <option value="5">5 - Critical</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Risk Status</label>
                            <select name="Status" id="editRiskStatus" class="form-select form-select-sm">
                                <option value="Open">Open</option>
                                <option value="Mitigated">Mitigated</option>
                                <option value="Closed">Closed</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Linked Control ID</label>
                            <input type="text" name="controlId" id="editRiskControlId" class="form-control form-control-sm" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Description</label>
                            <textarea name="Description" id="editRiskDesc" class="form-control form-control-sm" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark btn-sm"><i class="bi bi-check2-circle me-1"></i> Update Risk</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Delete Risk -->
<div class="modal fade" id="deleteRiskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Risk Record</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Risks" asp-action="Delete" method="post">
                <input type="hidden" name="id" id="deleteRiskId" />
                <div class="modal-body p-4">
                    <p class="mb-1">Are you sure you want to permanently delete risk <strong id="deleteRiskCode"></strong> (<span id="deleteRiskTitle"></span>)?</p>
                    <p class="text-muted small mb-0">This will remove the risk assessment and associated treatment plans.</p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash me-1"></i> Confirm Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        new AdvanceSearch({
            containerId: 'risksTableBody',
            searchInputId: 'riskSearchInput',
            counterId: 'riskResultsCounter',
            resetBtnId: 'riskResetBtn',
            emptyStateId: 'riskEmptyState',
            filterSelects: [
                { id: 'riskLevelFilter', colIndex: 7 },
                { id: 'riskStatusFilter', colIndex: 8 }
            ]
        });
    });

    function calcAddScore() {
        const l = parseInt(document.getElementById('addRiskLikelihood').value) || 1;
        const i = parseInt(document.getElementById('addRiskImpact').value) || 1;
        const score = l * i;
        let level = "Low";
        if (score >= 15) level = "Critical";
        else if (score >= 10) level = "High";
        else if (score >= 5) level = "Medium";
        document.getElementById('addRiskScore').textContent = `Score: ${score} (${level})`;
    }

    function openEditRiskModal(id, code, title, desc, asset, dept, owner, likelihood, impact, status, controlId) {
        document.getElementById('editRiskId').value = id;
        document.getElementById('editRiskCode').value = code;
        document.getElementById('editRiskTitle').value = title;
        document.getElementById('editRiskDesc').value = desc;
        document.getElementById('editRiskAsset').value = asset;
        document.getElementById('editRiskDept').value = dept;
        document.getElementById('editRiskOwner').value = owner;
        document.getElementById('editRiskLikelihood').value = likelihood;
        document.getElementById('editRiskImpact').value = impact;
        document.getElementById('editRiskStatus').value = status;
        document.getElementById('editRiskControlId').value = controlId;
        new bootstrap.Modal(document.getElementById('editRiskModal')).show();
    }

    function openDeleteRiskModal(id, code, title) {
        document.getElementById('deleteRiskId').value = id;
        document.getElementById('deleteRiskCode').textContent = code;
        document.getElementById('deleteRiskTitle').textContent = title;
        new bootstrap.Modal(document.getElementById('deleteRiskModal')).show();
    }
</script>
