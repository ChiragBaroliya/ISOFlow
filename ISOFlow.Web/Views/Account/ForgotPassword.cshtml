@{
    Layout = null;
    ViewData["Title"] = "Forgot Password — ISOFlow";
    bool emailSent = ViewBag.EmailSent == true;
    string mockToken = ViewBag.MockToken as string ?? "";
    string sentEmail = ViewBag.Email as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
            display: flex; align-items: center; justify-content: center; padding: 2rem;
        }
        body::before {
            content: ''; position: fixed; inset: 0; pointer-events: none;
            background-image:
                radial-gradient(circle at 15% 55%, rgba(99,102,241,.15) 0%, transparent 45%),
                radial-gradient(circle at 85% 25%, rgba(124,58,237,.1) 0%, transparent 40%);
        }
        .card {
            max-width: 480px; width: 100%;
            background: rgba(255,255,255,.05);
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 24px; padding: 2.75rem 2.5rem;
            backdrop-filter: blur(20px);
            box-shadow: 0 25px 60px rgba(0,0,0,.5);
            animation: pop .4s cubic-bezier(.175,.885,.32,1.275);
        }
        @@keyframes pop { from { opacity:0; transform:scale(.9); } to { opacity:1; transform:scale(1); } }
        .icon-ring {
            width: 72px; height: 72px; border-radius: 50%;
            background: rgba(99,102,241,.15); border: 2px solid rgba(99,102,241,.35);
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 2rem; color: #a5b4fc; margin-bottom: 1.5rem;
            box-shadow: 0 0 40px rgba(99,102,241,.2);
        }
        .icon-ring.success { background: rgba(16,185,129,.15); border-color: rgba(16,185,129,.35); color: #6ee7b7; box-shadow: 0 0 40px rgba(16,185,129,.2); }
        h1 { font-size: 1.65rem; font-weight: 800; color: #fff; margin-bottom: .4rem; }
        .sub { font-size: .9rem; color: rgba(255,255,255,.5); margin-bottom: 2rem; line-height: 1.6; }
        label { font-size: .82rem; font-weight: 600; color: rgba(255,255,255,.7); margin-bottom: .4rem; display: block; }
        .form-control {
            background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.15);
            border-radius: 12px; color: #fff; padding: .75rem 1rem; font-size: .9rem;
            transition: border-color .2s, box-shadow .2s;
        }
        .form-control::placeholder { color: rgba(255,255,255,.3); }
        .form-control:focus { background: rgba(255,255,255,.1); border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,.25); color: #fff; outline: none; }
        .btn-primary-ui {
            width: 100%; background: linear-gradient(135deg, #6366f1, #4f46e5);
            border: none; border-radius: 12px; color: #fff; font-weight: 700;
            font-size: .95rem; padding: .85rem; margin-top: 1.25rem;
            transition: transform .15s, box-shadow .15s;
            box-shadow: 0 8px 24px rgba(99,102,241,.4); cursor: pointer;
        }
        .btn-primary-ui:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(99,102,241,.5); }
        .back-link { display: block; text-align: center; margin-top: 1.5rem; font-size: .85rem; color: rgba(255,255,255,.45); text-decoration: none; }
        .back-link:hover { color: rgba(255,255,255,.75); }
        .alert-error {
            background: rgba(239,68,68,.12); border: 1px solid rgba(239,68,68,.3);
            border-radius: 12px; padding: .75rem 1rem; font-size: .85rem;
            color: #fca5a5; margin-bottom: 1rem;
        }
        /* Token card */
        .token-card {
            background: rgba(16,185,129,.1); border: 1px solid rgba(16,185,129,.3);
            border-radius: 14px; padding: 1.25rem; margin: 1.25rem 0;
        }
        .token-label { font-size: .72rem; font-weight: 700; color: #6ee7b7; text-transform: uppercase; letter-spacing: .08em; margin-bottom: .5rem; }
        .token-value {
            font-family: 'Courier New', monospace; font-size: 1.9rem; font-weight: 800;
            color: #fff; letter-spacing: .25em; background: rgba(255,255,255,.08);
            border-radius: 10px; padding: .6rem 1rem; display: inline-block;
            cursor: pointer; transition: background .2s;
        }
        .token-value:hover { background: rgba(255,255,255,.14); }
        .token-hint { font-size: .75rem; color: rgba(255,255,255,.4); margin-top: .5rem; }
        .divider { border-top: 1px solid rgba(255,255,255,.08); margin: 1.5rem 0; }
    </style>
</head>
<body>
    <div class="card">
        @if (!emailSent)
        {
            <!-- Step 1: enter email -->
            <div class="text-center mb-3">
                <div class="icon-ring mx-auto"><i class="bi bi-lock-fill"></i></div>
                <h1>Forgot Password?</h1>
                <p class="sub">Enter your registered email and we'll generate a reset token for you.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div class="alert-error"><i class="bi bi-exclamation-circle me-2"></i>@err.ErrorMessage</div>
                }
            }

            <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                <div class="mb-3">
                    <label for="email">Email Address</label>
                    <input id="email" name="email" type="email" class="form-control"
                           placeholder="you@company.com" autocomplete="email" required />
                </div>
                <button type="submit" class="btn-primary-ui" id="btnSendReset">
                    <i class="bi bi-envelope-fill me-2"></i> Send Reset Token
                </button>
            </form>
        }
        else
        {
            <!-- Step 2: show result -->
            <div class="text-center mb-3">
                <div class="icon-ring success mx-auto"><i class="bi bi-check-circle-fill"></i></div>
                <h1>Check Your Inbox</h1>
                <p class="sub">
                    If <strong style="color:#fff;">@sentEmail</strong> is registered,
                    a reset token has been generated.
                </p>
            </div>

            @if (!string.IsNullOrEmpty(mockToken))
            {
                <!-- DEV MODE: show the actual token -->
                <div class="token-card text-center">
                    <div class="token-label"><i class="bi bi-code-slash me-1"></i> Mock Token (Dev Mode)</div>
                    <div class="token-value" id="tokenValue" onclick="copyToken()" title="Click to copy">@mockToken</div>
                    <div class="token-hint mt-2"><i class="bi bi-cursor me-1"></i>Click token to copy · Use it on the Reset Password page</div>
                </div>
                <a asp-controller="Account" asp-action="ResetPassword" asp-route-token="@mockToken"
                   class="btn-primary-ui d-block text-center text-decoration-none" id="btnGoToReset">
                    <i class="bi bi-key-fill me-2"></i> Go to Reset Password
                </a>
            }
            else
            {
                <div class="divider"></div>
                <p style="font-size:.85rem; color:rgba(255,255,255,.45); text-align:center;">
                    If the email is registered, a token will be displayed here in dev mode.
                </p>
                <a asp-controller="Account" asp-action="ResetPassword"
                   class="btn-primary-ui d-block text-center text-decoration-none" id="btnManualReset">
                    <i class="bi bi-key-fill me-2"></i> Enter Reset Token Manually
                </a>
            }
        }

        <a asp-controller="Account" asp-action="Login" class="back-link" id="btnBackToLogin">
            <i class="bi bi-arrow-left me-1"></i> Back to Sign In
        </a>
    </div>

    <script>
        function copyToken() {
            const el = document.getElementById('tokenValue');
            navigator.clipboard?.writeText(el.innerText.trim())
                .then(() => { el.style.background = 'rgba(16,185,129,.25)'; setTimeout(() => el.style.background = '', 1200); });
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
