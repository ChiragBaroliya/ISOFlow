@{
    Layout = null;
    ViewData["Title"] = "Reset Password — ISOFlow";
    string prefillToken = ViewBag.Token as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
            display: flex; align-items: center; justify-content: center; padding: 2rem;
        }
        body::before {
            content: ''; position: fixed; inset: 0; pointer-events: none;
            background-image:
                radial-gradient(circle at 20% 60%, rgba(139,92,246,.14) 0%, transparent 45%),
                radial-gradient(circle at 80% 20%, rgba(59,130,246,.1) 0%, transparent 40%);
        }
        .card {
            max-width: 480px; width: 100%;
            background: rgba(255,255,255,.05);
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 24px; padding: 2.75rem 2.5rem;
            backdrop-filter: blur(20px);
            box-shadow: 0 25px 60px rgba(0,0,0,.5);
            animation: pop .4s cubic-bezier(.175,.885,.32,1.275);
        }
        @@keyframes pop { from { opacity:0; transform:scale(.9); } to { opacity:1; transform:scale(1); } }
        .icon-ring {
            width: 72px; height: 72px; border-radius: 50%;
            background: rgba(139,92,246,.15); border: 2px solid rgba(139,92,246,.35);
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 2rem; color: #c4b5fd; margin-bottom: 1.5rem;
            box-shadow: 0 0 40px rgba(139,92,246,.2);
        }
        h1 { font-size: 1.65rem; font-weight: 800; color: #fff; margin-bottom: .4rem; }
        .sub { font-size: .9rem; color: rgba(255,255,255,.5); margin-bottom: 1.75rem; line-height: 1.6; }
        label { font-size: .82rem; font-weight: 600; color: rgba(255,255,255,.7); margin-bottom: .4rem; display: block; }
        .form-control {
            background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.15);
            border-radius: 12px; color: #fff; padding: .75rem 1rem; font-size: .9rem;
            transition: border-color .2s, box-shadow .2s;
        }
        .form-control::placeholder { color: rgba(255,255,255,.3); }
        .form-control:focus { background: rgba(255,255,255,.1); border-color: #8b5cf6; box-shadow: 0 0 0 3px rgba(139,92,246,.25); color: #fff; outline: none; }
        .btn-primary-ui {
            width: 100%; background: linear-gradient(135deg, #8b5cf6, #6d28d9);
            border: none; border-radius: 12px; color: #fff; font-weight: 700;
            font-size: .95rem; padding: .85rem; margin-top: 1.25rem;
            transition: transform .15s, box-shadow .15s;
            box-shadow: 0 8px 24px rgba(139,92,246,.4); cursor: pointer;
        }
        .btn-primary-ui:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(139,92,246,.5); }
        .back-link { display: block; text-align: center; margin-top: 1.5rem; font-size: .85rem; color: rgba(255,255,255,.45); text-decoration: none; }
        .back-link:hover { color: rgba(255,255,255,.75); }
        .alert-error {
            background: rgba(239,68,68,.12); border: 1px solid rgba(239,68,68,.3);
            border-radius: 12px; padding: .75rem 1rem; font-size: .85rem;
            color: #fca5a5; margin-bottom: 1rem;
        }
        .pw-wrapper { position: relative; }
        .pw-toggle {
            position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
            background: none; border: none; color: rgba(255,255,255,.4); cursor: pointer; font-size: 1rem; padding: 0;
        }
        .pw-toggle:hover { color: rgba(255,255,255,.8); }
        .strength-bar { height: 4px; border-radius: 4px; margin-top: .5rem; background: rgba(255,255,255,.1); overflow: hidden; }
        .strength-fill { height: 100%; border-radius: 4px; transition: width .3s, background .3s; }
    </style>
</head>
<body>
    <div class="card">
        <div class="text-center mb-3">
            <div class="icon-ring mx-auto"><i class="bi bi-key-fill"></i></div>
            <h1>Reset Password</h1>
            <p class="sub">Enter your reset token and choose a new password.</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div class="alert-error"><i class="bi bi-exclamation-circle me-2"></i>@err.ErrorMessage</div>
            }
        }

        <form asp-controller="Account" asp-action="ResetPassword" method="post" id="resetForm">
            <div class="mb-3">
                <label for="token">Reset Token</label>
                <input id="token" name="token" type="text" class="form-control"
                       placeholder="e.g. A1B2C3D4" value="@prefillToken"
                       maxlength="8" style="letter-spacing:.15em; font-family:monospace; font-size:1rem;" required />
            </div>

            <div class="mb-3">
                <label for="newPassword">New Password</label>
                <div class="pw-wrapper">
                    <input id="newPassword" name="newPassword" type="password" class="form-control"
                           placeholder="Min. 6 characters" autocomplete="new-password" required oninput="checkStrength(this.value)" />
                    <button type="button" class="pw-toggle" onclick="toggle('newPassword', this)"><i class="bi bi-eye"></i></button>
                </div>
                <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
                <div style="font-size:.72rem; color:rgba(255,255,255,.35); margin-top:.3rem;" id="strengthLabel"></div>
            </div>

            <div class="mb-3">
                <label for="confirmPassword">Confirm New Password</label>
                <div class="pw-wrapper">
                    <input id="confirmPassword" name="confirmPassword" type="password" class="form-control"
                           placeholder="Repeat password" autocomplete="new-password" required />
                    <button type="button" class="pw-toggle" onclick="toggle('confirmPassword', this)"><i class="bi bi-eye"></i></button>
                </div>
            </div>

            <button type="submit" class="btn-primary-ui" id="btnResetPw">
                <i class="bi bi-shield-lock-fill me-2"></i> Reset Password
            </button>
        </form>

        <a asp-controller="Account" asp-action="ForgotPassword" class="back-link" id="btnBackToForgot">
            <i class="bi bi-arrow-left me-1"></i> Request a new token
        </a>
    </div>

    <script>
        function toggle(id, btn) {
            const el = document.getElementById(id);
            const isText = el.type === 'text';
            el.type = isText ? 'password' : 'text';
            btn.innerHTML = isText ? '<i class="bi bi-eye"></i>' : '<i class="bi bi-eye-slash"></i>';
        }
        function checkStrength(val) {
            const fill = document.getElementById('strengthFill');
            const lbl  = document.getElementById('strengthLabel');
            let score = 0;
            if (val.length >= 6)  score++;
            if (val.length >= 10) score++;
            if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;
            const map = ['', 'Weak', 'Fair', 'Good', 'Strong', 'Very Strong'];
            const colors = ['', '#ef4444', '#f97316', '#eab308', '#22c55e', '#10b981'];
            fill.style.width = (score * 20) + '%';
            fill.style.background = colors[score] || '';
            lbl.textContent = map[score] || '';
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
