@using ISOFlow.Domain.Enums
@model List<ISOFlow.Domain.Entities.Improvement>
@{
    ViewData["Title"] = "Continual Improvement";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-graph-up-arrow text-success me-2"></i> Continual Improvement (ISO Clause 10.2)</h4>
        <p class="text-muted small mb-0">Closing the ISO compliance lifecycle loop from audit findings and management reviews into actionable improvements.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#addImprovementModal">
            <i class="bi bi-plus-circle me-1"></i> Log Improvement
        </button>
    </div>
</div>

<!-- ── Advance Search & Filter Toolbar ── -->
<div class="card-enterprise p-3 mb-4 bg-light border">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="impSearchInput" class="form-control border-start-0" placeholder="Search by Code, title, owner, source, expected benefit..." />
            </div>
        </div>
        <div class="col-6 col-md-4">
            <select id="impStatusFilter" class="form-select form-select-sm">
                <option value="all">All Initiative Statuses</option>
                <option value="InProgress">In Progress</option>
                <option value="Completed">Completed</option>
                <option value="Verified">Verified</option>
                <option value="Identified">Identified</option>
            </select>
        </div>
        <div class="col-6 col-md-3 d-flex justify-content-end">
            <button type="button" id="impResetBtn" class="btn btn-sm btn-outline-secondary w-100" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
            </button>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top small text-muted">
        <span id="impResultsCounter">Showing <strong>@Model.Count</strong> of <strong>@Model.Count</strong> records</span>
        <span class="badge bg-success-subtle text-success"><i class="bi bi-funnel me-1"></i> Live Filter</span>
    </div>
</div>

<div id="improvementsContainer">
    @foreach (var imp in Model)
    {
        <div class="card-enterprise p-4 border-start border-success border-4 mb-4 imp-card-item">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                <div>
                    <span class="badge bg-success me-2">@imp.Code</span>
                    @{
                        var statusBadge = imp.Status switch {
                            ImprovementStatus.Completed => "bg-success text-white",
                            ImprovementStatus.Verified => "bg-success text-white",
                            ImprovementStatus.InProgress => "bg-warning text-dark",
                            _ => "bg-info text-dark"
                        };
                    }
                    <span class="badge @statusBadge">Status: @imp.Status</span>
                    <span class="badge bg-light text-dark border ms-1">Source: @imp.Source</span>
                    <h4 class="fw-bold text-dark mt-2 mb-1">@imp.Title</h4>
                    <p class="text-muted small mb-0">Owner: <strong>@imp.Owner</strong></p>
                </div>
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-outline-secondary" title="Edit Initiative"
                            onclick="openEditImprovementModal('@imp.Id', '@imp.Code', '@Html.Raw(Html.Encode(imp.Title))', '@Html.Raw(Html.Encode(imp.CurrentState))', '@Html.Raw(Html.Encode(imp.FutureState))', '@((int)imp.Source)', '@Html.Raw(Html.Encode(imp.ExpectedBenefit))', '@Html.Raw(Html.Encode(imp.Owner))', '@((int)imp.Status)', '@imp.RelatedReviewId', '@imp.RelatedFindingId')">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </button>
                    <button type="button" class="btn btn-outline-danger" title="Delete Initiative"
                            onclick="openDeleteImprovementModal('@imp.Id', '@imp.Code', '@Html.Raw(Html.Encode(imp.Title))')">
                        <i class="bi bi-trash me-1"></i> Delete
                    </button>
                </div>
            </div>

            <div class="row g-3 my-2">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded border h-100">
                        <strong class="text-danger"><i class="bi bi-x-circle me-1"></i> Current State (Baseline):</strong>
                        <p class="small text-muted mb-0 mt-1">@imp.CurrentState</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-success-subtle rounded border border-success h-100">
                        <strong class="text-success"><i class="bi bi-check-circle me-1"></i> Target Future State:</strong>
                        <p class="small text-success mb-0 mt-1">@imp.FutureState</p>
                    </div>
                </div>
            </div>

            <div class="p-3 bg-light rounded border mt-3 small">
                <strong>Expected Benefit:</strong> @imp.ExpectedBenefit
            </div>
        </div>
    }
</div>

<!-- Empty State -->
<div id="impEmptyState" class="text-center py-5" style="display: none;">
    <i class="bi bi-search text-muted" style="font-size: 2.5rem;"></i>
    <h6 class="fw-bold mt-2 mb-1">No matching improvement initiatives found</h6>
    <p class="text-muted small mb-0">Try adjusting your keyword search or status filter.</p>
</div>

<!-- Modal: Add Improvement -->
<div class="modal fade" id="addImprovementModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2"></i> Log Continual Improvement Initiative</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Improvement" asp-action="Create" method="post">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Initiative Code <span class="text-danger">*</span></label>
                            <input type="text" name="Code" class="form-control form-control-sm" placeholder="e.g. IMP-002" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Initiative Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" class="form-control form-control-sm" placeholder="e.g. Real-Time SOC SIEM Integration" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Initiative Owner</label>
                            <input type="text" name="Owner" class="form-control form-control-sm" placeholder="e.g. David Chen" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Source</label>
                            <select name="Source" class="form-select form-select-sm">
                                <option value="0">AuditFinding</option>
                                <option value="1" selected>ManagementReview</option>
                                <option value="2">RiskAssessment</option>
                                <option value="3">IncidentPostMortem</option>
                                <option value="4">EmployeeSuggestion</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Status</label>
                            <select name="Status" class="form-select form-select-sm">
                                <option value="0">Identified</option>
                                <option value="1" selected>InProgress</option>
                                <option value="2">Completed</option>
                                <option value="3">Verified</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Related Management Review ID</label>
                            <input type="text" name="RelatedReviewId" class="form-control form-control-sm" placeholder="e.g. REV-2026-Q4" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Related Finding ID</label>
                            <input type="text" name="RelatedFindingId" class="form-control form-control-sm" placeholder="e.g. FIND-001" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Current State</label>
                            <textarea name="CurrentState" class="form-control form-control-sm" rows="2" placeholder="Describe the baseline situation..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Future Target State</label>
                            <textarea name="FutureState" class="form-control form-control-sm" rows="2" placeholder="Describe desired outcome after change..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Expected Business &amp; Compliance Benefit</label>
                            <input type="text" name="ExpectedBenefit" class="form-control form-control-sm" placeholder="e.g. Reduce mean time to detect anomalies from 4 hours to 5 minutes." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check2-circle me-1"></i> Save Initiative</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Improvement -->
<div class="modal fade" id="editImprovementModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i> Edit Continual Improvement</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Improvement" asp-action="Edit" method="post">
                <input type="hidden" name="Id" id="editImpId" />
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Code</label>
                            <input type="text" name="Code" id="editImpCode" class="form-control form-control-sm" readonly />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" id="editImpTitle" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Owner</label>
                            <input type="text" name="Owner" id="editImpOwner" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Source</label>
                            <select name="Source" id="editImpSource" class="form-select form-select-sm">
                                <option value="0">AuditFinding</option>
                                <option value="1">ManagementReview</option>
                                <option value="2">RiskAssessment</option>
                                <option value="3">IncidentPostMortem</option>
                                <option value="4">EmployeeSuggestion</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Status</label>
                            <select name="Status" id="editImpStatus" class="form-select form-select-sm">
                                <option value="0">Identified</option>
                                <option value="1">InProgress</option>
                                <option value="2">Completed</option>
                                <option value="3">Verified</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Related Review ID</label>
                            <input type="text" name="RelatedReviewId" id="editImpRev" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Related Finding ID</label>
                            <input type="text" name="RelatedFindingId" id="editImpFind" class="form-control form-control-sm" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Current State</label>
                            <textarea name="CurrentState" id="editImpCurrent" class="form-control form-control-sm" rows="2"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Future State</label>
                            <textarea name="FutureState" id="editImpFuture" class="form-control form-control-sm" rows="2"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Expected Benefit</label>
                            <input type="text" name="ExpectedBenefit" id="editImpBenefit" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark btn-sm"><i class="bi bi-check2-circle me-1"></i> Update Initiative</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Delete Improvement -->
<div class="modal fade" id="deleteImprovementModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Improvement</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Improvement" asp-action="Delete" method="post">
                <input type="hidden" name="id" id="deleteImpId" />
                <div class="modal-body p-4">
                    <p class="mb-1">Are you sure you want to delete improvement initiative <strong id="deleteImpCode"></strong> (<span id="deleteImpTitle"></span>)?</p>
                    <p class="text-muted small mb-0">This continual improvement record will be removed.</p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash me-1"></i> Confirm Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        new AdvanceSearch({
            containerId: 'improvementsContainer',
            searchInputId: 'impSearchInput',
            counterId: 'impResultsCounter',
            resetBtnId: 'impResetBtn',
            emptyStateId: 'impEmptyState',
            itemSelector: '.imp-card-item',
            filterSelects: [
                { id: 'impStatusFilter' }
            ]
        });
    });

    function openEditImprovementModal(id, code, title, current, future, source, benefit, owner, status, revId, findId) {
        document.getElementById('editImpId').value = id;
        document.getElementById('editImpCode').value = code;
        document.getElementById('editImpTitle').value = title;
        document.getElementById('editImpCurrent').value = current;
        document.getElementById('editImpFuture').value = future;
        document.getElementById('editImpSource').value = source;
        document.getElementById('editImpBenefit').value = benefit;
        document.getElementById('editImpOwner').value = owner;
        document.getElementById('editImpStatus').value = status;
        document.getElementById('editImpRev').value = revId;
        document.getElementById('editImpFind').value = findId;
        new bootstrap.Modal(document.getElementById('editImprovementModal')).show();
    }

    function openDeleteImprovementModal(id, code, title) {
        document.getElementById('deleteImpId').value = id;
        document.getElementById('deleteImpCode').textContent = code;
        document.getElementById('deleteImpTitle').textContent = title;
        new bootstrap.Modal(document.getElementById('deleteImprovementModal')).show();
    }
</script>
