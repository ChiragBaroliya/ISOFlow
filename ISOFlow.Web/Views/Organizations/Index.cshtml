@model List<ISOFlow.Domain.Entities.Organization>
@{
    ViewData["Title"] = "Organization Directory & Multi-Tenancy";
    var standards = ViewBag.Standards as List<ISOFlow.Domain.Entities.Standard> ?? new List<ISOFlow.Domain.Entities.Standard>();
    var activeOrgId = Context.Session.GetString("ActiveOrgId") ?? "ORG-001";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-building text-primary me-2"></i> Enterprise Organization Directory</h4>
        <p class="text-muted small mb-0">Manage multi-tenant organization profiles, compliance scopes, and active tenant contexts.</p>
    </div>
    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createOrgModal">
        <i class="bi bi-plus-lg me-1"></i> Add Enterprise Organization
    </button>
</div>

<!-- ── Advance Search & Filter Toolbar ── -->
<div class="card-enterprise p-3 mb-4 bg-light border">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="orgSearchInput" class="form-control border-start-0" placeholder="Search by Organization Name, Code, Industry, Standard..." />
            </div>
        </div>
        <div class="col-6 col-md-4">
            <select id="orgIndustryFilter" class="form-select form-select-sm">
                <option value="all">All Industries</option>
                <option value="Cloud Security">Cloud Security</option>
                <option value="FinTech">FinTech / Payments</option>
                <option value="Healthcare">Healthcare</option>
            </select>
        </div>
        <div class="col-6 col-md-3 d-flex justify-content-end">
            <button type="button" id="orgResetBtn" class="btn btn-sm btn-outline-secondary w-100" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
            </button>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top small text-muted">
        <span id="orgResultsCounter">Showing <strong>@Model.Count</strong> of <strong>@Model.Count</strong> records</span>
        <span class="badge bg-primary-subtle text-primary"><i class="bi bi-funnel me-1"></i> Live Filter</span>
    </div>
</div>

<div class="row g-4" id="orgGrid">
    @foreach (var org in Model)
    {
        var isActive = (org.Id == activeOrgId);
        <div class="col-12 col-md-4 org-card-item">
            <div class="card-enterprise p-4 h-100 d-flex flex-column justify-content-between position-relative @(isActive ? "border-primary border-2 shadow-sm" : "")">
                @if (isActive)
                {
                    <span class="position-absolute top-0 end-0 bg-primary text-white text-uppercase px-3 py-1 rounded-bl small fw-bold" style="font-size: 0.7rem; border-bottom-left-radius: 0.5rem;">
                        <i class="bi bi-check-circle-fill me-1"></i> Active Tenant
                    </span>
                }
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge bg-primary-subtle text-primary fw-bold fs-6">@org.Code</span>
                        <span class="badge bg-success-subtle text-success">@org.CompliancePercentage% Compliant</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">@org.Name</h5>
                    <div class="text-muted small mb-2"><i class="bi bi-briefcase me-1"></i> @org.Industry</div>

                    <div class="p-3 bg-light rounded mb-3 border">
                        <div class="d-flex align-items-center justify-content-between small text-muted mb-1">
                            <span><i class="bi bi-people me-1"></i> Employees:</span>
                            <strong class="text-dark">@org.Employees Staff</strong>
                        </div>
                        <div class="d-flex align-items-center justify-content-between small text-muted mb-1">
                            <span><i class="bi bi-award me-1"></i> Primary Standard:</span>
                            <strong class="text-primary">@org.PrimaryStandard</strong>
                        </div>
                        <div class="d-flex align-items-center justify-content-between small text-muted">
                            <span><i class="bi bi-geo-alt me-1"></i> Offices:</span>
                            <span class="text-dark fw-semibold">@string.Join(", ", org.Locations)</span>
                        </div>
                    </div>
                </div>

                <div class="pt-3 border-top d-flex align-items-center justify-content-between mt-auto gap-2">
                    <div class="d-flex gap-2">
                        @if (!isActive)
                        {
                            <form asp-controller="Organizations" asp-action="SwitchContext" method="post">
                                <input type="hidden" name="orgId" value="@org.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Switch Tenant Session">
                                    <i class="bi bi-arrow-repeat me-1"></i> Switch Context
                                </button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-success disabled">
                                <i class="bi bi-check2 me-1"></i> Current Scope
                            </button>
                        }
                    </div>

                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editOrgModal-@org.Id" title="Edit Organization">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <form asp-controller="Organizations" asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete @org.Name?');">
                            <input type="hidden" name="id" value="@org.Id" />
                            <button type="submit" class="btn btn-outline-danger" title="Delete Organization">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Edit Org Modal -->
        <div class="modal fade" id="editOrgModal-@org.Id" tabindex="-1" aria-labelledby="editOrgModalLabel-@org.Id" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <form asp-controller="Organizations" asp-action="Edit" method="post">
                        <div class="modal-header">
                            <h5 class="modal-title fw-bold" id="editOrgModalLabel-@org.Id">
                                <i class="bi bi-pencil-square text-primary me-2"></i> Edit Organization (@org.Name)
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="Id" value="@org.Id" />

                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">Org Code</label>
                                    <input type="text" class="form-control form-control-sm" name="Code" value="@org.Code" required />
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label fw-semibold small">Company Name</label>
                                    <input type="text" class="form-control form-control-sm" name="Name" value="@org.Name" required />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Industry Sector</label>
                                    <input type="text" class="form-control form-control-sm" name="Industry" value="@org.Industry" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Primary Standard</label>
                                    <select class="form-select form-select-sm" name="PrimaryStandard">
                                        @foreach (var std in standards)
                                        {
                                            <option value="@std.Code" selected="@(std.Code == org.PrimaryStandard)">@std.Code — @std.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">Employees</label>
                                    <input type="number" class="form-control form-control-sm" name="Employees" value="@org.Employees" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">Compliance Target (%)</label>
                                    <input type="number" step="0.1" class="form-control form-control-sm" name="CompliancePercentage" value="@org.CompliancePercentage" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">Contact Email</label>
                                    <input type="email" class="form-control form-control-sm" name="ContactEmail" value="@org.ContactEmail" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Locations (Comma separated)</label>
                                <input type="text" class="form-control form-control-sm" name="locationsRaw" value="@string.Join(", ", org.Locations)" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-save me-1"></i> Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<!-- Empty State -->
<div id="orgEmptyState" class="text-center py-5" style="display: none;">
    <i class="bi bi-search text-muted" style="font-size: 2.5rem;"></i>
    <h6 class="fw-bold mt-2 mb-1">No matching enterprise organizations found</h6>
    <p class="text-muted small mb-0">Try adjusting your keyword search or industry filter.</p>
</div>

<!-- Create Org Modal -->
<div class="modal fade" id="createOrgModal" tabindex="-1" aria-labelledby="createOrgModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-controller="Organizations" asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="createOrgModalLabel">
                        <i class="bi bi-building-add text-primary me-2"></i> Register New Enterprise Tenant
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Tenant Code</label>
                            <input type="text" class="form-control form-control-sm" name="Code" placeholder="e.g. APEX-GLOBAL" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold small">Company / Organization Legal Name</label>
                            <input type="text" class="form-control form-control-sm" name="Name" placeholder="e.g. Apex Global Financial Systems Ltd." required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Industry Sector</label>
                            <input type="text" class="form-control form-control-sm" name="Industry" placeholder="e.g. FinTech / Banking" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Primary ISO Standard</label>
                            <select class="form-select form-select-sm" name="PrimaryStandard">
                                @foreach (var std in standards)
                                {
                                    <option value="@std.Code">@std.Code — @std.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Employees Count</label>
                            <input type="number" class="form-control form-control-sm" name="Employees" value="150" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Initial Compliance Score (%)</label>
                            <input type="number" step="0.1" class="form-control form-control-sm" name="CompliancePercentage" value="85.0" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Contact Email</label>
                            <input type="email" class="form-control form-control-sm" name="ContactEmail" placeholder="compliance@apex.com" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Office Locations (Comma separated)</label>
                        <input type="text" class="form-control form-control-sm" name="locationsRaw" placeholder="e.g. London, Singapore, New York" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg me-1"></i> Register Tenant</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        new AdvanceSearch({
            containerId: 'orgGrid',
            searchInputId: 'orgSearchInput',
            counterId: 'orgResultsCounter',
            resetBtnId: 'orgResetBtn',
            emptyStateId: 'orgEmptyState',
            itemSelector: '.org-card-item',
            filterSelects: [
                { id: 'orgIndustryFilter' }
            ]
        });
    });
</script>
