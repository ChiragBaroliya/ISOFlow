@model ISOFlow.Domain.Entities.Audit
@{
    ViewData["Title"] = $"{Model?.Code ?? "AUD-2026-001"} - {Model?.Title ?? "ISO 27001 Internal Audit"}";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-primary fs-6">@(Model?.Code ?? "AUD-2026-001")</span>
            <span class="badge bg-warning text-dark">Status: @(Model?.Status.ToString() ?? "InProgress")</span>
        </div>
        <h3 class="fw-bold text-dark mb-0">@(Model?.Title ?? "ISO 27001 Internal Audit 2026")</h3>
    </div>
    <a asp-controller="Audits" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back to Audits</a>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-8">
        <div class="card-enterprise p-4">
            <h6 class="fw-bold mb-3"><i class="bi bi-list-check text-primary me-2"></i> Audit Control Checklist Evaluation</h6>
            <table class="table table-sm table-hover align-middle">
                <thead><tr><th>Control</th><th>Requirement</th><th>Evaluation</th><th>Evidence</th></tr></thead>
                <tbody>
                    <tr class="table-danger">
                        <td class="fw-bold">CTRL-001 User Access Management</td>
                        <td>A.5.18 Access Rights</td>
                        <td><span class="badge bg-danger">Non-Compliant</span></td>
                        <td><a asp-controller="Evidence" asp-action="Index" class="badge bg-light text-dark border">EVI-2026-001</a></td>
                    </tr>
                    <tr>
                        <td class="fw-bold">CTRL-002 Password Management</td>
                        <td>A.5.15 Access Control</td>
                        <td><span class="badge bg-success">Compliant</span></td>
                        <td><span class="badge bg-light text-dark border">EVI-2026-003</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold">CTRL-006 Backup Management</td>
                        <td>A.8.13 Information Backup</td>
                        <td><span class="badge bg-success">Compliant</span></td>
                        <td><span class="badge bg-light text-dark border">EVI-2026-004</span></td>
                    </tr>
                </tbody>
            </table>

            <div class="mt-4 pt-3 border-top">
                <h6 class="fw-bold text-danger mb-2">Audit Findings Identified</h6>
                <div class="p-3 bg-danger-subtle rounded border border-danger d-flex align-items-center justify-content-between">
                    <div>
                        <span class="badge bg-danger me-2">FIND-001</span>
                        <strong class="text-danger">Access not removed promptly for terminated employees</strong>
                    </div>
                    <a asp-controller="Findings" asp-action="Detail" asp-route-id="FIND-001" class="btn btn-sm btn-danger">Trace Finding FIND-001 <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card-enterprise p-4">
            <h6 class="fw-bold mb-3">Audit Details</h6>
            <div class="small">
                <div class="mb-2"><strong>Lead Auditor:</strong> @(Model?.LeadAuditor ?? "Sarah Wilson")</div>
                <div class="mb-2"><strong>Dates:</strong> 20-Aug to 25-Aug-2026</div>
                <div class="mb-2"><strong>Completion:</strong> @(Model?.CompletionPercentage ?? 68)%</div>
                <div class="mb-2"><strong>Scope:</strong> @(Model?.Scope ?? "Annex A Organizational Controls")</div>
            </div>
        </div>
    </div>
</div>
