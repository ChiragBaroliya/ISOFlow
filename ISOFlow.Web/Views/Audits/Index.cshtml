@using ISOFlow.Domain.Enums
@model List<ISOFlow.Domain.Entities.Audit>
@{
    ViewData["Title"] = "Audit Programs & Inspections";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-clipboard-check text-primary me-2"></i> Audit Programs &amp; Inspections</h4>
        <p class="text-muted small mb-0">Internal and external ISO audit schedule, scope, and checklist evaluations.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addAuditModal">
            <i class="bi bi-plus-circle me-1"></i> Schedule Audit
        </button>
    </div>
</div>

<!-- ── Advance Search & Filter Toolbar ── -->
<div class="card-enterprise p-3 mb-4 bg-light border">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-4">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="auditSearchInput" class="form-control border-start-0" placeholder="Search by Audit ID, title, auditor, scope..." />
            </div>
        </div>
        <div class="col-6 col-md-3">
            <select id="auditStandardFilter" class="form-select form-select-sm">
                <option value="all">All Standards</option>
                <option value="ISO-27001">ISO 27001</option>
                <option value="ISO-9001">ISO 9001</option>
                <option value="ISO-14001">ISO 14001</option>
            </select>
        </div>
        <div class="col-6 col-md-3">
            <select id="auditStatusFilter" class="form-select form-select-sm">
                <option value="all">All Statuses</option>
                <option value="Completed">Completed</option>
                <option value="InProgress">In Progress</option>
                <option value="Scheduled">Scheduled</option>
                <option value="Planned">Planned</option>
            </select>
        </div>
        <div class="col-12 col-md-2 d-flex justify-content-end">
            <button type="button" id="auditResetBtn" class="btn btn-sm btn-outline-secondary w-100" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
            </button>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top small text-muted">
        <span id="auditResultsCounter">Showing <strong>@Model.Count</strong> of <strong>@Model.Count</strong> records</span>
        <span class="badge bg-primary-subtle text-primary"><i class="bi bi-funnel me-1"></i> Live Filter</span>
    </div>
</div>

<div class="card-enterprise p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Audit ID</th>
                    <th>Title</th>
                    <th>Standard</th>
                    <th>Lead Auditor</th>
                    <th>Dates</th>
                    <th>Status</th>
                    <th>Progress</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="auditsTableBody">
                @foreach (var aud in Model)
                {
                    <tr class="@(aud.Id == "AUD-2026-001" ? "table-primary" : "")">
                        <td class="fw-bold text-primary">@aud.Code</td>
                        <td>
                            <a asp-controller="Audits" asp-action="Detail" asp-route-id="@aud.Id" class="fw-semibold text-dark text-decoration-none">@aud.Title</a>
                            <div class="text-muted small">@aud.Scope</div>
                        </td>
                        <td><span class="badge bg-light text-dark border">@aud.StandardId</span></td>
                        <td class="small">@aud.LeadAuditor</td>
                        <td class="small">@aud.StartDate.ToString("dd-MMM") to @aud.EndDate.ToString("dd-MMM-yyyy")</td>
                        <td>
                            @{
                                var audBadge = aud.Status switch {
                                    AuditStatus.Completed => "bg-success text-white",
                                    AuditStatus.InProgress => "bg-primary text-white",
                                    AuditStatus.Scheduled => "bg-warning text-dark",
                                    _ => "bg-secondary text-white"
                                };
                            }
                            <span class="badge @audBadge">@aud.Status</span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 6px;">
                                    <div class="progress-bar bg-success" style="width: @(aud.CompletionPercentage)%"></div>
                                </div>
                                <span class="small fw-semibold">@aud.CompletionPercentage%</span>
                            </div>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-controller="Audits" asp-action="Detail" asp-route-id="@aud.Id" class="btn btn-outline-primary" title="Audit Checklist">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <button type="button" class="btn btn-outline-secondary" title="Edit Audit"
                                        onclick="openEditAuditModal('@aud.Id', '@aud.Code', '@Html.Raw(Html.Encode(aud.Title))', '@aud.StandardId', '@Html.Raw(Html.Encode(aud.LeadAuditor))', '@aud.StartDate.ToString("yyyy-MM-dd")', '@aud.EndDate.ToString("yyyy-MM-dd")', '@((int)aud.Status)', '@aud.CompletionPercentage', '@Html.Raw(Html.Encode(aud.Scope))', '@string.Join(", ", aud.CheckListControlIds)')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger" title="Delete Audit"
                                        onclick="openDeleteAuditModal('@aud.Id', '@aud.Code', '@Html.Raw(Html.Encode(aud.Title))')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Empty State -->
    <div id="auditEmptyState" class="text-center py-5" style="display: none;">
        <i class="bi bi-search text-muted" style="font-size: 2.5rem;"></i>
        <h6 class="fw-bold mt-2 mb-1">No matching audit programs found</h6>
        <p class="text-muted small mb-0">Try adjusting your keyword search or filters.</p>
    </div>
</div>

<!-- Modal: Add Audit -->
<div class="modal fade" id="addAuditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-calendar-plus me-2"></i> Schedule ISO Audit Program</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Audits" asp-action="Create" method="post">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Audit Code <span class="text-danger">*</span></label>
                            <input type="text" name="Code" class="form-control form-control-sm" placeholder="e.g. AUD-2026-003" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Audit Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" class="form-control form-control-sm" placeholder="e.g. Annual Surveillance External Audit" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Standard</label>
                            <select name="StandardId" class="form-select form-select-sm">
                                <option value="ISO-27001-2022" selected>ISO 27001:2022</option>
                                <option value="ISO-9001-2015">ISO 9001:2015</option>
                                <option value="ISO-14001-2015">ISO 14001:2015</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Lead Auditor</label>
                            <input type="text" name="LeadAuditor" class="form-control form-control-sm" placeholder="e.g. Sarah Jenkins (External Lead Auditor)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Start Date</label>
                            <input type="date" name="StartDate" class="form-control form-control-sm" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">End Date</label>
                            <input type="date" name="EndDate" class="form-control form-control-sm" value="@DateTime.UtcNow.AddDays(3).ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Status</label>
                            <select name="Status" class="form-select form-select-sm">
                                <option value="0">Planned</option>
                                <option value="1">Scheduled</option>
                                <option value="2" selected>InProgress</option>
                                <option value="3">Reporting</option>
                                <option value="4">Completed</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Audit Scope &amp; Boundary</label>
                            <input type="text" name="Scope" class="form-control form-control-sm" placeholder="e.g. Scope includes cloud infrastructure, HR joiner/mover/leaver, and data center physical security." />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Checklist Control IDs (comma-separated)</label>
                            <input type="text" name="checklistRaw" class="form-control form-control-sm" placeholder="e.g. CTRL-001, CTRL-002, CTRL-003" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check2-circle me-1"></i> Save Audit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Audit -->
<div class="modal fade" id="editAuditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i> Edit Audit Program</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Audits" asp-action="Edit" method="post">
                <input type="hidden" name="Id" id="editAuditId" />
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Audit Code</label>
                            <input type="text" name="Code" id="editAuditCode" class="form-control form-control-sm" readonly />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Audit Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" id="editAuditTitle" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Standard</label>
                            <select name="StandardId" id="editAuditStandard" class="form-select form-select-sm">
                                <option value="ISO-27001-2022">ISO 27001:2022</option>
                                <option value="ISO-9001-2015">ISO 9001:2015</option>
                                <option value="ISO-14001-2015">ISO 14001:2015</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Lead Auditor</label>
                            <input type="text" name="LeadAuditor" id="editAuditLead" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Start Date</label>
                            <input type="date" name="StartDate" id="editAuditStart" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">End Date</label>
                            <input type="date" name="EndDate" id="editAuditEnd" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Status</label>
                            <select name="Status" id="editAuditStatus" class="form-select form-select-sm">
                                <option value="0">Planned</option>
                                <option value="1">Scheduled</option>
                                <option value="2">InProgress</option>
                                <option value="3">Reporting</option>
                                <option value="4">Completed</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Completion %</label>
                            <input type="number" name="CompletionPercentage" id="editAuditProgress" class="form-control form-control-sm" min="0" max="100" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Scope</label>
                            <input type="text" name="Scope" id="editAuditScope" class="form-control form-control-sm" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Checklist Controls</label>
                            <input type="text" name="checklistRaw" id="editAuditControls" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark btn-sm"><i class="bi bi-check2-circle me-1"></i> Update Audit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Delete Audit -->
<div class="modal fade" id="deleteAuditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Cancel Audit Program</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Audits" asp-action="Delete" method="post">
                <input type="hidden" name="id" id="deleteAuditId" />
                <div class="modal-body p-4">
                    <p class="mb-1">Are you sure you want to delete audit program <strong id="deleteAuditCode"></strong> (<span id="deleteAuditTitle"></span>)?</p>
                    <p class="text-muted small mb-0">This will remove the inspection record from the schedule.</p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash me-1"></i> Confirm Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        new AdvanceSearch({
            containerId: 'auditsTableBody',
            searchInputId: 'auditSearchInput',
            counterId: 'auditResultsCounter',
            resetBtnId: 'auditResetBtn',
            emptyStateId: 'auditEmptyState',
            filterSelects: [
                { id: 'auditStandardFilter', colIndex: 2 },
                { id: 'auditStatusFilter', colIndex: 5 }
            ]
        });
    });

    function openEditAuditModal(id, code, title, standardId, lead, start, end, status, progress, scope, controls) {
        document.getElementById('editAuditId').value = id;
        document.getElementById('editAuditCode').value = code;
        document.getElementById('editAuditTitle').value = title;
        document.getElementById('editAuditStandard').value = standardId;
        document.getElementById('editAuditLead').value = lead;
        document.getElementById('editAuditStart').value = start;
        document.getElementById('editAuditEnd').value = end;
        document.getElementById('editAuditStatus').value = status;
        document.getElementById('editAuditProgress').value = progress;
        document.getElementById('editAuditScope').value = scope;
        document.getElementById('editAuditControls').value = controls;
        new bootstrap.Modal(document.getElementById('editAuditModal')).show();
    }

    function openDeleteAuditModal(id, code, title) {
        document.getElementById('deleteAuditId').value = id;
        document.getElementById('deleteAuditCode').textContent = code;
        document.getElementById('deleteAuditTitle').textContent = title;
        new bootstrap.Modal(document.getElementById('deleteAuditModal')).show();
    }
</script>
