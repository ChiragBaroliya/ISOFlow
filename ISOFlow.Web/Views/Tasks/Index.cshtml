@using ISOFlow.Domain.Enums
@model List<ISOFlow.Domain.Entities.TaskItem>
@{
    ViewData["Title"] = "Compliance Tasks";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-check2-square text-primary me-2"></i> Compliance Tasks</h4>
        <p class="text-muted small mb-0">Operational activities linked to controls, risks, evidence, and audit requirements.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Tasks" asp-action="Kanban" class="btn btn-outline-primary btn-sm"><i class="bi bi-kanban me-1"></i> Kanban View</a>
        <a asp-controller="Tasks" asp-action="Calendar" class="btn btn-outline-secondary btn-sm"><i class="bi bi-calendar3 me-1"></i> Calendar View</a>
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addTaskModal">
            <i class="bi bi-plus-circle me-1"></i> Create Task
        </button>
    </div>
</div>

<!-- ── Advance Search & Filter Toolbar ── -->
<div class="card-enterprise p-3 mb-4 bg-light border">
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-4">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="taskSearchInput" class="form-control border-start-0" placeholder="Search by Task ID, title, control, owner..." />
            </div>
        </div>
        <div class="col-6 col-md-3">
            <select id="taskPriorityFilter" class="form-select form-select-sm">
                <option value="all">All Priorities</option>
                <option value="Urgent">Urgent</option>
                <option value="High">High</option>
                <option value="Medium">Medium</option>
                <option value="Low">Low</option>
            </select>
        </div>
        <div class="col-6 col-md-3">
            <select id="taskStatusFilter" class="form-select form-select-sm">
                <option value="all">All Statuses</option>
                <option value="Completed">Completed</option>
                <option value="InProgress">In Progress</option>
                <option value="NotStarted">Not Started</option>
                <option value="Overdue">Overdue</option>
            </select>
        </div>
        <div class="col-12 col-md-2 d-flex justify-content-end">
            <button type="button" id="taskResetBtn" class="btn btn-sm btn-outline-secondary w-100" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
            </button>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top small text-muted">
        <span id="taskResultsCounter">Showing <strong>@Model.Count</strong> of <strong>@Model.Count</strong> records</span>
        <span class="badge bg-primary-subtle text-primary"><i class="bi bi-funnel me-1"></i> Live Filter</span>
    </div>
</div>

<div class="card-enterprise p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Task ID</th>
                    <th>Task Title</th>
                    <th>Control</th>
                    <th>Owner</th>
                    <th>Priority</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Evidence</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="tasksTableBody">
                @foreach (var task in Model)
                {
                    <tr class="@(task.Id == "TASK-2026-003" ? "table-success" : "")">
                        <td class="fw-bold text-primary">@task.Code</td>
                        <td>
                            <div class="fw-semibold">@task.Title</div>
                            <div class="text-muted small">@task.Comments</div>
                        </td>
                        <td><span class="badge bg-light text-primary border">@task.ControlId</span></td>
                        <td class="small fw-medium">@task.Owner</td>
                        <td>
                            @{
                                var prioBadge = task.Priority switch {
                                    TaskPriority.Urgent => "bg-danger text-white",
                                    TaskPriority.High => "bg-warning text-dark",
                                    TaskPriority.Medium => "bg-info text-dark",
                                    _ => "bg-secondary text-white"
                                };
                            }
                            <span class="badge @prioBadge">@task.Priority</span>
                        </td>
                        <td class="small">@task.DueDate.ToString("dd-MMM-yyyy")</td>
                        <td>
                            <form asp-controller="Tasks" asp-action="UpdateStatus" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@task.Id" />
                                <select name="status" class="form-select form-select-sm py-0 fw-semibold" style="font-size: 0.75rem; width: 130px;" onchange="this.form.submit()">
                                    <option value="0" selected="@(task.Status == ComplianceTaskStatus.NotStarted)">Not Started</option>
                                    <option value="1" selected="@(task.Status == ComplianceTaskStatus.InProgress)">In Progress</option>
                                    <option value="2" selected="@(task.Status == ComplianceTaskStatus.Blocked)">Blocked</option>
                                    <option value="3" selected="@(task.Status == ComplianceTaskStatus.Completed)">Completed</option>
                                    <option value="4" selected="@(task.Status == ComplianceTaskStatus.Overdue)">Overdue</option>
                                </select>
                            </form>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(task.EvidenceId))
                            {
                                <a asp-controller="Evidence" asp-action="Index" class="badge bg-success text-white text-decoration-none"><i class="bi bi-file-earmark-check"></i> @task.EvidenceId</a>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border">None</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-controller="Tasks" asp-action="Kanban" class="btn btn-outline-primary" title="View Kanban">
                                    <i class="bi bi-kanban"></i>
                                </a>
                                <button type="button" class="btn btn-outline-secondary" title="Edit Task"
                                        onclick="openEditTaskModal('@task.Id', '@task.Code', '@Html.Raw(Html.Encode(task.Title))', '@task.ControlId', '@task.RiskId', '@Html.Raw(Html.Encode(task.Owner))', '@((int)task.Priority)', '@task.DueDate.ToString("yyyy-MM-dd")', '@((int)task.Status)', '@Html.Raw(Html.Encode(task.Comments))', '@task.EvidenceId')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger" title="Delete Task"
                                        onclick="openDeleteTaskModal('@task.Id', '@task.Code', '@Html.Raw(Html.Encode(task.Title))')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Empty State -->
    <div id="taskEmptyState" class="text-center py-5" style="display: none;">
        <i class="bi bi-search text-muted" style="font-size: 2.5rem;"></i>
        <h6 class="fw-bold mt-2 mb-1">No matching compliance tasks found</h6>
        <p class="text-muted small mb-0">Try adjusting your keyword search, priority, or status filters.</p>
    </div>
</div>

<!-- Modal: Add Task -->
<div class="modal fade" id="addTaskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2"></i> Create Compliance Task</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Tasks" asp-action="Create" method="post">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Task Code <span class="text-danger">*</span></label>
                            <input type="text" name="Code" class="form-control form-control-sm" placeholder="e.g. TASK-2026-004" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Task Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" class="form-control form-control-sm" placeholder="e.g. Perform quarterly user access reviews" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Linked Control ID</label>
                            <input type="text" name="ControlId" class="form-control form-control-sm" placeholder="e.g. CTRL-001" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Linked Risk ID</label>
                            <input type="text" name="RiskId" class="form-control form-control-sm" placeholder="e.g. RISK-001" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Assignee / Owner</label>
                            <input type="text" name="Owner" class="form-control form-control-sm" placeholder="e.g. David Chen (IT Manager)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Priority</label>
                            <select name="Priority" class="form-select form-select-sm">
                                <option value="0">Low</option>
                                <option value="1">Medium</option>
                                <option value="2" selected>High</option>
                                <option value="3">Urgent</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Status</label>
                            <select name="Status" class="form-select form-select-sm">
                                <option value="0">Not Started</option>
                                <option value="1" selected>In Progress</option>
                                <option value="2">Blocked</option>
                                <option value="3">Completed</option>
                                <option value="4">Overdue</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Due Date</label>
                            <input type="date" name="DueDate" class="form-control form-control-sm" value="@DateTime.UtcNow.AddDays(14).ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Linked Evidence ID</label>
                            <input type="text" name="EvidenceId" class="form-control form-control-sm" placeholder="e.g. EVI-2026-001" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Operational Instructions &amp; Description</label>
                            <textarea name="Comments" class="form-control form-control-sm" rows="3" placeholder="Provide step-by-step procedures for executing this compliance task..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check2-circle me-1"></i> Save Task</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Task -->
<div class="modal fade" id="editTaskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i> Edit Task Activity</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Tasks" asp-action="Edit" method="post">
                <input type="hidden" name="Id" id="editTaskId" />
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Task Code</label>
                            <input type="text" name="Code" id="editTaskCode" class="form-control form-control-sm" readonly />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Task Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" id="editTaskTitle" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Linked Control ID</label>
                            <input type="text" name="ControlId" id="editTaskControl" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Linked Risk ID</label>
                            <input type="text" name="RiskId" id="editTaskRisk" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Assignee / Owner</label>
                            <input type="text" name="Owner" id="editTaskOwner" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Priority</label>
                            <select name="Priority" id="editTaskPriority" class="form-select form-select-sm">
                                <option value="0">Low</option>
                                <option value="1">Medium</option>
                                <option value="2">High</option>
                                <option value="3">Urgent</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Status</label>
                            <select name="Status" id="editTaskStatus" class="form-select form-select-sm">
                                <option value="0">Not Started</option>
                                <option value="1">In Progress</option>
                                <option value="2">Blocked</option>
                                <option value="3">Completed</option>
                                <option value="4">Overdue</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Due Date</label>
                            <input type="date" name="DueDate" id="editTaskDue" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Linked Evidence ID</label>
                            <input type="text" name="EvidenceId" id="editTaskEvidence" class="form-control form-control-sm" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Instructions &amp; Notes</label>
                            <textarea name="Comments" id="editTaskComments" class="form-control form-control-sm" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark btn-sm"><i class="bi bi-check2-circle me-1"></i> Update Task</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Delete Task -->
<div class="modal fade" id="deleteTaskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Compliance Task</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Tasks" asp-action="Delete" method="post">
                <input type="hidden" name="id" id="deleteTaskId" />
                <div class="modal-body p-4">
                    <p class="mb-1">Are you sure you want to delete task <strong id="deleteTaskCode"></strong> (<span id="deleteTaskTitle"></span>)?</p>
                    <p class="text-muted small mb-0">This operational activity will be removed.</p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash me-1"></i> Confirm Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        new AdvanceSearch({
            containerId: 'tasksTableBody',
            searchInputId: 'taskSearchInput',
            counterId: 'taskResultsCounter',
            resetBtnId: 'taskResetBtn',
            emptyStateId: 'taskEmptyState',
            filterSelects: [
                { id: 'taskPriorityFilter', colIndex: 4 },
                { id: 'taskStatusFilter', colIndex: 6 }
            ]
        });
    });

    function openEditTaskModal(id, code, title, controlId, riskId, owner, priority, due, status, comments, evidenceId) {
        document.getElementById('editTaskId').value = id;
        document.getElementById('editTaskCode').value = code;
        document.getElementById('editTaskTitle').value = title;
        document.getElementById('editTaskControl').value = controlId;
        document.getElementById('editTaskRisk').value = riskId;
        document.getElementById('editTaskOwner').value = owner;
        document.getElementById('editTaskPriority').value = priority;
        document.getElementById('editTaskDue').value = due;
        document.getElementById('editTaskStatus').value = status;
        document.getElementById('editTaskComments').value = comments;
        document.getElementById('editTaskEvidence').value = evidenceId;
        new bootstrap.Modal(document.getElementById('editTaskModal')).show();
    }

    function openDeleteTaskModal(id, code, title) {
        document.getElementById('deleteTaskId').value = id;
        document.getElementById('deleteTaskCode').textContent = code;
        document.getElementById('deleteTaskTitle').textContent = title;
        new bootstrap.Modal(document.getElementById('deleteTaskModal')).show();
    }
</script>
