        <p class="text-muted small mb-0">Scheduled audits, policy reviews, risk assessments, and quarterly access reviews.</p>
    </div>
</div>

<div class="card-enterprise p-4">
    <div class="row g-3 text-center mb-4">
        <div class="col"><div class="p-3 bg-light rounded border"><div class="fw-bold text-primary">AUG 2026</div><div class="small text-success">Q3 Access Review (Completed)</div></div></div>
        <div class="col"><div class="p-3 bg-primary-subtle rounded border border-primary"><div class="fw-bold text-primary">SEP 2026</div><div class="small text-danger">Internal Audit AUD-2026-001</div></div></div>
        <div class="col"><div class="p-3 bg-light rounded border"><div class="fw-bold text-primary">OCT 2026</div><div class="small text-info">CAPA-001 Automation Target</div></div></div>
        <div class="col"><div class="p-3 bg-light rounded border"><div class="fw-bold text-primary">NOV 2026</div><div class="small text-muted">Q4 Executive Review</div></div></div>
        <div class="col"><div class="p-3 bg-light rounded border"><div class="fw-bold text-primary">DEC 2026</div><div class="small text-muted">Annual ISO 27001 Renewal</div></div></div>
    </div>
