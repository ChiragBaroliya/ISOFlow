@model ISOFlow.Web.Models.ComplianceCalendarViewModel
@{
    ViewData["Title"] = "Compliance Calendar";
    var lastMonth = Model.FromMonth.AddMonths(Model.MonthCount - 1);

    string BadgeFor(string kind) => kind switch
    {
        "Audit" => "bg-primary",
        "CAPA" => "bg-info text-white",
        _ => "bg-secondary"
    };
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-calendar3 text-primary me-2"></i> Compliance Calendar</h4>
        <p class="text-muted small mb-0">
            Task due dates, audit start dates and CAPA due dates — @Model.FromMonth.ToString("MMM yyyy") to @lastMonth.ToString("MMM yyyy").
        </p>
    </div>
</div>

@if (Model.Overdue.Any())
{
    <div class="card-enterprise p-4 mb-4 border-start border-danger border-4">
        <h6 class="fw-bold text-danger mb-3"><i class="bi bi-exclamation-octagon me-2"></i> Overdue (@Model.Overdue.Count)</h6>
        <ul class="list-group list-group-flush small">
            @foreach (var e in Model.Overdue)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <a href="@e.Url" class="text-decoration-none">
                        <span class="badge @BadgeFor(e.Kind) me-2">@e.Kind</span><strong>@e.Code</strong> @e.Title
                    </a>
                    <span class="text-danger text-nowrap ms-2">@e.Date.ToString("dd MMM yyyy") · @e.Status</span>
                </li>
            }
        </ul>
    </div>
}

<div class="row g-3">
    @for (var m = 0; m < Model.MonthCount; m++)
    {
        var month = Model.FromMonth.AddMonths(m);
        var items = Model.Upcoming.Where(e => e.Date.Year == month.Year && e.Date.Month == month.Month).ToList();
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card-enterprise p-3 h-100 @(m == 0 ? "border border-primary" : "")">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="fw-bold text-primary">@month.ToString("MMMM yyyy").ToUpperInvariant()</div>
                    <span class="badge bg-light text-muted border">@items.Count</span>
                </div>
                @if (items.Any())
                {
                    <ul class="list-unstyled small mb-0">
                        @foreach (var e in items)
                        {
                            <li class="mb-2">
                                <span class="text-muted me-1">@e.Date.ToString("dd")</span>
                                <span class="badge @BadgeFor(e.Kind) me-1">@e.Kind</span>
                                <a href="@e.Url" class="text-decoration-none @(e.IsDone ? "text-muted text-decoration-line-through" : "")">@e.Code @e.Title</a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-muted small">Nothing scheduled.</div>
                }
            </div>
        </div>
    }
</div>
