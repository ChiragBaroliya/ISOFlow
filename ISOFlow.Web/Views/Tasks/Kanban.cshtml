@model ISOFlow.Web.Models.TaskKanbanViewModel
@{
    ViewData["Title"] = "Task Kanban Board";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-kanban text-primary me-2"></i> Compliance Task Kanban Board</h4>
        <p class="text-muted small mb-0">Visual task progress board with live SignalR synchronization across team members.</p>
    </div>
    <a asp-controller="Tasks" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-list-task me-1"></i> List View</a>
</div>

<div class="row g-3">
    <!-- To Do -->
    <div class="col-12 col-md-4">
        <div class="bg-light p-3 rounded border h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0 text-secondary"><i class="bi bi-circle me-1"></i> To Do</h6>
                <span class="badge bg-secondary rounded-pill">@Model.ToDoTasks.Count</span>
            </div>
            @foreach (var task in Model.ToDoTasks)
            {
                <div class="card p-3 mb-2 shadow-sm border-0">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-primary">@task.ControlId</span>
                        <span class="badge bg-warning text-dark">@task.Priority</span>
                    </div>
                    <h6 class="fw-bold mb-1" style="font-size: 0.9rem;">@task.Title</h6>
                    <p class="text-muted small mb-2">@task.Code • Due @task.DueDate.ToString("dd-MMM-yyyy")</p>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                        <span class="small text-muted">@task.Owner</span>
                        <button class="btn btn-sm btn-outline-primary py-0" onclick="moveTask('@task.Code', 'In Progress')" style="font-size: 0.75rem;">Move →</button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- In Progress -->
    <div class="col-12 col-md-4">
        <div class="bg-light p-3 rounded border h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-arrow-repeat me-1"></i> In Progress</h6>
                <span class="badge bg-primary rounded-pill">@Model.InProgressTasks.Count</span>
            </div>
            @foreach (var task in Model.InProgressTasks)
            {
                <div class="card p-3 mb-2 shadow-sm border-0 border-start border-warning border-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-info text-white">@task.ControlId</span>
                        <span class="badge bg-danger">@task.Priority</span>
                    </div>
                    <h6 class="fw-bold mb-1" style="font-size: 0.9rem;">@task.Title</h6>
                    <p class="text-muted small mb-2">@task.Code • Due @task.DueDate.ToString("dd-MMM-yyyy")</p>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                        <span class="small text-muted">@task.Owner</span>
                        <button class="btn btn-sm btn-outline-success py-0" onclick="moveTask('@task.Code', 'Completed')" style="font-size: 0.75rem;">Complete ✓</button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Completed -->
    <div class="col-12 col-md-4">
        <div class="bg-light p-3 rounded border h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0 text-success"><i class="bi bi-check-circle me-1"></i> Completed</h6>
                <span class="badge bg-success rounded-pill">@Model.CompletedTasks.Count</span>
            </div>
            @foreach (var task in Model.CompletedTasks)
            {
                <div class="card p-3 mb-2 shadow-sm border-0 border-start border-success border-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-success">@task.ControlId</span>
                        <span class="badge bg-success">Verified</span>
                    </div>
                    <h6 class="fw-bold mb-1" style="font-size: 0.9rem;">@task.Title</h6>
                    <p class="text-muted small mb-2">@task.Code • Evidence Attached</p>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                        <span class="small text-muted">Completed</span>
                        <a asp-controller="Evidence" asp-action="Index" class="btn btn-sm btn-success py-0" style="font-size: 0.75rem;">Evidence <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/kanban.js" asp-append-version="true"></script>
}
